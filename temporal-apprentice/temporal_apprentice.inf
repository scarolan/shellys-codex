Global fire_turns_remaining = 0;
Global hawking_phase = 0;
Global party_turns_remaining = 0;
Global party_over = false;
Global tide_turns_remaining = 0;
Global tide_high = false;

Global copernicus_named = false;
Global thyme_departed = false;
Global newspaper_buried = false;
Global newspaper_inscribed = false;
Global rag_stolen = false;
Global rag_on_machine = false;
Global cat_bribed = false;

Global knock_count = 0;
Global door_open = false;
Global arrival_time = 0;
