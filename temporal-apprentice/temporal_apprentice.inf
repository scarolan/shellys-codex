! ===================================================================
! THE TEMPORAL APPRENTICE
! An Interactive Fiction Game
! Douglas Adams meets H.G. Wells
! ===================================================================

Constant Story "The Temporal Apprentice";
Constant Headline "^A Time-Travelling Adventure^^";
Constant MAX_SCORE 189;

Replace DrawStatusLine;
Replace GamePrologue;

Include "Parser";
Include "VerbLib";

! Override library GamePrologue to remove the leading blank line
[ GamePrologue i j;
    before_first_turn = true;
    for (i=1 : i<=100 : i++) j = random(i);
    ChangeDefault(cant_go, CANTGO__TX);
    real_location = thedark;
    player = selfobj; actor = player;
    selfobj.capacity = MAX_CARRIED;
    #Ifdef LanguageInitialise;
    LanguageInitialise();
    #Endif;
    #Ifdef EnglishNaturalLanguage;
    old_itobj = itobj; old_himobj = himobj; old_herobj = herobj;
    #Endif;
    LibraryExtensions.RunAll(ext_initialise);
    j = Initialise();
    last_score = score;
    initial_lookmode = lookmode;
    objectloop (i in player) give i moved ~concealed;
    move player to location;
    while (parent(location)) location = parent(location);
    real_location = location;
    MoveFloatingObjects();
    actor = player;
    actors_location = location;
    lightflag = OffersLight(parent(player));
    if (lightflag == 0) location = thedark;
    if (j ~= 2) Banner();
    #Ifndef NOINITIAL_LOOK;
    <Look>;
    #Endif;
    before_first_turn = false;
];

! ===================================================================
! GLOBAL VARIABLES
! ===================================================================

Global visited_roman = false;
Global visited_blitz = false;
Global visited_hawking = false;
Global visited_future = false;

Global has_lodestone = false;
Global has_vacuum_tube = false;
Global has_formula = false;
Global has_processor = false;

Global lodestone_installed = false;
Global tube_installed = false;
Global formula_transcribed = false;
Global processor_installed = false;

Global inscription_carved = false;
Global capsule_buried = false;
Global church_saved = false;
Global eleanor_gift = 0;

Global hawking_convinced = false;
Global marcus_impressed = false;
Global livia_trusts = false;
Global tommy_helping = false;
Global radio_fixed = false;
Global porter_bypassed = false;
Global kai_helping = false;
Global has_diving_gear = false;
Global lab_unlocked = false;

Global components_installed = false;
Global workshop_cleaned = false;

Global cat_accident = false;
Global current_era = 0;
Global cat_turn_count = 0;
Global fire_event = false;
Global hawking_phase = 0;

Global copernicus_named = false;
Global thyme_departed = false;
Global rag_stolen = false;
Global rag_on_machine = false;
Global cat_bribed = false;

Global knock_count = 0;
Global door_open = false;
Global spanner_given = false;
Global spanner_turn = 0;
Global endgame_knocks_heard = false;
Global endgame_turns = 0;
Global endgame_phase = 0;
Global solarium_unlocked = false;
Global solarium_entered = false;
Global store_room_entered = false;
Global lodestone_last_room = 0;

Global ad_circled = false;
Global hired = false;

Global machine_dug_out = false;
Global machine_raised = false;

! ===================================================================
! NPC CONVERSATION ROUTINES
! ===================================================================

[ ThymeDeparts;
    print "^Dr. Thyme suddenly freezes, stares at the clock on the wall, and leaps to his feet.^^";
    print "~Mrs. Pemberton's! The scones! She only holds them until half three and it's --~ He checks three separate watches, each showing a different time. ~-- it's NEARLY that. Or possibly past. Time is --~ He waves his hand vaguely. ~-- a matter of perspective.~^^";
    print "He grabs his enormous overcoat from the hooks by the door and shoves a brass key into your hand.^^";
    print "~Front door key. Lock up when I'm back. Or before. Temporal engineering.~ He's already halfway out. ~DO tidy up while I'm out. Place is a state. And do NOT go into the solarium. The door at the end of the corridor. Under ANY circumstances.~^^";
    print "The front door slams shut behind him. You are alone. Well -- alone except for the cat, who watches you from atop a shelf with an expression of absolute calculation.^";
    thyme_departed = true;
    door_open = false;
    move cleaning_rag to player;
    move front_door_key to player;
    remove dr_thyme;
];

[ NPC_Talk_Thyme;
    if (components_installed) {
        print "~Splendid work, my boy! Absolutely splendid! I knew hiring an apprentice was the right decision. Well, the cat helped too, I suppose.~^";
        rtrue;
    }
    if (cat_accident) {
        print "Dr. Thyme isn't here. He went out for tea approximately thirty seconds before the cat destroyed everything.^";
        rtrue;
    }
    if (thyme_departed) {
        print "Dr. Thyme has already left for tea. You can still hear him humming Rule Britannia as he disappears down the alley.^";
        rtrue;
    }
    if (hired == false) {
        print "The man glances up, sees you, and scowls. ~No salesmen! Can't you read the plate?~ He returns to his work.^";
        rtrue;
    }
    if (spanner_given == false) {
        "~The number four spanner,~ he repeats, without turning around. ~On the shelf. Behind you. Brass. Not steel. Tuesdays.~";
    }
    ThymeDeparts();
];

[ NPC_Ask_Thyme topic;
    if (thyme_departed || cat_accident) {
        print "Dr. Thyme isn't here to ask.^";
        rtrue;
    }
    if (hired == false) {
        print "The man doesn't look up. ~No salesmen. Can't you read the plate?~^";
        rtrue;
    }
    if (spanner_given == false) {
        print "Dr. Thyme doesn't turn around. ~Spanner first. Shelf. Behind you. Brass.~^";
        rtrue;
    }
    if (topic == 'machine' or 'time' or 'device' or 'invention' or 'engine' or 'temporal') {
        print "~The Temporal Displacement Engine! My life's work. Well, one of them. The marmalade recipe was also quite significant.~ He gestures vaguely towards the corridor. ~She's in the solarium. Nearly ready. Just needs a few calibrations. But I must stress -- do NOT touch her. Not a lever, not a dial. She's temperamental. The last time someone touched the wrong thing, I lost an entire Tuesday. Just... gone. Skipped straight from Monday to Wednesday. Very disorienting.~^";
        rtrue;
    }
    if (topic == 'cat' or 'copernicus' or 'grey' or 'shorthair') {
        copernicus_named = true;
        give copernicus proper;
        print "~Copernicus? Magnificent creature. Found him in a dustbin in Whitechapel three years ago. Named him after the astronomer -- he has the same habit of sitting in the centre of everything and expecting the universe to revolve around him.~ Dr. Thyme chuckles. ~He has an uncanny instinct for finding the most expensive thing in any room and sitting on it. Genius-level cat. Possibly smarter than half the Royal Society.~^";
        rtrue;
    }
    if (topic == 'journal' or 'notes' or 'book') {
        print "~Yes, do read it! Contains all my research. The handwriting gets a bit wobbly around chapter seven -- that was the incident with the temporal feedback loop and the cheese sandwich. I still can't look at Wensleydale the same way.~^";
        rtrue;
    }
    if (topic == 'research' or 'work' or 'science' or 'temporal') {
        print "~My research? Oh, where to begin!~ He gestures expansively at the workshop. ~Twenty-seven years I've been working on temporal displacement. Started as a theoretical exercise at Cambridge -- they laughed at me, of course. Called it ~Thyme's Folly.~ Well, who's laughing now?~ He pauses. ~Still them, mostly. But they won't be laughing when I publish!~^";
        rtrue;
    }
    if (topic == 'marmalade' or 'jam' or 'preserv') {
        print "~Ah, the marmalade! Seville orange, my own recipe. Batch 7 is the standard. Batch 12 is experimental -- I added a pinch of temporal resonance powder. Remarkable preservative qualities. Batch 3...~ He lowers his voice. ~Do NOT eat Batch 3. It's not exactly marmalade any more. I'm not sure what it is. But it's Tuesday in one jar and Thursday in the next, and the toast between them has ceased to exist entirely.~^";
        rtrue;
    }
    if (topic == 'pemberton' or 'mrs' or 'tea' or 'scone' or 'scones') {
        print "~Mrs. Pemberton! Landlady, housekeeper, and the finest scone-maker south of the Thames. She lives two streets over and provides me with tea and scones at precisely four o'clock every afternoon. In return, I try not to cause any more explosions. It's an arrangement that suits us both, though I confess I've been... less than perfect on my end of the bargain.~ He glances at a suspicious scorch mark on the ceiling. ~The incident with the chronometric kettle was nobody's fault.~^";
        rtrue;
    }
    if (topic == 'help') {
        print "~Help? You're the apprentice! Your job is to help ME. But I suppose reading the journal would be a start. And do have a look around -- everything in this workshop has a story. Most of them end with a small explosion, but that's science for you.~^";
        rtrue;
    }
    print "Dr. Thyme peers at you over an imaginary pair of spectacles. ~Hmm? Oh, I'm not sure I can help you with that. Try the journal -- it's got everything in there. Somewhere. The indexing system is... aspirational.~^";
];

[ NPC_Talk_Marcus;
    if (marcus_impressed) {
        print "Marcus clasps your arm in a Roman greeting. ~Hail, friend! The gods clearly favour you. Any seer who commands thunder stones is welcome on the Via Principalis.~^";
        rtrue;
    }
    print "The centurion blocks your path with professional indifference. ~Halt. The Via Principalis is restricted to Roman citizens and military personnel.~ He eyes your strange clothing. ~You are clearly neither. Move along.~^";
];

[ NPC_Ask_Marcus topic;
    if (topic == 'boudica' or 'boudicca' or 'revolt' or 'army' or 'iceni') {
        if (marcus_impressed) {
            print "Marcus lowers his voice. ~The Iceni queen gathers her forces to the north. Between you and me, I've requested a transfer to Gaul. The food is terrible but at least the locals aren't on fire.~^";
        } else {
            print "Marcus stiffens. ~I will not discuss military matters with a civilian. Especially one dressed like... whatever you are.~^";
        }
        rtrue;
    }
    if (topic == 'temple' or 'mithras') {
        print "~The Temple of Mithras is sacred ground. Priestess Livia guards it well. You'd need her blessing -- or mine -- to enter.~^";
        rtrue;
    }
    if (topic == 'forum' or 'market') {
        print "~The Forum is the heart of Londinium. Merchants, politicians, charlatans -- sometimes all three at once.~^";
        rtrue;
    }
    if (topic == 'lodestone' or 'stone' or 'magnet' or 'thunder') {
        if (marcus_impressed) {
            print "~The thunder stone! Truly a gift from Jupiter himself. You wield great power, seer.~^";
        } else {
            print "~I have no interest in stones. Move along.~^";
        }
        rtrue;
    }
    if (topic == 'help') {
        print "~I am a centurion of Rome, not a help desk. But if you seek passage north, you'll need to prove yourself worthy.~^";
        rtrue;
    }
    print "Marcus gives you a look that suggests your question ranks somewhere below latrine duty in his list of priorities.^";
];

[ NPC_Talk_Livia;
    if (livia_trusts) {
        print "Livia smiles warmly. ~The mysteries of Mithras are open to you, traveller. The walls of this temple have stood for generations. May they stand for generations more.~^";
        rtrue;
    }
    if (marcus_impressed) {
        print "Livia regards you with cautious interest. ~Marcus speaks highly of you. He says you command the thunder stones. Impressive, if true. Perhaps you are worthy of the temple's secrets.~^^";
        livia_trusts = true;
        print "She steps aside from the inner sanctum. ~You may enter freely.~^";
        rtrue;
    }
    print "Livia stands at the entrance to the inner sanctum, arms folded. ~This is a place of sacred mystery. Only the initiated may pass beyond this point.~ She doesn't look like she's in a negotiating mood.^";
];

[ NPC_Ask_Livia topic;
    if (topic == 'mithras' or 'temple' or 'god' or 'mystery') {
        print "~Mithras, the Unconquered Sun, slayer of the cosmic bull. His mysteries teach us that light conquers darkness.~ She pauses. ~Also, the initiation involves being buried alive for three hours, but we don't lead with that.~^";
        rtrue;
    }
    if (topic == 'marcus' or 'centurion') {
        print "~Marcus is a good man, if somewhat superstitious. He once made an offering to Jupiter because his sandal broke. Twice.~^";
        rtrue;
    }
    if (topic == 'inscription' or 'wall' or 'carve' or 'carving') {
        if (livia_trusts) {
            print "~The walls of the inner sanctum bear the marks of many generations. You are welcome to leave your own.~^";
        } else {
            print "~The walls are sacred. I certainly won't let strangers go around scratching on them.~^";
        }
        rtrue;
    }
    if (topic == 'help') {
        if (livia_trusts) {
            print "~You have proven yourself worthy. Explore the inner sanctum and study the inscriptions upon the walls — they hold the wisdom of those who came before you.~^";
        } else {
            print "~Seek the blessing of Marcus first. The centurion's word carries weight, even in a temple.~^";
        }
        rtrue;
    }
    print "Livia considers your question with the serene patience of someone who has heard far sillier things during initiation ceremonies.^";
];

[ NPC_Talk_Peggy;
    if (church_saved) {
        print "Peggy gives you a curt nod of approval. ~Right. You'll do. Saved that church like a proper Londoner. Now get back to the shelter before Jerry has another go.~^";
        rtrue;
    }
    print "Warden Peggy materialises from the darkness like a tweed-clad spectre. ~Put that light OUT!~ she barks, despite the fact that you don't have a light. ~We're in a blackout, in case you hadn't noticed. Jerry's up there dropping his calling cards and here you are gawping about like a tourist.~^^";
    print "She points firmly towards the ground. ~Shelter's down below. The Crown and Anchor's east if you need liquid courage. And stay away from the rubble site west -- unexploded ordnance.~^";
];

[ NPC_Ask_Peggy topic;
    if (topic == 'shelter' or 'underground') {
        print "~Shelter's right below us. Tube station, repurposed. Tommy's down there with his wireless set, and little Eleanor. Poor mite won't stop drawing pictures.~^";
        rtrue;
    }
    if (topic == 'church' or 'bomb' or 'bombs' or 'fire') {
        if (church_saved) {
            print "~Thanks to you, St. Margaret's still stands. My grandmother was married there. Not that I'm sentimental.~ She dabs her eye briskly. ~Dust. Terrible dust.~^";
        } else {
            print "~St. Margaret's took a hit last week. Still standing, mostly. The inscription on the wall survived, oddly enough. Very old, that.~^";
        }
        rtrue;
    }
    if (topic == 'rubble' or 'electronics' or 'shop') {
        print "~The electronics shop caught it two nights ago. Whole street's rubble now. There might be salvageable parts in there, if you don't mind unexploded bombs.~^";
        rtrue;
    }
    if (topic == 'tommy' or 'radio' or 'wireless') {
        print "~Tommy's a good lad. Royal Signals, invalided out. His radio's on the blink -- needs a valve, I think. He's been trying to pick up transmissions.~^";
        rtrue;
    }
    if (topic == 'eleanor' or 'girl' or 'child') {
        print "~Eleanor? Sweet girl. Lost her mum in the first raids. She just draws and draws. Pictures of cats, mostly. Seems to cheer her up.~^";
        rtrue;
    }
    if (topic == 'help') {
        print "~Help? I'll tell you what would help. Everyone in the shelter, lights out, and Jerry sod off back to Berlin. In that order.~^";
        rtrue;
    }
    print "Peggy fixes you with a look that has quelled air raids, unruly teenagers, and at least one minor fire. ~Haven't got all night. Was there a point?~^";
];

[ NPC_Talk_Tommy;
    if (radio_fixed) {
        print "Tommy grins and taps his headphones. ~Coming through loud and clear now, thanks to you! I'm picking up all sorts. BBC, military channels, even some French resistance traffic.~^";
        rtrue;
    }
    print "Corporal Tommy sits hunched over a wireless set that has seen better days -- most of them before the Blitz. He taps at it and swears under his breath.^^";
    print "~Blasted thing's gone dead again. If I had a working valve I could get it going. The electronics shop on the west side might have had some, but...~ He gestures upward, indicating the general direction of the Luftwaffe.^";
];

[ NPC_Ask_Tommy topic;
    if (topic == 'radio' or 'wireless' or 'valve' or 'bbc') {
        if (radio_fixed) {
            print "~Working like a charm! Though I keep picking up a signal that's just someone reading the cricket scores. In 1941. We have priorities, apparently.~^";
        } else {
            print "~She's a Type 18 field wireless. Took her all the way to Dunkirk and back. But without a working valve, she's just a very expensive paperweight.~^";
        }
        rtrue;
    }
    if (topic == 'rubble' or 'dig' or 'box' or 'electronics') {
        if (tommy_helping) {
            print "~Right, let's get digging. Two pairs of hands are better than one. Lead the way to the rubble site.~^";
        } else if (radio_fixed) {
            print "~The rubble site? Dangerous, that. But I suppose I owe you one for the valve. Tell you what -- I'll help you dig if you need it. Just say the word.~^";
            tommy_helping = true;
            score = score + 3;
            print "[Tommy is now willing to help you dig.]^";
        } else {
            print "~Can't help with the rubble, mate. Not while the radio's down. Fix the wireless and we'll talk.~^";
        }
        rtrue;
    }
    if (topic == 'eleanor' or 'girl') {
        print "~Poor little thing. Barely says a word since her mum... well. She draws pictures all day. Cats, mostly. Says she had one before the bombing. I think it helps.~^";
        rtrue;
    }
    if (topic == 'help') {
        print "~Fix my radio and I'll help with whatever you need. That's the deal, mate.~^";
        rtrue;
    }
    print "Tommy scratches his chin. ~Can't help you there, I'm afraid. My expertise is limited to radios and digging.~^";
];

[ NPC_Talk_Hawking;
    if (hawking_convinced) {
        print "The speech synthesiser clicks. ~I am going to publish the temporal harmonics framework. Everything changes now.~ A pause. ~I wonder what they'll build with it.~^";
        rtrue;
    }
    if (hawking_phase == 0) {
        print "The most famous physicist alive regards you from his wheelchair with sharp, amused eyes. His speech synthesiser clicks to life.^^";
        print "~Welcome to my party for time travellers. You are the first guest to actually arrive. I was beginning to think my experiment had failed.~^^";
        print "The synthesiser pauses. ~Or perhaps it succeeded, and you are simply fashionably late by about a century.~^";
        rtrue;
    }
    if (hawking_phase == 1) {
        print "~You claim to be a time traveller, yet you haven't told me anything interesting about the future. Tell me something that would convince a theoretical physicist, not a tabloid editor.~^";
        rtrue;
    }
    if (hawking_phase == 2) {
        print "~Interesting. Very interesting. But I need more evidence. Show me something from your time that shouldn't exist in 2009.~^";
        rtrue;
    }
];

[ NPC_Ask_Hawking topic;
    if (topic == 'time' or 'travel' or 'machine' or 'temporal') {
        if (hawking_convinced) {
            print "~Here is what fascinates me. You came here in a machine that works. But the theory explaining WHY it works didn't exist until tonight. If I hadn't thrown this party, if you hadn't come, if I'd destroyed my notes...~ The synthesiser pauses. ~Would your machine still function? Would you still be here?~ Another pause. ~I suspect the universe does not permit that question to have a comfortable answer.~^";
        } else {
            print "~I have spent my career studying the nature of time. Closed timelike curves, chronology protection, the grandfather paradox. And now someone walks in claiming to have solved it with brass and steam.~ The synthesiser almost sounds amused. ~I'm listening.~^";
        }
        rtrue;
    }
    if (topic == 'formula' or 'calibration' or 'equatio' or 'printout') {
        if (hawking_convinced) {
            print "~The formula is the seed. Thirty years of my work, printed on tractor-feed paper by a dot-matrix printer older than most of my students.~ The synthesiser pauses. ~When I publish, others will build on it. Better instruments. Better materials. Perhaps even...~ He trails off, looking at something only a theoretical physicist could see. ~Well. The future will surprise us both.~^";
        } else {
            print "~You want a formula from me? Convince me you're a genuine time traveller first. I don't hand out my work to just anyone. Well, except in my books. But those cost money.~^";
        }
        rtrue;
    }
    if (topic == 'party' or 'invitation') {
        print "~I sent the invitations after the party. Only time travellers could attend. A temporal beacon, if you will -- a lighthouse for anyone lost in the stream of time.~ The synthesiser pauses. ~It's either a brilliant experiment or I'm about to eat a lot of canapes alone.~^";
        rtrue;
    }
    if (topic == 'cat' or 'copernicus') {
        print "~Is that a cat? In a Cambridge college?~ The synthesiser pauses. ~The cat is the most sensible guest here. Cats understand time instinctively. They spend most of it asleep.~^";
        rtrue;
    }
    if (topic == 'help') {
        print "~I suggest you talk to me about time travel and try to convince me you're genuine. Show me something impossible. Scientists respond to evidence, not speeches.~^";
        rtrue;
    }
    print "The synthesiser clicks. ~That topic falls outside my area of expertise. Which, given that my area of expertise is the entire universe, is saying something.~^";
];

[ NPC_Talk_Torres;
    if (kai_helping) {
        print "Mayor Torres nods. ~I see Kai has taken you under her wing. Good. She knows the flooded district better than anyone. If there's something worth finding down there, she'll help you find it.~^";
        rtrue;
    }
    print "Mayor Torres is a striking woman in her fifties, silver-haired and steel-spined. She runs the Climate Refuge with the calm efficiency of someone who has been managing catastrophes for decades.^^";
    print "~Another visitor from the dry zones? Or...~ She studies your Victorian clothing. ~Something else entirely. No matter. Everyone is welcome in the Refuge, provided they contribute. We don't have room for tourists.~^";
];

[ NPC_Ask_Torres topic;
    if (topic == 'flood' or 'water' or 'thames' or 'climate' or 'sea') {
        print "~The Thames Barrier failed in 2038. Seven years later, we're still adapting.~ She gestures at the window, where water laps at the second floor. ~London has always been a city built on a river. Now it's a city built IN a river. The difference is significant.~^";
        rtrue;
    }
    if (topic == 'museum' or 'barrier' or 'exhibit') {
        print "~The Thames Barrier Museum preserves what we can of the old city's history. The curator keeps it running against all odds. Worth a visit, if you can get there without swimming.~^";
        rtrue;
    }
    if (topic == 'kai' or 'scavenger') {
        print "~Kai? Best scavenger in the district. Young, brave, probably a bit foolish. She found the diving gear that lets us access the submerged levels. If you need to go below the waterline, talk to her.~^";
        rtrue;
    }
    if (topic == 'lab' or 'laboratory' or 'submerged') {
        print "~There's a research laboratory on the submerged level. Locked tight -- the researchers evacuated in a hurry. Kai might know how to get in. She's explored more of the flooded district than anyone.~^";
        rtrue;
    }
    if (topic == 'help') {
        print "~Talk to Kai on the walkway. She can help you navigate the flooded areas. And visit the museum -- our curator is quite knowledgeable.~^";
        rtrue;
    }
    print "Torres considers your question with the expression of someone who has seventeen more urgent problems to deal with. ~I'm afraid that's not my department. Try Kai, or the curator.~^";
];

[ NPC_Talk_Kai;
    if (kai_helping) {
        print "Kai grins. ~Ready when you are! The submerged level is accessible from the flooded street if you've got the gear. Just remember -- hold your breath metaphorically. The rebreather does the actual breathing.~^";
        rtrue;
    }
    print "A young woman in a weathered wetsuit perches on the railing of the walkway, legs dangling over the water below. She has the easy confidence of someone who has made friends with a disaster.^^";
    print "~Hey! You're new.~ She eyes your outfit. ~Very new. Like, historically new. I'm Kai. I salvage things from the flooded bits.~ She pats a set of diving gear beside her. ~Looking to go below?~^";
];

[ NPC_Ask_Kai topic;
    if (topic == 'dive' or 'diving' or 'gear' or 'swim' or 'rebreather') {
        if (has_diving_gear) {
            print "~You've got the gear. Just head down from the flooded street. Try not to touch anything that glows. Learned that one the hard way.~^";
        } else if (kai_helping) {
            print "~I've got spare diving gear right here. Take it -- I've got three more sets stashed around the district. I'm like a very wet squirrel.~^";
        } else {
            print "~The diving gear? Sure, I'll lend it to you. But first, help me with something. There's a locked panel on the museum rooftop -- I need someone with clever hands to open it. Deal?~^";
        }
        rtrue;
    }
    if (topic == 'lab' or 'laboratory' or 'submerged') {
        print "~The lab? Creepy place. Full of fancy equipment, mostly waterproof. The door's got an electronic lock -- you'll need a code or something.~ She shrugs. ~I just salvage the easy stuff.~^";
        rtrue;
    }
    if (topic == 'panel' or 'rooftop' or 'lock' or 'museum') {
        if (kai_helping) {
            print "~Thanks again for the panel! Torres has been wanting that comms array fixed for months.~^";
        } else {
            print "~There's a maintenance panel on the museum rooftop. Communications array, I think. Torres wants it fixed but it's locked. You look like you're good with fiddly mechanical things.~^";
        }
        rtrue;
    }
    if (topic == 'capsule' or 'time' or 'buried' or 'box') {
        if (capsule_buried) {
            print "~Oh yeah! The museum curator found an ancient time capsule recently. Roman-era, they think. It's on display. Pretty cool, actually.~^";
        } else {
            print "~Time capsule? Don't know anything about that.~^";
        }
        rtrue;
    }
    if (topic == 'help') {
        print "~Help me open the panel on the museum rooftop and I'll lend you my diving gear. Fair trade!~^";
        rtrue;
    }
    print "Kai shrugs cheerfully. ~Dunno about that. I just dive and salvage. Ask Torres or the curator for the big questions.~^";
];

[ NPC_Talk_Barkeep;
    print "The barkeep regards you with the weary patience of someone who has served ale to every variety of human foolishness. ~What'll it be, then? We've got bitter, mild, porter, and something Old Jem brews in his cellar that I'm legally obliged not to describe as gin.~ She polishes a glass with a cloth that has seen better centuries. ~You look like you could use a sit-down and a pie. We do a very decent kidney pie, Tuesdays and Thursdays. This being neither, you'll have to make do with conversation.~^";
];

[ NPC_Ask_Barkeep topic;
    if (topic == 'thyme' or 'doctor' or 'dr' or 'justin') {
        print "~Dr. Thyme? Oh, I know him. Comes in every other Thursday for a half of mild and talks at the fire for two hours about ~temporal whatsits.~ Harmless enough, if you don't mind your beer vibrating.~ She lowers her voice. ~Between you and me, half the street thinks he's barmy. The other half thinks he's a genius. I think he tips well and that's good enough for me.~^";
        rtrue;
    }
    if (topic == 'pemberton' or 'mrs') {
        print "~Mrs. Pemberton? Salt of the earth, that woman. Makes scones that'd bring a tear to the Queen's eye. She keeps Dr. Thyme fed and reasonably presentable, which is no small feat. They say she was a governess before she took up housekeeping. Explains the iron will and the ability to make a grown man eat his vegetables.~^";
        rtrue;
    }
    if (topic == 'beer' or 'ale' or 'drink' or 'bitter' or 'mild' or 'porter' or 'gin') {
        print "~The bitter's from Whitbread's -- reliable as rain. The mild's local, brewed by a man who believes hops are a government conspiracy, so it's more of a theological statement than a beverage. The porter'll put hair on your chest and remove it from your head. And the gin --~ She glances at a bottle that seems to be faintly luminous. ~-- the gin is Old Jem's. I make no warranties, express or implied.~^";
        rtrue;
    }
    if (topic == 'pie' or 'food' or 'kidney') {
        print "~The kidney pie is Mrs. Gresham's recipe, rest her soul. She left it to me in her will, along with this pub and a grudge against the Methodists. I make it Tuesdays and Thursdays. Other days, there's bread and cheese and whatever's in the pot, which is usually soup but has occasionally been something that defies classification.~^";
        rtrue;
    }
    if (topic == 'praed' or 'street' or 'paddington' or 'london' or 'area' or 'neighbourhood') {
        print "~Praed Street? It's Paddington, innit. Railway brings all sorts through -- travellers, engineers, ladies of negotiable virtue, and the occasional foreigner who thinks the Great Western Railway is the pinnacle of human achievement. They're not wrong, mind.~ She nods towards the window. ~Used to be quieter before they built the station. Now it's all bustle and pickpockets and people asking directions to places they shouldn't want to go.~^";
        rtrue;
    }
    if (topic == 'pub' or 'tap' or 'brass') {
        print "~The Brass Tap's been here since 1847. My grandmother opened it, my mother ran it, and I'll run it till they carry me out feet first or the brewery doubles the rent, whichever comes first.~ She gestures at the ceiling. ~That stain up there? That's from the Great Stink of '58. We keep it for historical purposes. Also because nothing shifts it.~^";
        rtrue;
    }
    if (topic == 'time' or 'temporal' or 'machine' or 'engine') {
        print "~Time travel?~ The barkeep gives you a look that could curdle milk at thirty paces. ~Love, I've been standing behind this bar for twenty-three years. I've heard theories about the afterlife, the gold standard, the proper way to cook a kipper, and whether the moon is made of cheese. Time travel is far from the maddest thing anyone's said to me this week. That honour goes to the man on Tuesday who claimed his parrot could predict the Derby results.~^";
        rtrue;
    }
    if (topic == 'cat' or 'copernicus' or 'tom') {
        print "~Cats? We had Old Tom -- best mouser this side of the Thames. See the plaque on the mantel. Thirteen years of loyal service and not a rat survived his watch.~ She sighs. ~Since Tom passed, the mice have got ideas above their station. I keep meaning to get another, but it'd feel disloyal.~^";
        rtrue;
    }
    if (topic == 'help') {
        print "~Help? This is a pub, not the Salvation Army. But if you need directions, advice, or someone to tell you you're making a terrible mistake, you've come to the right place. That's basically what barkeeps are for.~^";
        rtrue;
    }
    print "The barkeep shrugs with the eloquence of a woman who has elevated indifference to an art form. ~Can't help you with that, love. Try the bitter -- it won't answer your questions, but it'll make you care less about them.~^";
];

[ NPC_Ask_Newsboy topic;
    if (topic == 'paper' or 'news' or 'newspaper' or 'times' or 'headline') {
        print "~Best paper in London, guv! All the news what's fit to print, and some what ain't. Tuppence!~ He waves a copy enticingly.^";
        rtrue;
    }
    if (topic == 'thyme' or 'doctor' or 'dr' or 'temporal' or 'enginee') {
        print "~That mad inventor bloke? Number fourteen?~ The newsboy jerks his thumb down the alley. ~Goes in there of a morning, comes out smelling of smoke and marmalade. Harmless enough, I reckon, long as you don't mind the bangs.~^";
        rtrue;
    }
    if (topic == 'job' or 'work' or 'apprenti') {
        print "~Work? This IS me work, guv. Selling papers since I was eight. Before that I was a crossing sweeper, but the horses didn't care for me and I didn't care for what they left behind.~^";
        rtrue;
    }
    if (topic == 'paddington' or 'station' or 'train' or 'railway') {
        print "~Paddington? Just down the road, west of here. Big place, can't miss it. Trains going everywhere -- Bristol, Wales, the lot. Mind the pickpockets.~^";
        rtrue;
    }
    print "The newsboy shrugs. ~Dunno about that, guv. I just sell papers. Tuppence a copy!~^";
];

! ===================================================================
! CUSTOM STATUS LINE
! ===================================================================

[ PrintTime12 h m;
    h = the_time / 60;
    m = the_time % 60;
    if (h == 0) { print "12"; }
    else if (h <= 12) { print h; }
    else { print h - 12; }
    print ":";
    if (m < 10) print "0";
    print m;
    if (h < 12) print " am";
    else print " pm";
];

[ DrawStatusLine width posa posc;
    @set_window 1;
    @set_cursor 1 1;
    style reverse;
    width = 0->33;
    spaces width;
    @set_cursor 1 1;
    switch (current_era) {
        0: print " London, 1895";
        1: print " Londinium, 60 AD";
        2: print " London, 1941";
        3: print " Cambridge, 2009";
        4: print " London, 2045";
    }
    posc = width / 2 - 3;
    @set_cursor 1 posc;
    PrintTime12();
    posa = width - 14;
    @set_cursor 1 posa;
    print "Score: ", score, "/", MAX_SCORE, " ";
    style roman;
    @set_window 0;
];

! ===================================================================
! BEFOREPARSING — rewrite custom verbs
! ===================================================================

[ BeforeParsing i len w w2;
    ! Clamp input length to prevent buffer overflow on long input
    if (buffer->1 > 120) buffer->1 = 120;
    ! Strip period from "dr." to prevent parser confusion
    for (i = 4: i < 2 + buffer->1: i++) {
        if (buffer->i == '.' && buffer->(i-1) == 'r' && buffer->(i-2) == 'd') {
            buffer->i = ' ';
            Tokenise__(buffer, parse);
        }
    }
    wn = 1;
    w = NextWord();
    if (w == 'carve' or 'engrave' or 'inscribe') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 'c';
        i->2 = 'r';
        while (len > 3) { len--; i->len = ' '; }
        ! Blank all trailing words so "carve stone with toolkit" becomes "zcr"
        if (parse->1 > 1) {
            i = WordAddress(2);
            len = (buffer + 2 + buffer->1) - i;
            while (len > 0) { len--; i->len = ' '; }
        }
        Tokenise__(buffer, parse);
    }
    if (w == 'bury') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 'b';
        i->2 = 'r';
        while (len > 3) { len--; i->len = ' '; }
        Tokenise__(buffer, parse);
    }
    if (w == 'travel' or 'teleport') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 't';
        i->2 = 'v';
        while (len > 3) { len--; i->len = ' '; }
        Tokenise__(buffer, parse);
    }
    if (w == 'repair' or 'fix' or 'mend' or 'install' or 'attach' or 'transcribe' or 'use' or 'replace') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 'r';
        i->2 = 'p';
        while (len > 3) { len--; i->len = ' '; }
        Tokenise__(buffer, parse);
        ! Strip preposition + trailing words so "zrp X in/with Y"
        ! becomes "zrp X" and the parser never fails on extra tokens
        wn = 2;
        while (wn <= parse->1) {
            w2 = NextWord();   ! reads word at wn, advances wn
            if (w2 == 'in' or 'with' or 'on' or 'into' or 'onto' or 'to' or 'using' or 'formula' or 'navigation') {
                ! Blank from preposition to end of input
                i = WordAddress(wn - 1);
                len = (buffer + 2 + buffer->1) - i;
                while (len > 0) { len--; i->len = ' '; }
                Tokenise__(buffer, parse);
                break;
            }
        }
    }
    if (w == 'extinguish' or 'smother') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 'e';
        i->2 = 'x';
        while (len > 3) { len--; i->len = ' '; }
        Tokenise__(buffer, parse);
    }
    if (w == 'pet' or 'stroke') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 'p';
        i->2 = 't';
        while (len > 3) { len--; i->len = ' '; }
        Tokenise__(buffer, parse);
    }
    if (w == 'dig') {
        i = WordAddress(1);
        i->0 = 'z';
        i->1 = 'd';
        i->2 = 'g';
        Tokenise__(buffer, parse);
    }
    if (w == 'clean' or 'tidy' or 'sweep' or 'wipe' or 'scrub' or 'polish') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 'c';
        i->2 = 'l';
        while (len > 3) { len--; i->len = ' '; }
        ! Blank all trailing words so parser sees only "zcl"
        if (parse->1 > 1) {
            i = WordAddress(2);
            len = (buffer + 2 + buffer->1) - i;
            while (len > 0) { len--; i->len = ' '; }
        }
        Tokenise__(buffer, parse);
    }
    if (w == 'knock' or 'rap' or 'bang' or 'pound') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 'k';
        i->2 = 'n';
        while (len > 3) { len--; i->len = ' '; }
        ! Blank adverbs so "knock harder" becomes "zkn"
        wn = 2;
        w2 = NextWord();
        if (w2 == 'harder' or 'louder' or 'again') {
            i = WordAddress(wn - 1);
            len = WordLength(wn - 1);
            while (len > 0) { len--; i->len = ' '; }
        }
        Tokenise__(buffer, parse);
    }
    if (w == 'yell') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 'y';
        i->2 = 'l';
        while (len > 3) { len--; i->len = ' '; }
        ! Blank 'at' so "yell at cat" becomes "zyl cat"
        wn = 2;
        w2 = NextWord();
        if (w2 == 'at') {
            i = WordAddress(wn - 1);
            len = WordLength(wn - 1);
            while (len > 0) { len--; i->len = ' '; }
        }
        Tokenise__(buffer, parse);
    }
    if (w == 'shoo') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 's';
        i->2 = 'h';
        while (len > 3) { len--; i->len = ' '; }
        Tokenise__(buffer, parse);
    }
    if (w == 'kick') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 'k';
        i->2 = 'k';
        while (len > 3) { len--; i->len = ' '; }
        Tokenise__(buffer, parse);
    }
    if (w == 'grab') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 't';
        i->1 = 'a';
        i->2 = 'k';
        i->3 = 'e';
        while (len > 4) { len--; i->len = ' '; }
        Tokenise__(buffer, parse);
    }
    if (w == 'hand') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'g';
        i->1 = 'i';
        i->2 = 'v';
        i->3 = 'e';
        while (len > 4) { len--; i->len = ' '; }
        Tokenise__(buffer, parse);
    }
    if (w == 'meow' or 'mew' or 'miaow') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 'm';
        i->2 = 'w';
        while (len > 3) { len--; i->len = ' '; }
        ! Blank 'at' so "meow at cat" becomes "zmw cat"
        wn = 2;
        w2 = NextWord();
        if (w2 == 'at') {
            i = WordAddress(wn - 1);
            len = WordLength(wn - 1);
            while (len > 0) { len--; i->len = ' '; }
        }
        Tokenise__(buffer, parse);
    }
    if (w == 'buy' or 'purchase' or 'order') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 'b';
        i->2 = 'y';
        while (len > 3) { len--; i->len = ' '; }
        Tokenise__(buffer, parse);
    }
    if (w == 'circle' or 'mark' or 'ring') {
        i = WordAddress(1);
        len = WordLength(1);
        i->0 = 'z';
        i->1 = 'c';
        i->2 = 'i';
        while (len > 3) { len--; i->len = ' '; }
        Tokenise__(buffer, parse);
    }
    rfalse;
];

! ===================================================================
! WORKSHOP HUB — 1895 London
! ===================================================================

Object workshop_entrance "Workshop Entrance"
    with description [;
            if (endgame_phase == 1) {
                "You are pressed against the wall behind the front door. Through the eastern doorway you can hear your past self rummaging on the shelves while Dr. Thyme mutters about Tuesday spanners. Neither of them is looking this way. The workshop is east.";
            }
            print "A narrow alley off Praed Street, thick with London fog and the eternal smell of coal smoke. Gas lamps throw jaundiced circles on the cobblestones. A brass plate beside a heavy oak door reads: ~DR. J. THYME -- TEMPORAL ENGINEERING -- NO SALESMEN.~^^";
            if (door_open)
                print "The oak door stands open, revealing the workshop beyond to the east.^";
            else
                print "The heavy oak door is closed. You should probably knock.^";
            print "The alley continues west to Praed Street.^";
        ],
         e_to [;
            if (endgame_phase == 1) {
                BootstrapCross();
                rtrue;
            }
            if (door_open) return main_workshop;
            "The heavy oak door is firmly closed. Perhaps you should knock.";
         ],
         in_to [;
            if (endgame_phase == 1) {
                BootstrapCross();
                rtrue;
            }
            if (door_open) return main_workshop;
            "The heavy oak door is firmly closed. Perhaps you should knock.";
         ],
         w_to [;
            if (endgame_phase == 1)
                "You can't leave. If your past self finds you outside, the loop breaks -- and everything you've done unravels.";
            return praed_street;
         ],
         each_turn [;
            if (endgame_phase == 1) {
                endgame_turns++;
                if (endgame_turns == 1)
                    print "^Your past self is busy with the spanner. Now is your chance -- the workshop is east.^";
                if (endgame_turns >= 2) {
                    print "^You can't wait any longer. If your past self turns around...^^";
                    BootstrapCross();
                }
            }
         ],
    has light;

Object coat_hook "coat hook" workshop_entrance
    with name 'hook' 'coat' 'hooks' 'rack' 'peg' 'overcoat',
         description [;
            if (thyme_departed)
                "A row of brass hooks by the door. Dr. Thyme's enormous overcoat is gone -- he grabbed it on his way out.";
            "A row of brass hooks by the door. Dr. Thyme's enormous overcoat hangs from one. Yours would fit inside it roughly three times.";
         ],
    has scenery;

Object entrance_brass_plate "brass plate" workshop_entrance
    with name 'brass' 'plate' 'sign' 'plaque',
         description "A tarnished brass plate beside the door, engraved with impeccable Victorian confidence: ~DR. J. THYME -- TEMPORAL ENGINEERING -- NO SALESMEN.~ The 'no salesmen' has been underlined twice.",
    has scenery;

Object entrance_door "oak door"
    with name 'door' 'oak' 'heavy' 'front',
         found_in workshop_entrance main_workshop,
         description [;
            if (location == main_workshop) {
                if (door_open)
                    "From inside, the oak door stands open to the west, letting in wisps of London fog and the smell of coal smoke. The brass hinges gleam with recent oiling. That suspicious dent at cat-height is even more pronounced from this side.";
                "The heavy oak door to the west is firmly shut against the London fog. From inside, you can see the substantial brass lock and the magnificent hinges. The dent at cat-height looks rather like something hit it at speed.";
            }
            if (door_open)
                "The heavy oak door stands open. The hinges are magnificent brass affairs. A suspicious dent at cat-height suggests this is not the first time something has made a dramatic entrance.";
            "A heavy oak door, firmly closed. Scarred by decades of London weather and possibly one or two small explosions. The brass hinges are magnificent. The dent at cat-height is suspicious.";
         ],
         before [;
            Close:
                "You've come this far. No point closing it now.";
            Open, Push, Pull:
                if (location == main_workshop) {
                    if (endgame_knocks_heard) {
                        BootstrapStart();
                        rtrue;
                    }
                    if (door_open)
                        "The door is already open.";
                    "The door doesn't budge. It seems to be stuck -- or perhaps it only opens from outside.";
                }
                if (door_open)
                    "The door is already open.";
                "The door seems to be locked from the inside.";
            Lock, Unlock:
                if (door_open)
                    "The door is wide open. Locking it now would be like closing the barn door after the horse has invented time travel.";
                if (location == main_workshop)
                    "The lock mechanism on this side is purely decorative -- or possibly broken. Either way, it's not cooperating.";
                "The lock is on the inside. You'd need to be in the workshop to manage it, and if you were in the workshop, you wouldn't need to.";
         ],
    has scenery;

Object door_hinges "brass hinges"
    with name 'hinges' 'hinge' 'brass',
         found_in workshop_entrance main_workshop,
         description "The hinges are gloriously over-engineered -- each one a miniature cathedral of brass, with buttresses and flourishes that serve no structural purpose whatsoever. They are polished to a mirror shine, suggesting someone oils them with the devotion normally reserved for religious artefacts.",
    has scenery pluralname;

Object door_dent "dent"
    with name 'dent' 'mark' 'scratch',
         found_in workshop_entrance main_workshop,
         description "A suspiciously cat-shaped dent at precisely cat-height. The impact pattern suggests something hit the door at considerable velocity, possibly while pursuing a moth. Copernicus, of course, would deny all involvement, and his expression of wounded innocence would be entirely convincing if not for the tuft of silver fur still embedded in the wood grain.",
    has scenery;

Object entrance_gas_lamps "gas lamps" workshop_entrance
    with name 'gas' 'lamp' 'lamps' 'light' 'lights',
         description "The gas lamps throw circles of jaundiced light onto the cobblestones, each one a small island of visibility in the London murk. They hiss and flicker with the quiet persistence of Victorian infrastructure.",
    has scenery pluralname;

Object entrance_cobblestones "cobblestones" workshop_entrance
    with name 'cobbleston' 'cobble' 'cobbles' 'stones' 'street',
         description "Worn smooth by a century of cart wheels and boot heels. Each cobblestone is a small monument to the stonemason's art and London's absolute refusal to adopt modern paving.",
    has scenery pluralname;

Object entrance_fog "fog" workshop_entrance
    with name 'fog' 'smog' 'mist' 'smoke',
         description "London fog -- equal parts moisture, coal smoke, and municipal indifference. It clings to everything like a damp, grey cat. Visibility is roughly twelve feet, which in this neighbourhood is probably a mercy.",
    has scenery;

Object newspaper "newspaper"
    with name 'newspaper' 'times' 'paper' 'advert' 'advertisement' 'ad' 'classifi' 'copy' 'headline' 'headlines',
         description [;
            ! Phase 1: Pre-accident — normal Victorian newspaper
            if (cat_accident == false) {
                print "Today's Times, fresh off the press and still smelling of ink and ambition. ";
                if (ad_circled)
                    "The advert you circled reads: ~DR. J. THYME -- TEMPORAL ENGINEERING -- seeks apprentice with good penmanship and a flexible relationship with linear time. Competitive wages. No salesmen.~ 14 Praed Street. The rest of the front page is the usual: municipal drainage projects, colonial dispatches, and a long letter about the declining quality of hansom cabs.";
                "In the classifieds you notice an advert: ~DR. J. THYME -- TEMPORAL ENGINEERING -- seeks apprentice with good penmanship and a flexible relationship with linear time. Competitive wages. No salesmen.~ 14 Praed Street. The rest of the front page is the usual: municipal drainage projects, colonial dispatches, and a long letter about the declining quality of hansom cabs.";
            }
            ! Phase 3: Museum display (scenery = in museum case)
            if (self has scenery) {
                print "Through the climate-controlled glass, you can make out a single yellowed page of the Times. Your stomach lurches with recognition. There -- the pencil circle around the advert for TEMPORAL ENGINEERING. There -- the fold where you always tucked it under your arm. There -- the smudge of newsprint from the newsboy's grubby fingers.^^";
                print "A placard reads: ~VICTORIAN NEWSPAPER, 1895. RECOVERED FROM SEALED AMPHORA, ROMAN STRATUM, THAMES EXCAVATION SITE. THE VESSEL'S WAX SEAL WAS INTACT WHEN FOUND. PROVENANCE UNKNOWN. NOTE: INK APPEARS TO CHANGE UNDER OBSERVATION. DO NOT ADJUST DISPLAY.~^^";
                if (capsule_buried)
                    print "A smaller note adds: ~Found alongside brass pocket watch. See Roman Time Capsule exhibit.~^^";
                ! Show headlines through the glass
                print "The headlines are still legible through the glass:^";
                if (inscription_carved)
                    print "  ~MYSTERIOUS INSCRIPTION IN CITY CHURCH~ -- the ink looks freshly printed, though the paper around it is yellowed with age.^";
                else
                    print "  ~RESTORATION WORKS AT CITY CHURCHES -- Stonemasons Report Nothing of Interest.~^";
                if (capsule_buried)
                    print "  ~VICTORIAN POCKET WATCH IN ROMAN STRATUM~ -- the letters shimmer and rearrange as you watch.^";
                else
                    print "  ~THAMES EXCAVATION YIELDS POTTERY FRAGMENTS -- Scholars Describe Find as Adequate.~^";
                if (eleanor_gift)
                    print "  ~ELEANOR MORRISON RETROSPECTIVE AT GALLERY~ -- the photograph fades in and out of focus.^";
                else
                    print "  ~NATIONAL GALLERY WINTER EXHIBITION -- Landscapes and Still Lifes, Nothing Remarkable.~^";
                if (church_saved)
                    print "  ~ST. MARGARET'S CELEBRATES 600TH ANNIVERSARY~ -- the ink is so fresh it almost smudges under your thumb. Except, of course, the glass is in the way.^";
                else
                    print "  ~CAR PARK ON FORMER CHURCH SITE APPROVED -- Council Votes 7-3.~^";
                rtrue;
            }
            ! Phase 2: Carried post-accident — shifting headlines
            print "Today's Times. Although ~today~ is becoming a somewhat philosophical concept. The paper feels subtly wrong in your hands -- the ink not quite committed to its current arrangement, as if the words are waiting for permission to change.^^";
            print "The circled advert for TEMPORAL ENGINEERING remains stubbornly stable, anchored by the fact that it definitely happened. The fold where you tucked it under your arm is the only familiar thing about it.^^";
            print "The headlines, however...^^";
            if (inscription_carved)
                print "  ~MYSTERIOUS INSCRIPTION IN CITY CHURCH -- Latin Graffiti Predates Foundation by Centuries.~ The ink looks freshly printed, though the paper around it has yellowed.^";
            else
                print "  ~RESTORATION WORKS AT CITY CHURCHES -- Stonemasons Report Nothing of Interest.~^";
            if (capsule_buried)
                print "  ~VICTORIAN POCKET WATCH IN ROMAN STRATUM -- Thames Excavation Yields Impossible Anachronism.~ The letters shimmer and rearrange as you watch.^";
            else
                print "  ~THAMES EXCAVATION YIELDS POTTERY FRAGMENTS -- Scholars Describe Find as Adequate.~^";
            if (eleanor_gift)
                print "  ~ELEANOR MORRISON RETROSPECTIVE AT GALLERY -- Wartime Artist Credits Kindness of Stranger.~ The photograph fades in and out of focus.^";
            else
                print "  ~NATIONAL GALLERY WINTER EXHIBITION -- Landscapes and Still Lifes, Nothing Remarkable.~^";
            if (church_saved)
                print "  ~ST. MARGARET'S CELEBRATES 600TH ANNIVERSARY -- Medieval Gem Survived Blitz.~ The ink is so fresh it almost smudges under your thumb.^";
            else
                print "  ~CAR PARK ON FORMER CHURCH SITE APPROVED -- Council Votes 7-3.~^";
            rtrue;
         ],
         before [;
            Drop:
                "You fold the newspaper and tuck it back under your arm. A time traveller should keep up with current events.";
            Take:
                if (self has scenery)
                    "The display case is sealed. Besides, you have a strange feeling it's exactly where it needs to be.";
         ];

Object entrance_alley "alley" workshop_entrance
    with name 'alley' 'alleyway' 'lane' 'narrow',
         description "A narrow alley off Praed Street, barely wide enough for two people to pass without exchanging pleasantries or diseases. The walls are damp brick, the ground is damp cobblestone, and the air is damp everything.",
    has scenery;

! ===================================================================
! PRAED STREET & THE BRASS TAP (optional 1895 locations)
! ===================================================================

Object praed_street "Praed Street"
    with description "Praed Street stretches east to west through a curtain of London fog so thick you could hang wallpaper on it. Gas lamps march along the pavement like jaundiced sentries, each one illuminating roughly three square feet of cobblestone and several cubic yards of soot. Hansom cabs clatter past at irregular intervals, their drivers hunched against the damp like mushrooms in top hats.^^A narrow alley leads east. A hanging sign to the south reads ~THE BRASS TAP~ in letters that have given up all pretence of being gold. Paddington Station looms to the west.",
         e_to workshop_entrance,
         s_to brass_tap,
         in_to brass_tap,
         n_to "You step off the kerb and are nearly flattened by a hansom cab. The driver shouts something anatomically creative and vanishes into the fog. Perhaps best to stay on the pavement.",
         w_to paddington_station,
    has light;

Object street_gas_lamps "street gas lamps" praed_street
    with name 'gas' 'lamp' 'lamps' 'light' 'lights' 'street',
         description "The gas lamps hiss and spit like disapproving aunts. Each one casts a sickly yellow circle on the pavement, creating small islands of visibility in an ocean of fog. One of them flickers in a pattern that is either a fault in the gas supply or Morse code for ~help.~",
         before [;
            Touch:
                "The lamp post is slick with condensation and approximately a century of accumulated London. You withdraw your hand and wipe it on your trousers.";
         ],
    has scenery pluralname;

Object street_cobblestones "cobblestones" praed_street
    with name 'cobbleston' 'cobble' 'cobbles' 'stones' 'pavement' 'road',
         description "The cobblestones are worn into shallow bowls by generations of traffic, each one collecting a small puddle of rainwater and horse-related matter that you prefer not to examine too closely.",
    has scenery pluralname;

Object street_fog "fog" praed_street
    with name 'fog' 'smog' 'mist' 'smoke' 'pea',
         description "The famous London particular -- a pea-soup fog of coal smoke, river damp, and industrial ambition. It tastes faintly of pennies and regret. Somewhere in it, a dog is barking at something only dogs can see.",
    has scenery;

Object street_hansom_cabs "hansom cabs" praed_street
    with name 'cab' 'cabs' 'hansom' 'carriage' 'carriages' 'driver' 'drivers',
         description "The hansoms materialise from the fog like ghosts with hooves, clatter past in a blur of varnished wood and bad language, and vanish again into the murk. The drivers appear to navigate entirely by instinct, profanity, and an unshakeable faith in the self-preservation instincts of pedestrians.",
         before [;
            Enter:
                "You wave at a passing hansom, but it dissolves into the fog like a particularly unhelpful mirage. You've nowhere to go that you can't walk, anyway.";
            Take:
                "You attempt to hail a cab. Three clatter past without slowing. A fourth slows, the driver peers at you, makes a face suggesting your fare would not be worth his time, and whips his horse back into the murk.";
         ],
    has scenery pluralname;

Object newsboy "newsboy" praed_street
    with name 'newsboy' 'boy' 'lad' 'urchin' 'kid',
         description "A sharp-faced lad of perhaps twelve, wearing a cap three sizes too large and a coat that appears to have been inherited from someone considerably wider. His fingers are black with newsprint and his expression suggests a keen commercial intelligence that most adults never achieve.",
         initial [;
            if (newspaper in self)
                "A newsboy on the corner waves a folded paper. ~Paper! Tuppence! Get your Times!~";
            "The newsboy loiters on the corner, having sold you his last copy. He picks his teeth with an air of entrepreneurial satisfaction.";
         ],
         life [;
             Give:
                 if (noun == coins) { <<ZBuy newspaper>>; }
                 "The newsboy eyes your offering with suspicion. ~I sell papers, guv. I ain't a pawnbroker.~";
             Ask, Tell:
                 NPC_Ask_Newsboy(second); rtrue;
         ],
         add_to_scope [; if (newspaper in self) PlaceInScope(newspaper); ],
    has animate proper;

Object street_sign "hanging sign" praed_street
    with name 'sign' 'hanging' 'brass' 'tap',
         description "A wrought-iron bracket supports a sign depicting a brass tap from which golden liquid flows. The gilding has mostly flaked away, leaving the sign looking like a tap dispensing rust. Below, in smaller letters: ~EST. 1847 -- ALES, SPIRITS, PIES -- WARMTH AND QUESTIONABLE COMPANY.~",
         before [;
            Enter:
                PlayerTo(brass_tap);
                rtrue;
         ],
    has scenery;

! ===================================================================
! PADDINGTON STATION (optional 1895 location, west of Praed Street)
! ===================================================================

Object paddington_station "Paddington Station"
    with description "The great iron-and-glass canopy of Paddington Station soars overhead like a cathedral built by engineers instead of bishops. Locomotives hiss and chuff at the platforms, wreathed in steam that mingles with the ever-present London fog. Porters weave between mountains of luggage, and a four-faced clock tower presides over the concourse with the stern authority of Greenwich itself.^^Praed Street is back to the east.",
         e_to praed_street,
         out_to praed_street,
         w_to "The platforms stretch westward, but you have no ticket, no destination, and -- after Greybaum, Tedium and Sons -- no particular desire to flee to Bristol.",
         n_to "That way leads to more platforms, more steam, and more people who know exactly where they're going. Unlike you.",
         s_to "The station wall blocks your way. A poster advertises seaside holidays in Weston-super-Mare with rather more enthusiasm than Weston-super-Mare deserves.",
    has light;

Object station_canopy "iron-and-glass canopy" paddington_station
    with name 'canopy' 'roof' 'iron' 'glass' 'arch' 'arches' 'girder' 'girders',
         description "Isambard Kingdom Brunel's masterpiece of engineering -- a vast triple-span roof of wrought iron and glass that turns the station into a luminous cavern. Condensation drips from the girders at intervals, giving the whole structure the atmosphere of a very large, very well-organised greenhouse.",
    has scenery;

Object station_locomotives "locomotives" paddington_station
    with name 'locomotive' 'locomotives' 'train' 'trains' 'engine' 'engines' 'steam',
         description "Great Western Railway locomotives in Brunswick green, their brass fittings polished to a military shine. They hiss and sigh at the platforms like enormous iron animals waiting to be fed. One of them bears the nameplate DODONAEUS, which seems ambitious for something that runs to Swindon.",
         before [;
            Enter:
                "You have no ticket, no luggage, and no reason to leave London. The locomotive regards you with the indifference of heavy machinery.";
         ],
    has scenery pluralname;

Object station_porters "porters" paddington_station
    with name 'porter' 'porters' 'luggage' 'bags' 'trunks',
         description "An army of porters in caps and waistcoats, performing the ancient choreography of luggage management. Each one navigates the concourse with a hand truck piled high enough to constitute a structural risk, weaving between passengers with the practiced ease of people who have long since stopped caring about physics.",
    has scenery pluralname animate;

Object station_clock "clock tower" paddington_station
    with name 'clock' 'tower' 'faces' 'four',
         description "A magnificent four-faced clock tower rising from the concourse, each face showing a slightly different time -- whether by design or neglect is anyone's guess. The minute hands move with the ponderous certainty of an institution that considers itself more important than the trains it serves.",
    has scenery;

Object brass_tap "The Brass Tap"
    with description "A snug Victorian pub that has been slowly pickling in its own atmosphere since the reign of Queen Victoria's grandfather. The ceiling is the colour of strong tea from decades of tobacco smoke. A long mahogany bar dominates one wall, its surface polished to a mirror finish by generations of elbows. Behind it, bottles of varying respectability jostle for space. A coal fire crackles in the grate, providing both warmth and a gentle undertone of carbon monoxide.^^The barkeep, a woman of magnificent proportions and deeply suspicious eyebrows, presides over her domain with the quiet authority of someone who has heard every excuse in the English language and believed none of them.^^The door north leads back to Praed Street.",
         n_to praed_street,
         out_to praed_street,
         e_to "That wall is occupied by a dartboard, three hunting prints, and a stain of mysterious provenance. There is no exit.",
         w_to "The only things west are the coal fire, a brass spittoon, and a cat that may or may not be alive. None of them are exits.",
         s_to "The back wall is solid brick. The publican's licence and a portrait of the Queen hang there. Neither is a door.",
    has light;

Object tap_bar "mahogany bar" brass_tap
    with name 'bar' 'mahogany' 'counter',
         description "A magnificent slab of mahogany, dark as sin and twice as inviting. Its surface is worn smooth by a thousand forearms and polished to a shine you could check your teeth in. Several brass beer taps protrude from it like small industrial monuments. Ring marks from a century of tankards form overlapping circles that could be mistaken for a mathematical proof, if you squinted.",
         before [;
            Rub, Touch:
                "You run a hand along the bar's surface. It is smoother than silk and faintly sticky -- the two states are not, in pubs, mutually exclusive.";
         ],
    has scenery;

Object tap_fire "coal fire" brass_tap
    with name 'fire' 'coal' 'grate' 'hearth' 'fireplace',
         description "A generous coal fire that radiates heat and a faint smell of sulphur. The grate is cast iron, decorated with a relief of hops and barley. Above it, a mantelpiece bears a stuffed pheasant under a glass dome, a clock that stopped in 1873, and a small brass plaque reading ~IN MEMORY OF OLD TOM, BEST MOUSER THIS SIDE OF THE THAMES, 1881-1894.~",
         before [;
            Touch:
                "It's a coal fire. It is hot. This should not require empirical verification.";
            Take:
                "The fire is doing far more good where it is. Besides, carrying a coal fire through the streets of London would attract comment, even by Paddington standards.";
         ],
    has scenery;

Object tap_bottles "bottles" brass_tap
    with name 'bottle' 'bottles' 'spirits' 'whisky' 'gin' 'brandy',
         description "A regiment of bottles stands at attention behind the bar: amber whisky, clear gin, mahogany brandy, and several unlabelled vessels of genuinely alarming colour. One bottle in the back appears to glow faintly, but that might be the firelight. Or it might not. Best not to ask.",
         before [;
            Take:
                "The barkeep's eyebrows contract in a manner suggesting that touching her bottles uninvited would result in consequences both swift and medieval.";
            Drink:
                "You'd need to order from the barkeep first. And probably bring proof of a strong constitution.";
         ],
    has scenery pluralname;

Object tap_dartboard "dartboard" brass_tap
    with name 'dartboard' 'dart' 'darts' 'board',
         description "A cork dartboard hangs on the east wall, its surface so perforated it resembles a map of the lunar surface. Someone has written ~LANDLORD'S RULES: NO THROWING DURING EARTHQUAKES, SÉANCES, OR ARGUMENTS ABOUT THE BOER WAR~ on a card pinned beside it.",
    has scenery;

Object pint_of_ale "pint of ale"
    with name 'pint' 'ale' 'beer' 'bitter' 'drink' 'glass',
         description "A pint of dark ale in a heavy glass tankard. It has a head like a thundercloud and smells of hops and mild regret.",
         before [;
            Drink:
                remove self;
                "You take a long, slow pull. The ale is excellent -- dark, malty, with a finish that suggests the barkeep's grandmother knew what she was doing. The glass empties with a satisfied sigh.";
            Drop:
                "You set the glass on the bar. The barkeep gives you a look that suggests unfinished drinks are a personal affront.";
         ];

Object barkeep "barkeep" brass_tap
    with name 'barkeep' 'woman' 'publican' 'landlady' 'barmaid' 'bartend',
         description "A woman built along the generous lines of a Victorian dreadnought, with arms that suggest a past career in either blacksmithing or bare-knuckle boxing. Her hair is pinned up in a gravity-defying arrangement that could conceal several hat pins and possibly a small weapon. She surveys her pub with the eternal vigilance of someone who has seen everything, forgotten nothing, and forgiven very little.",
         life [;
            Ask:
                NPC_Ask_Barkeep(second);
                rtrue;
            Tell:
                "The barkeep listens with one eyebrow raised to a height that suggests polite scepticism. When you finish, she says, ~Right then,~ in a tone that conveys neither agreement nor disagreement but an infinite capacity for judgement.";
            Give:
                if (noun == coins) { <<ZBuy pint_of_ale>>; }
                "The barkeep eyes your offering with deep suspicion. ~I don't take nothing I can't identify, and precious little I can. This is a pub, not a curiosity shop.~";
            Attack:
                "You reconsider. The barkeep has the build of someone who could throw you through the front window without spilling a single pint. Discretion is the better part of continued existence.";
         ],
         add_to_scope [; PlaceInScope(pint_of_ale); ],
    has animate female;

Object pocket_watch "pocket watch"
    with name 'watch' 'pocket' 'timepi' 'fob',
         description "Your grandfather's pocket watch. A handsome brass piece, slightly dented, perpetually three minutes fast. The irony of carrying a faulty timepiece to a job in temporal engineering has not escaped you.",
         before [;
            Listen:
                "Tick. Tick. Tick. Reassuringly constant, unlike everything else in your life at the moment.";
         ];

Object coins "handful of coins"
    with name 'coins' 'coin' 'money' 'pennies' 'shilling' 'wages' 'handful' 'tuppence' 'pence' 'two',
         description [;
            if (newspaper in player)
                "What remains of your wages after the newsboy's tuppence. Enough for a pint, perhaps, but not much else.";
            "Your final wages from Greybaum, Tedium and Sons. A handful of coins that wouldn't impress a church mouse. Enough for a newspaper and a pint, if you're careful.";
         ],
         before [;
            Drop:
                "You're not so flush that you can afford to scatter money in the street. Greybaum, Tedium and Sons were not known for generous severance packages.";
         ],
    has pluralname;

Object pencil "pencil" brass_tap
    with name 'pencil' 'pen' 'graphite',
         description "A slightly chewed pencil, abandoned by some previous patron. The lead is soft enough for marking newsprint.",
         initial "A slightly chewed pencil has been left on the bar.";

Object main_workshop "Main Workshop"
    with description [;
            if (endgame_phase == 2) {
                "You are standing in the workshop. Dr. Thyme is hunched over the workbench, oblivious. Your past self has their back to you, rummaging on the shelves. Neither of them knows you're here. The store room door is open to the north.";
            }
            print "The workshop is a cathedral of improbable engineering. Brass gears the size of dinner plates mesh with copper pipes that disappear into the walls. Glass jars of luminous liquids line shelves alongside what appear to be several jars of marmalade. The ceiling is lost in a tangle of tubes and wires.^^";
            if (cat_accident == false) {
                if (hired == false && thyme_departed == false) {
                    print "A man is hunched over the workbench. He glances up, sees you, and scowls. ~No salesmen! Can't you read the plate?~ He returns to his work.^^";
                    print "The workbench is cluttered with tools. The store room is to the north, the entrance is back to the west.^";
                    rtrue;
                }
                if (spanner_given == false && thyme_departed == false)
                    print "A man is hunched over the workbench with his back to you. ~The number four spanner,~ he says, without turning around. ~On the shelf behind you. The brass one. Not the steel one. The steel one is for Tuesdays.~^^";
                if (thyme_departed == false) {
                    if (spanner_given) {
                        if (hartley_journal in workbench)
                            print "Dr. Thyme's workbench is cluttered with tools and a leather-bound journal. The store room is to the north, the entrance is back to the west, and a narrow corridor runs east.^";
                        else
                            print "Dr. Thyme's workbench is cluttered with tools and biscuit crumbs. The store room is to the north, the entrance is back to the west, and a narrow corridor runs east.^";
                    } else {
                        if (hartley_journal in workbench)
                            print "The workbench is cluttered with tools and a leather-bound journal. A brass spanner glints on the shelf behind you. The store room is to the north, the entrance is back to the west, and a narrow corridor runs east.^";
                        else
                            print "The workbench is cluttered with tools and biscuit crumbs. A brass spanner glints on the shelf behind you. The store room is to the north, the entrance is back to the west, and a narrow corridor runs east.^";
                    }
                } else {
                    if (hartley_journal in workbench)
                        print "The workbench is cluttered with tools and a leather-bound journal. The store room is to the north, the entrance is back to the west, and a narrow corridor runs east.^";
                    else
                        print "The workbench is cluttered with tools and biscuit crumbs. The store room is to the north, the entrance is back to the west, and a narrow corridor runs east.^";
                }
            }
            else
                print "The workbench holds tools and the remains of Dr. Thyme's tea (cold, abandoned). The store room is north, the entrance west, and the corridor east.^";
        ],
         w_to [;
            if (endgame_knocks_heard) {
                BootstrapStart();
                rtrue;
            }
            if (endgame_phase == 2)
                "You just came from there. Your past self could turn around at any moment. The store room is north.";
            return workshop_entrance;
         ],
         n_to [;
            if (endgame_phase == 2) {
                BootstrapFinale();
                rtrue;
            }
            return store_room;
         ],
         e_to [;
            if (endgame_phase == 2)
                "Not the solarium -- you need to hide. The store room is north.";
            if (thyme_departed == false)
                "A narrow corridor leads east, ending in a heavy door. But right now Dr. Thyme seems to need your attention.";
            if (solarium_unlocked == false) {
                if (front_door_key in player) {
                    solarium_unlocked = true;
                    print "You walk down the narrow corridor. The door at the end is locked, but -- on a whim -- you try the front door key. It turns with a smooth click. A master key, perhaps. Or Dr. Thyme simply doesn't believe in having more than one key.^^";
                } else
                    "You walk down the narrow corridor. The door at the end is locked.";
            }
            return solarium;
         ],
         each_turn [;
            if (endgame_knocks_heard) {
                endgame_turns++;
                if (endgame_turns == 1)
                    print "^The knocking has stopped. Whoever is outside -- whoever YOU were -- is waiting. You should open the door before your past self leaves.^";
                if (endgame_turns >= 2) {
                    print "^You can't wait any longer. If your past self walks away, the loop breaks -- and you with it.^^";
                    BootstrapStart();
                }
            }
            if (endgame_phase == 2) {
                endgame_turns++;
                if (endgame_turns == 1)
                    print "^You're standing in the middle of the workshop. Your past self could turn around at any moment. The store room is north.^";
                if (endgame_turns >= 2) {
                    print "^You've lingered too long. You duck north before anyone turns around.^^";
                    BootstrapFinale();
                }
            }
         ],
    has light;

Object workbench "workbench" main_workshop
    with name 'workbench' 'bench' 'table' 'desk',
         description [;
            if (hartley_journal in self)
                "A sturdy oak workbench buried under an archaeological layer of tools, diagrams, and biscuit crumbs. Dr. Thyme's leather-bound journal sits prominently in the centre, as if placed there for someone -- you, presumably -- to find.";
            else
                "A sturdy oak workbench buried under an archaeological layer of tools, diagrams, and biscuit crumbs. The centre is clear save for a ring of tea stains where the journal used to sit.";
        ],
    has scenery supporter;

Object workshop_shelves "shelves" main_workshop
    with name 'shelves' 'shelf',
         description "Floor-to-ceiling shelves sagging under the weight of glass jars, brass instruments, and the accumulated optimism of a man who never throws anything away. The organisational system appears to be ~wherever it landed.~",
    has scenery pluralname;

Object workshop_gears "brass gears" main_workshop
    with name 'gears' 'gear' 'brass' 'cogs' 'cog',
         description "Brass gears the size of dinner plates, meshing together with hypnotic precision. They drive... something. Possibly the machine, possibly the ventilation, possibly Dr. Thyme's toast.",
    has scenery pluralname;

Object workshop_pipes "copper pipes" main_workshop
    with name 'pipes' 'pipe' 'copper' 'piping',
         description "Copper pipes of varying diameter disappear into the walls, floor, and ceiling with cheerful disregard for architectural convention. Some of them hum. One of them is slightly warm. Best not to ask why.",
    has scenery pluralname;

Object workshop_tools "tools" main_workshop
    with name 'tools' 'tool',
         description "An assortment of tools ranging from the recognisable (spanners, pliers) to the bewildering (what appears to be a brass protractor with teeth). Most of them are in the toolkit on the shelf in the store room.",
    has scenery pluralname;

Object workshop_ceiling "ceiling" main_workshop
    with name 'ceiling' 'roof',
         description "The ceiling -- if it's still up there -- is lost in a tangle of tubes, wires, and what might be a dirigible's steering mechanism. Something up there occasionally drips. You've decided not to investigate.",
    has scenery;

Object workshop_tubes "tubes" main_workshop
    with name 'tubes' 'tube' 'glass',
         description "Glass tubes of various sizes snake across the ceiling, some filled with luminous liquids of uncertain provenance. They pulse gently, like the circulatory system of something that really ought not to have a circulatory system.",
    has scenery pluralname;

Object workshop_wires "wires" main_workshop
    with name 'wires' 'wire' 'wiring',
         description "A cat's cradle of copper wiring connects everything to everything else. The insulation is mostly intact. Mostly.",
    has scenery pluralname;

Object workshop_clock "clock" main_workshop
    with name 'clock' 'wall' 'clock',
         description "A large brass clock mounted on the wall, its face crowded with more hands than any reasonable timepiece should possess. At least three of them appear to be moving backwards. A small plaque beneath reads: ~Adjusted for Temporal Drift -- J.T.~",
    has scenery;

Object brass_spanner "brass spanner" main_workshop
    with name 'spanner' 'brass' 'number' 'four' 'wrench',
         description "A well-worn brass spanner, number four. It has the comfortable weight of a tool that has been used ten thousand times for purposes its manufacturer never imagined.";

Object workshop_marmalade "marmalade jars" main_workshop
    with name 'marmalade' 'jam' 'preserv',
         description "Several jars of Seville orange marmalade, interspersed among the scientific apparatus with no apparent logic. Each one bears a handwritten label: ~JT -- BATCH 7,~ ~JT -- BATCH 12 (EXPERIMENTAL),~ and most worryingly, ~JT -- BATCH 3 (DO NOT EAT -- TEMPORAL).~",
         before [;
            Eat, Taste:
                "You eye the jar labelled ~BATCH 3 (DO NOT EAT -- TEMPORAL)~ and decide that Dr. Thyme's warnings are probably worth heeding. The last person who ignored one of his labels reportedly aged thirty years in an afternoon.";
            Open:
                "The lids are sealed tight with what appears to be a combination of wax and optimism. A note stuck to Batch 3 reads: ~IF THIS JAR OPENS ITSELF, LEAVE THE BUILDING.~";
            Take:
                "Best to leave Dr. Thyme's marmalade where it is. The jars are part of the workshop's delicate ecosystem -- or possibly its temporal shielding. Either way, moving them seems unwise.";
            Smell:
                "You lean in cautiously. Batches 7 and 12 smell of perfectly ordinary Seville oranges. Batch 3, however, smells faintly of next Wednesday.";
         ],
    has scenery pluralname;

Object workshop_liquids "luminous liquids" main_workshop
    with name 'liquid' 'liquids' 'luminous' 'jars' 'jar',
         description "Glass jars filled with liquids that glow in colours not found in any paint catalogue. They pulse gently, casting faint rainbows on the wall. Dr. Thyme has labelled them all, but the labels say things like ~ESSENCE OF NEXT THURSDAY~ and ~LIQUID NOSTALGIA (STALE).~",
    has scenery pluralname;

Object workshop_diagrams "diagrams" main_workshop
    with name 'diagram' 'diagrams' 'plans' 'blueprint' 'blueprints',
         description "Technical diagrams covered in Dr. Thyme's increasingly desperate handwriting. They appear to show the inner workings of the time machine, annotated with helpful notes such as ~DO NOT REVERSE POLARITY~ and ~THIS BIT EXPLODES (SOMETIMES).~",
    has scenery pluralname;

Object workshop_instruments "instruments" main_workshop
    with name 'instrument' 'instruments',
         description "An assortment of brass instruments whose purposes range from the vaguely scientific to the entirely imaginary. One appears to measure the emotional state of copper. Another has a dial labelled ~YESTERDAY -- TODAY -- TOMORROW -- HELP.~",
    has scenery pluralname;

Object workshop_scorch "scorch mark" main_workshop
    with name 'scorch' 'mark' 'marks' 'burn' 'stain',
         description "A suspicious scorch mark on the ceiling, roughly the shape of a small explosion. Dr. Thyme has written next to it in chalk: ~TUESDAY'S INCIDENT. DO NOT DISCUSS.~",
    has scenery;

Object corridor_door "corridor door"
    with name 'corridor' 'door',
         found_in main_workshop solarium,
         description [;
            if (solarium_unlocked)
                "The door at the end of the narrow corridor stands open. Beyond it, grey light spills from the solarium.";
            "A heavy door at the end of a narrow corridor running east from the workshop. Dr. Thyme was quite emphatic that you shouldn't go through it.";
         ],
         before [;
            Open, Push, Pull:
                if (endgame_knocks_heard && location == main_workshop) {
                    "The knocking is coming from the front door, to the west. Not the corridor.";
                }
                if (endgame_phase == 2 && location == main_workshop) {
                    "Not the solarium -- you need to hide. The store room is north.";
                }
                if (action == ##Open) {
                    if (solarium_unlocked)
                        "The door is already open.";
                    if (front_door_key in player) {
                        solarium_unlocked = true;
                        "You try the front door key in the lock. It shouldn't work -- it's for the front door -- but it turns with a smooth click. A master key, perhaps. Or Dr. Thyme simply doesn't believe in having more than one key. The door swings open, revealing a glass-roofed room beyond.";
                    }
                    "The door is locked. You'd need a key.";
                }
                if (solarium_unlocked)
                    "The door is already open. The solarium is to the east.";
                "The door doesn't budge. It's locked.";
            Unlock:
                if (solarium_unlocked)
                    "The door is already unlocked.";
                if (front_door_key in player) {
                    solarium_unlocked = true;
                    "You try the front door key in the lock. It shouldn't work -- it's for the front door -- but it turns with a smooth click. A master key, perhaps. Or Dr. Thyme simply doesn't believe in having more than one key. The door swings open, revealing a glass-roofed room beyond.";
                }
                "You don't have a key that fits this lock.";
            Lock, Close:
                "You've come this far. No point locking it now.";
         ],
    has scenery;

Object front_door_key "front door key"
    with name 'key' 'front' 'door' 'brass',
         description "A heavy brass key, warm from Dr. Thyme's waistcoat pocket. It opens the front door of 14 Praed Street. Presumably.";

! ===================================================================
! THE SOLARIUM — forbidden room, houses the time machine
! ===================================================================

Object solarium "The Solarium"
    with description [;
            if (solarium_entered == false) {
                solarium_entered = true;
                score = score + 3;
                if (copernicus notin solarium) {
                    move copernicus to solarium;
                    move cat_name_tag to solarium;
                }
                print "The solarium is drenched in grey London light filtering through a glass ceiling streaked with rain and pigeon evidence. Potted ferns and brass instruments crowd the perimeter. And in the centre --^^";
                print "Something extraordinary.^^";
                print "A contraption of brass, crystal, and what might be a repurposed church organ, occupying most of the floor space. Dials, levers, and components you have no name for. A heavy cable runs from a charging station on the wall to the machine's undercarriage, where a lead-acid accumulator sits in an iron cradle. The whole room hums with barely contained energy, as if the air itself is vibrating at a frequency just below hearing.^^";
                if (rag_on_machine) {
                    if (copernicus_named)
                        print "And there, perched atop the controls like a furry emperor surveying his domain, is Copernicus. Your cleaning rag dangles from his mouth like a battle standard.^^";
                    else
                        print "And there, perched atop the controls like a furry emperor surveying his domain, is the cat. Your cleaning rag dangles from his mouth like a battle standard.^^";
                    print "So this is what Dr. Thyme didn't want you to see. You understand the concern. You also understand that getting your rag back is going to require getting the cat off this machine. This seems... inadvisable.^";
                } else {
                    if (copernicus_named)
                        print "Copernicus is already here, naturally. The concept of a forbidden room is entirely beneath him.^";
                    else
                        print "The silver-grey cat is already here, naturally. Forbidden rooms hold no meaning for cats.^";
                }
            } else {
                if (cat_accident == false) {
                    print "The solarium is drenched in grey London light filtering through the glass ceiling. Potted ferns and brass instruments crowd the perimeter. The contraption -- the time machine, you suppose -- dominates the centre of the room, humming with barely contained energy.^^";
                    if (rag_on_machine) {
                        if (copernicus_named)
                            print "Copernicus is perched atop the contraption, your cleaning rag dangling from his mouth like a trophy.^^";
                        else
                            print "The silver-grey cat is perched atop the contraption, your cleaning rag dangling from his mouth like a trophy.^^";
                    }
                    print "The corridor leads back west to the workshop.^";
                } else {
                    print "The solarium. Grey light filters through the rain-streaked glass ceiling. ";
                    if (time_machine in self) {
                        print "The time machine dominates the room";
                        if (components_installed)
                            print ", humming with renewed purpose. All four components are installed and the machine sings with quiet confidence.^^";
                        else {
                            print ", looking worse for wear since the cat's intervention.";
                            if (lodestone_installed || tube_installed || formula_transcribed || processor_installed) {
                                print " Though some repairs have been made --";
                                if (lodestone_installed) print " the new lodestone glows steady";
                                if (tube_installed) print ", the replacement tube hums";
                                if (formula_transcribed) print ", the formula is transcribed";
                                if (processor_installed) print ", the new processor gleams";
                                print ".";
                            }
                            print "^^";
                        }
                    } else {
                        print "Potted ferns and brass instruments crowd the perimeter. The space where the time machine stood is conspicuously empty, marked by scuff marks on the tiled floor.^^";
                    }
                    print "The corridor leads back west to the workshop.^";
                }
            }
        ],
         w_to main_workshop,
    has light;

Object solarium_ferns "potted ferns" solarium
    with name 'fern' 'ferns' 'potted' 'plants' 'plant' 'aspidistra' 'aspidistras' 'maidenhair',
         description "A collection of aspidistras and maidenhair ferns in brass pots, thriving in the humid glass-roofed space. They sway occasionally in drafts that have no obvious source.",
    has scenery pluralname;

Object solarium_ceiling "glass ceiling" solarium
    with name 'ceiling' 'glass' 'roof' 'skylight',
         description "A vaulted glass ceiling, streaked with rain and the unmistakable evidence of London's pigeon population. Grey light filters through, giving the room an underwater quality. One pane near the base has been replaced with a small hinged flap -- a cat-sized entrance.",
    has scenery;

Object cat_flap "cat flap" solarium
    with name 'cat' 'flap' 'catflap',
         description "A small hinged flap fitted into one of the lower glass panes -- just large enough for a determined cat. It swings freely in both directions. Dr. Thyme clearly learned long ago that the concept of a locked door means nothing to a cat with opinions.",
    has scenery;

Object solarium_instruments "brass instruments" solarium
    with name 'instrument' 'instruments' 'brass' 'device' 'devices',
         description "An assortment of brass measuring instruments crowd the perimeter -- barometers, hygrometers, and several devices whose purpose you couldn't begin to guess. One of them appears to be measuring something that doesn't exist yet.",
    has scenery pluralname;

Object battery_bank "charging station" solarium
    with name 'charging' 'station' 'charger' 'bank' 'cells' 'cable' 'cables' 'mains' 'supply',
         description "A heavy transformer and rectifier assembly bolted to the wall, fed by a cable that disappears through a hole in the brickwork. From here, thick copper leads run to the machine's on-board accumulator. A framed invoice tacked above it reads: ~VESTRY OF ST. PANCRAS -- ELECTRICAL SUPPLY -- ACCT. NO. 0047 -- QUARTERLY CONSUMPTION: EXCESSIVE.~ Someone has scrawled beneath it in pencil: ~Still cheaper than coal.~",
         before [;
            Touch:
                "The transformer hums under your hand. The cable coming through the wall is warm.";
            Take:
                "The charging station is bolted to the wall and wired into the mains. It's not going anywhere, and neither is the building's electricity supply.";
         ],
    has scenery;

Object solarium_controls "controls" solarium
    with name 'controls' 'control' 'levers' 'lever' 'bell' 'bicycle' 'compass' 'dial' 'panel',
         description "The time machine's controls are a bewildering array of levers, dials, and one very incongruous bicycle bell. A compass-like dial dominates the centre, its needle trembling between destinations. The whole arrangement suggests Dr. Thyme designed it while simultaneously reading three instruction manuals and a cookbook.",
    has scenery pluralname;

Object time_machine "time machine" solarium
    with name 'machine' 'time' 'device' 'contraption' 'engine' 'temporal' 'crystal' 'crystals' 'resonator' 'resonators',
         description [;
            if (cat_accident == false) {
                print "A magnificent contraption of brass, crystal, and what might be a repurposed church organ. Brass housings encase crystal resonators connected by a bewildering maze of copper tubing. A set of controls features several levers, a compass-like dial, and what appears to be a bicycle bell. A battered wicker basket is bolted to one side, its cushion matted with silver fur. Underneath, a heavy lead-acid accumulator sits in an iron cradle -- the machine's own portable power supply. The whole thing hums with barely contained energy.^^";
                if (rag_on_machine) {
                    if (copernicus_named)
                        print "Copernicus is perched on the control panel with your cleaning rag, looking tremendously pleased with himself.^";
                    else
                        print "The silver-grey cat is perched on the control panel with your cleaning rag, looking tremendously pleased with himself.^";
                } else {
                    if (copernicus_named)
                        print "Copernicus is sitting near the control panel, because of course he is.^";
                    else
                        print "The silver-grey cat is sitting near the control panel, because of course he is.^";
                }
            } else if (components_installed) {
                print "The time machine gleams with renewed purpose. All four components are installed and the machine hums with a steady, confident rhythm. The temporal field generator glows a satisfying blue.^";
            } else {
                print "The time machine looks decidedly worse for wear since Copernicus's intervention.";
                ! Progressive damage + installed status
                ! Lodestone status (always known)
                if (lodestone_installed)
                    print " The new lodestone glows steady in the compass housing.";
                else
                    print " The compass housing glows faintly -- the lodestone is fading.";
                ! Crookes tube (after Blitz transit)
                if (visited_blitz) {
                    if (tube_installed)
                        print " The military vacuum tube hums in the oscillation circuit.";
                    else
                        print " The Crookes tube is webbed with fractures.";
                }
                ! Formula (after Cambridge)
                if (visited_hawking) {
                    if (formula_transcribed)
                        print " Hawking's formula is transcribed into the calibration matrix -- the machine can aim.";
                    else
                        print " Navigation is imprecise -- you need a formula for the temporal harmonics.";
                }
                ! Crystal (after Future)
                if (visited_future) {
                    if (processor_installed)
                        print " The crystalline processor sits in its brass harness, glowing steadily.";
                    else
                        print " A crack runs clean through the crystalline processor.";
                }
                print "^^";
                if (location == roman_forum && marcus_impressed == false)
                    print "Roman soldiers have formed a nervous perimeter around the machine. Their centurion eyes it with deep suspicion.^^";
                if (location == blitz_street && machine_dug_out == false)
                    print "The machine is half-buried under bomb rubble. You'll need help shifting it.^^";
                if (location == cambridge_gates)
                    print "The machine seems stable here. The transition was smoother than the last.^^";
                if (location == future_street && has_diving_gear == false)
                    print "The machine is mostly underwater. You'd need diving gear to reach the controls.^^";
                else if (location == future_street && machine_raised == false)
                    print "With your diving gear, you could haul the machine up from the water.^^";
                if (location == future_street && has_diving_gear == false) {
                    ! dial underwater — already described above, skip destination list
                } else {
                    print "The destination dial still works. You could travel to:^";
                    if (visited_roman) print "  Roman Londinium (60 AD)^";
                    if (visited_blitz || visited_roman) print "  Blitz London (1941)^";
                    if (visited_hawking || visited_blitz) print "  Cambridge (2009)^";
                    if (visited_future || visited_hawking) print "  Future London (2045)^";
                    print "  Workshop (1895)^";
                }
            }
         ],
         before [;
            Receive:
                if (noun == lodestone && lodestone_installed)
                    "The lodestone is already installed in the compass housing. It glows with a steady, purposeful light.";
                if (noun == vacuum_tube && tube_installed)
                    "The vacuum tube is already fitted into the oscillation circuit, humming away contentedly.";
                if (noun == formula_printout && formula_transcribed)
                    "Hawking's formula is already transcribed into the calibration matrix.";
                if (noun == quantum_processor && processor_installed)
                    "The crystalline processor is already seated in its brass harness.";
                "The time machine's innards are far too delicate for casual insertion. Try REPAIR MACHINE or FIX MACHINE to install components properly.";
            Enter, Go, Climb:
                if (cat_accident == false)
                    "You place your hands on the brass housing. It hums under your fingers, warm despite the cold air, vibrating at a frequency you feel in your teeth. But there's no hatch, no compartment, no seat. This isn't something you climb into -- it takes everything nearby along for the ride. To travel through time, try TRAVEL TO followed by a destination.";
                "You step close and feel the temporal field prickle against your skin -- that familiar charge pressing in like static before a storm. The field extends several feet in every direction; there's no cockpit to climb into. To travel through time, try TRAVEL TO followed by a destination.";
         ],
         add_to_scope roman_dest blitz_dest hawking_dest future_dest solarium_dest crookes_tube_scenery cat_basket machine_battery,
    has scenery;

Object crookes_tube_scenery "Crookes tube" time_machine
    with name 'crookes' 'tube',
         description [;
            if (tube_installed)
                "The original Crookes tube has been replaced by a military-grade vacuum tube, mass-produced to tolerances no Victorian glassblower could match. It hums contentedly in the oscillation circuit.";
            if (visited_blitz)
                "The Crookes tube is webbed with fractures, fine cracks radiating through the evacuated glass like ice on a winter puddle. Cathode rays still flicker weakly inside, but the temporal oscillation field is failing. You need a replacement.";
            "A hand-blown glass envelope, evacuated and sealed with meticulous care. Inside, cathode rays dance at controlled intervals, generating the temporal oscillation field. Dr. Thyme's journal mentions blowing seven of these before getting one that worked. This is the seventh.";
         ],
    has scenery;

Object machine_battery "lead-acid accumulator"
    with name 'accumulator' 'battery' 'lead' 'acid' 'portable' 'cradle' 'iron',
         description "A compact lead-acid accumulator in an iron cradle bolted to the machine's undercarriage. Six glass-cased cells connected in series, each one sloshing faintly with sulphuric acid. Thick copper terminals connect it to the temporal field generator above. A brass plate on the cradle reads: ~ELECTROBAT TYPE -- 6 CELL -- CHARGED FROM MAINS.~",
         found_in [; return (time_machine in location); ],
         before [;
            Take:
                "The accumulator is bolted into its cradle and wired directly into the machine. Removing it would strand you in time -- which, now that you think about it, you already are.";
            Touch:
                "Warm. Faintly vibrating. The acid inside sloshes as if aware of your attention.";
         ],
    has scenery;

Object cat_basket "wicker basket"
    with name 'basket' 'wicker',
         description "A battered wicker basket is bolted to the side of the machine, just large enough for a well-fed cat. The cushion inside is matted with silver fur and the wicker is shredded in places by determined claws. A luggage tag is tied to the handle.",
         found_in [; return (time_machine in location); ],
         before [;
            Take:
                "It's bolted firmly to the machine's housing. Dr. Thyme clearly anticipated attempts at removal -- possibly by the test subject.";
         ],
    has scenery;

Object basket_tag "luggage tag"
    with name 'tag' 'luggage' 'label',
         description "The tag reads, in Dr. Thyme's careful copperplate: ~TEST SUBJECT C. -- 14 successful temporal transits (10-minute hops). 0 complaints (lacks capacity for complaint). Preferred transit snack: sardines. Note: Subject C. has developed a tendency to arrive before departure. This is theoretically impossible but I have stopped worrying about it.~",
         found_in [; return (time_machine in location); ],
    has scenery;

Object hartley_journal "leather-bound journal" workbench
    with name 'journal' 'book' 'leather' 'diary' 'notes',
         description [;
            print "Dr. Thyme's handwriting starts elegant and deteriorates through the pages into what might be either advanced mathematics or the ravings of a lunatic. Certain entries are dated with alarming notation such as ~TUESDAY (THE FIRST ONE)~ and ~SOME TIME AFTER WEDNESDAY BUT POSSIBLY BEFORE.~ Key excerpts:^^";
            print "~TEMPORAL COMPASS -- The compass core requires a lodestone of exceptional purity. Naturally magnetic iron ore, the stronger the better. I have tested fourteen specimens from various suppliers; thirteen were inadequate and the fourteenth pulled every nail out of the floorboards. Lodestones of sufficient quality are exceedingly rare. The finest magnetite deposits are quarried in the Mediterranean basin. My current stone has weakened noticeably after only seventeen test activations and will need replacing sooner than expected.~^^";
            print "~OSCILLATION CIRCUIT -- The circuit employs a modified Crookes tube: an evacuated glass envelope through which cathode rays pass at controlled intervals, generating the temporal oscillation field. I have hand-blown seven; four shattered during calibration, two proved insufficiently evacuated, and the seventh serves adequately though its tolerances are marginal. The precision required exceeds what any single craftsman can reliably achieve. A manufacturing process capable of producing tubes to exact specification would solve this, but no such process exists.~^^";
            print "~NAVIGATION -- REMAINS THE CENTRAL PROBLEM. The machine moves through time but landings are imprecise. I set coordinates for March and arrive in November, aim for London and materialise in Croydon (arguably worse). Precise navigation requires a mathematical framework for describing the geometry of time itself. The temporal harmonics governing exact positioning are beyond anything I can derive. The mathematics simply do not exist yet.~^^";
            print "~FIELD GENERATOR -- Requires continuous recalculation of seventeen simultaneous differential equations, each dependent on the others. I have attempted these by hand. It takes eleven weeks per set of coordinates and the error margin remains unacceptable. Mr. Babbage's engine falls short by several orders of magnitude. ADDENDUM: A parcel arrived this morning. No return address. Postmark illegible. Inside, packed in straw, a crystalline component fitted into a brass harness with copper solder tabs -- as if someone had built an adapter specifically for my machine. A note reading: FOR THE FIELD GENERATOR. YOU WILL UNDERSTAND IN TIME. The harness fitted the generator housing perfectly. I soldered the tabs to the existing bus and ran a test. IT WORKS. Seventeen equations, resolved instantaneously. I have written to the General Post Office requesting sender information. They have not replied.~^^";
            print "~POWER SUPPLY -- The temporal field demands enormous current. Gas engines vibrate too much and steam is out of the question in a glass-roofed room. After reading of Morris and Salom's Electrobat carriage in Philadelphia -- they have built an entire vehicle powered by lead-acid accumulators! -- I have adapted the principle for the machine's on-board power. A six-cell accumulator in an iron cradle provides portable current for transit. The cells are charged from the mains via a transformer in the solarium. I have arranged an electrical supply from the Vestry of St. Pancras, whose generating station on Stanhope Street is the only one in London with sufficient capacity. The cable run from their grid to Praed Street required some creative routing through the Metropolitan Railway tunnels, for which I paid the foreman in marmalade. The quarterly bill is eye-watering.~^^";
            if (copernicus_named)
                print "The margins are full of cat doodles, tea stains, and the note: ~KEEP COPERNICUS AWAY FROM THE CONTROLS.~ This is underlined seventeen times. A later addendum reads: ~I MEAN IT. I LOST AN ENTIRE TUESDAY. NOTE TO SELF -- when hiding from yourself in the pantry, bring a sandwich.~^";
            else
                print "The margins are full of cat doodles, tea stains, and the note: ~KEEP THE CAT AWAY FROM THE CONTROLS.~ This is underlined seventeen times. A later addendum reads: ~I MEAN IT. I LOST AN ENTIRE TUESDAY. NOTE TO SELF -- when hiding from yourself in the pantry, bring a sandwich.~^";
        ],
         initial "A leather-bound journal sits prominently on the workbench.";

Object store_room "Store Room"
    with description [;
            print "A narrow room lined floor to ceiling with shelves of curiosities. Specimen jars containing things best not examined too closely jostle for space with boxes of gears, coils of copper wire, and several items that defy description in any known language.";
            if (toolkit in store_room)
                print " A toolkit sits on the nearest shelf.";
            if (store_room_entered == false) {
                store_room_entered = true;
                print "^^There's a curious warmth to the air, as if the room hasn't quite finished being occupied.";
            }
            print "^^The workshop is back to the south.";
        ],
         s_to main_workshop,
    has light;

Object toolkit "toolkit" store_room
    with name 'toolkit' 'tools' 'kit' 'toolbox',
         description "A battered leather toolkit containing an improbable number of implements: screwdrivers of seventeen sizes, a small chisel, needle-nose pliers, a magnifying glass, and something that might be a sonic spanner. Everything a Victorian temporal engineer's apprentice could need.",
         initial "A well-worn toolkit sits on the nearest shelf.";

Object specimen_jars "specimen jars" store_room
    with name 'jars' 'jar' 'specimen' 'bottles' 'bottle',
         description "The jars contain... things. One appears to hold a butterfly frozen in mid-flight. Another contains what looks like yesterday's weather. A third is labelled ~TUESDAY -- DO NOT OPEN UNTIL MONDAY.~ Best not to think about it.",
    has scenery pluralname;

Object store_shelves "shelves" store_room
    with name 'shelves' 'shelf',
         description "Sturdy wooden shelves, bowing under the weight of Dr. Thyme's hoarding instincts. Every inch is occupied by jars, boxes, coils, and objects that defy categorisation in any language, living or dead.",
    has scenery pluralname;

Object store_copper_wire "copper wire" store_room
    with name 'copper' 'wire' 'coil' 'coils',
         description "Coils of copper wire in various gauges, neatly wound and labelled in Dr. Thyme's increasingly erratic handwriting. One label simply reads ~WIRE (IMPORTANT).~",
    has scenery;

Object store_crates "crates" store_room
    with name 'crate' 'crates' 'label' 'labels',
         description "Wooden crates stacked haphazardly, each bearing handwritten labels in Dr. Thyme's erratic script. The labels include ~TEMPORAL BITS (MISC.)~, ~SPRINGS (PROBABLY)~, and the slightly alarming ~CONTENTS UNKNOWN -- DO NOT OPEN ON WEDNESDAYS.~",
    has scenery pluralname;

Object store_supplies "supplies" store_room
    with name 'supplies' 'boxes' 'items' 'curiosit',
         description "Boxes of gears, springs, lenses, and components whose purpose you can only guess at. If Dr. Thyme ever needs to build a second time machine, he's got the parts. And probably a third.",
    has scenery pluralname;

! ===================================================================
! DR. THYME (NPC -- leaves quickly)
! ===================================================================

Object dr_thyme "Dr. Thyme" main_workshop
    with name 'thyme' 'justin' 'doctor' 'dr' 'man',
         description [;
            if (cat_accident || thyme_departed)
                "Dr. Thyme is out getting tea and scones. His timing, as always, was impeccable.";
            if (hired == false)
                "A man is hunched over the workbench, his back to you. Dark hair, slightly unkempt, shot through with a single streak of grey at the temple. He wears a waistcoat over rolled shirtsleeves, both dusted with copper filings. He glances up, scowls, and returns to his work.";
            if (spanner_given == false)
                "A man is hunched over the workbench, his back to you. Dark hair, slightly unkempt, shot through with a single streak of grey at the temple. He wears a waistcoat over rolled shirtsleeves, both dusted with copper filings. He hasn't acknowledged your existence yet.";
            "Dr. Thyme peers at you over an imaginary pair of spectacles -- he doesn't actually wear them, but his face seems designed for it. Dark eyes set deep beneath heavy brows, skin the warm brown of old tea, and an expression that suggests he has just remembered you exist and is moderately pleased about it.";
         ],
         daemon [;
            if (thyme_departed) { StopDaemon(self); rtrue; }
            if (turns >= spanner_turn + 5) {
                if (location == main_workshop)
                    ThymeDeparts();
                else {
                    print "^From the workshop, you hear a sudden commotion -- coat hooks rattling, a yelp about scones, and the front door slamming shut with Victorian finality.^";
                    thyme_departed = true;
                    door_open = false;
                    move cleaning_rag to main_workshop;
                    move front_door_key to main_workshop;
                    move thyme_note to main_workshop;
                    remove dr_thyme;
                }
            }
         ],
         life [;
            Ask:
                if (hired == false) {
                    "The man doesn't look up. ~No salesmen. Can't you read the plate?~";
                }
                NPC_Ask_Thyme(second);
                rtrue;
            Tell:
                if (hired == false) {
                    "The man ignores you with the practiced indifference of someone who has perfected the art of not noticing unwelcome visitors.";
                }
                "Dr. Thyme nods enthusiastically while clearly thinking about something else entirely.";
            Show:
                if (noun == newspaper && hired == false) {
                    if (ad_circled == false) {
                        "He glances at the paper. ~There are forty-seven adverts in this paper. Which one, precisely, brought you to a temporal engineering workshop at three in the afternoon?~";
                    }
                    hired = true;
                    score = score + 3;
                    print "He squints at the circled advert, then at you, then back at the advert.^^";
                    print "~Ah! The temporal engineering position. Splendid.~ He turns properly for the first time. ~I'm Dr. Thyme. You'll call me Doctor, or sir, or 'that madman with the spanner,' whichever comes most naturally.~^^";
                    print "He gestures at the shelves behind you. ~Now -- the number four spanner, if you please. Brass. Not steel. The steel one is for Tuesdays.~^";
                    rtrue;
                }
                "Dr. Thyme peers at it politely and hands it back. ~Fascinating. Now, where was I?~";
            Give:
                if (noun == brass_spanner && spanner_given == false) {
                    if (hired == false) {
                        "The man doesn't look up. ~No salesmen. Can't you read the plate?~";
                    }
                    spanner_given = true;
                    spanner_turn = turns;
                    StartDaemon(dr_thyme);
                    score = score + 3;
                    remove brass_spanner;
                    print "He takes the spanner without looking, makes a minute adjustment to whatever he's working on, and finally turns.^^";
                    print "~Good. You can follow instructions. That puts you ahead of the last three applicants.~ He peers at you as if reading very small print.^";
                    rtrue;
                }
                if (hired == false) {
                    "The man doesn't look up. ~No salesmen. Can't you read the plate?~";
                }
                "~How kind! But I really must dash. Mrs. Pemberton waits for no man.~";
         ],
    has animate proper male;

! ===================================================================
! ROMAN LONDINIUM — 60 AD
! ===================================================================

Object roman_forum "The Forum"
    with description [;
            print "The heart of Roman Londinium spreads before you in the warm Mediterranean sunlight that has no business being in London. Toga-clad citizens bustle between colonnaded buildings, haggling, gossiping, and doing whatever it is Romans do at the Forum (politics, mostly, with occasional stabbings).^^";
            if (time_machine in self && marcus_impressed == false)
                print "The time machine sits beside a marble column, surrounded by wary Roman soldiers who are prodding it with their swords and debating whether it's Greek.^^";
            else if (time_machine in self)
                print "The time machine sits beside a marble column, gleaming incongruously in the Mediterranean sun.^^";
            print "The Via Principalis leads north";
            if (marcus_impressed == false)
                print " (a centurion blocks the way)";
            print ". The Temple of Mithras is to the east";
            if (livia_trusts == false)
                print " (a priestess guards the entrance)";
            print ". The Bathhouse lies west, and the Merchant's Quarter south.^";
        ],
         n_to [;
            if (marcus_impressed) return roman_via;
            print "The centurion blocks your path with his shield. ~Roman citizens and military only. You are clearly neither.~^";
            rfalse;
         ],
         e_to [;
            if (livia_trusts) return roman_temple;
            print "Priestess Livia bars the entrance. ~Only the initiated may enter the Temple of Mithras.~^";
            rfalse;
         ],
         w_to roman_bath,
         s_to roman_merchants,
    has light;

Object forum_column "marble column" roman_forum
    with name 'column' 'marble' 'pillar' 'columns' 'pillars',
         description "A fine Corinthian column of imported Italian marble, fluted and gleaming in the improbable London sunshine. It supports nothing in particular but does so with tremendous authority.",
    has scenery;

Object forum_citizens "citizens"
    with name 'citizen' 'citizens' 'people' 'crowd',
         description "Toga-clad citizens bustle about their daily business -- haggling, gossiping, and occasionally stabbing each other, as was the Roman custom. They eye your strange clothing with the polite bewilderment of people who have seen stranger things come up the Thames.",
         found_in roman_forum roman_via roman_temple roman_bath roman_merchants roman_docks,
    has scenery animate pluralname;

Object forum_buildings "colonnaded buildings" roman_forum
    with name 'building' 'buildings' 'colonnade',
         description "Grand colonnaded buildings line the Forum, housing everything from the law courts to the tax office. The Romans brought many gifts to Britain: roads, aqueducts, and bureaucracy. Especially bureaucracy.",
    has scenery pluralname;

Object forum_place "forum" roman_forum
    with name 'forum' 'square' 'piazza',
         description "The Forum of Londinium -- the civic heart of Roman Britain. An open square surrounded by grand buildings, it serves as marketplace, law court, and social hub. The Romans brought bureaucracy to Britain, and this is where they filed it.",
    has scenery;

Object forum_toga "togas" roman_forum
    with name 'toga' 'togas' 'robe' 'robes' 'clothes' 'clothing',
         description "The togas are uniformly white, which in a city without washing machines is either impressive or deeply suspicious. Several citizens wear the purple-bordered toga praetexta, marking them as persons of importance, or at least persons with access to expensive dye.",
    has scenery pluralname;

Object roman_via "Via Principalis"
    with description [;
            print "A wide, meticulously paved road stretches north towards the military barracks. Roman soldiers drill with mechanical precision, their armour catching the sunlight. The discipline is impressive, the smell less so.^^";
            print "To the north, beyond the barracks, you can see smoke rising on the horizon. Distant figures move in ways that suggest they are not Roman and are not happy about it.^^";
            print "The Forum lies back to the south.^";
        ],
         s_to roman_forum,
    has light;

Object via_soldiers "Roman soldiers" roman_via
    with name 'soldiers' 'soldier' 'troops' 'legionary' 'legionaries',
         description "Roman soldiers drill with the mechanical precision of men who have been told exactly where to stand and are deeply committed to standing there. Their armour gleams, their formations are flawless, and their morale is... well, they've heard the rumours about Boudica.",
    has scenery animate pluralname;

Object via_barracks "military barracks" roman_via
    with name 'barracks' 'road' 'armour' 'armor' 'paving' 'pavement' 'street',
         description "The Via Principalis is paved with meticulous Roman stonework, each block fitted with engineering precision. The military barracks line the road, squat timber buildings radiating discipline and the faint smell of legionary cooking, which is to say, porridge.",
    has scenery pluralname;

Object via_horizon "horizon" roman_via
    with name 'horizon' 'distance' 'north',
         description "On the northern horizon, columns of smoke rise ominously. Distant figures move in ways that suggest organised anger. History knows what's coming. The Romans, characteristically, are pretending everything is fine.",
    has scenery;

Object boudica_npc "distant army" roman_via
    with name 'army' 'boudica' 'boudicca' 'iceni' 'warrior' 'figures' 'smoke',
         description "On the northern horizon, Boudica's Iceni army masses like a gathering storm. History remembers what happens next, but this particular Tuesday in 60 AD doesn't know it yet. The army is magnificent and terrifying in roughly equal measure.",
         before [;
            Take: "That's an entire army. And a very angry one at that. Let's admire it from a safe distance.";
         ],
    has scenery pluralname;

Object roman_temple "Temple of Mithras"
    with description [;
            print "You descend into the underground sanctuary. Torchlight flickers across carved reliefs of Mithras slaying the cosmic bull -- an impressive feat rendered somewhat less impressive by the fact that the bull has been given a rather startled expression by the sculptor.^^";
            print "The stone walls are ancient and covered in inscriptions from generations of worshippers.^^";
            print "The Forum is back to the west.^";
        ],
         w_to roman_forum,
    has light;

Object temple_wall "stone wall" roman_temple
    with name 'wall' 'walls' 'stone' 'inscription',
         description [;
            if (inscription_carved) {
                print "Among the ancient inscriptions, your freshly carved message stands out: ~TEMPUS FUGIT -- THE TEMPORAL APPRENTICE WAS HERE, ";
                print "60 AD.~ It's not exactly profound, but it should last a few centuries.^";
            } else {
                print "The walls bear inscriptions from centuries of worshippers. There's space for one more. If only you had a tool sharp enough to carve stone...^";
            }
         ],
    has scenery;

Object temple_torches "torches" roman_temple
    with name 'torch' 'torches' 'torchlig' 'flame' 'flames' 'light',
         description "Flickering torches mounted in iron brackets cast dancing shadows across the carved walls. The torchlight gives everything a suitably mysterious atmosphere, which is rather the point in a mystery cult.",
    has scenery pluralname;

Object temple_altar "altar" roman_temple
    with name 'altar',
         description "A stone altar at the far end of the sanctuary, blackened with centuries of offerings. Small clay figurines and coins are arranged before it with the careful precision of people who take their gods very seriously indeed.",
    has scenery;

Object mithras_relief "carved relief" roman_temple
    with name 'relief' 'reliefs' 'mithras' 'bull' 'carving' 'carvings' 'sculpture',
         description "Mithras is depicted in the heroic act of slaying the cosmic bull. The bull's expression suggests it was having a perfectly nice day up until that point.",
    has scenery;

Object roman_bath "Roman Bathhouse"
    with description [;
            print "Steam billows from heated pools where Romans lounge in varying states of undress and philosophical debate. The acoustics are extraordinary -- you can hear every argument about politics, olive oil, and whether Gaul is really worth the bother.^^";
            print "A drain grate in the corner occasionally rattles. Something is moving down there.^^";
            print "The Forum is back to the east.^";
        ],
         e_to roman_forum,
    has light;

Object bath_drain "drain grate" roman_bath
    with name 'drain' 'grate' 'grating',
         description [;
            if (self hasnt general) {
                "The drain grate is a heavy iron affair, slightly askew. Something glints in the shadows beneath it. You can hear tiny scrabbling sounds -- rats, probably.";
            }
            "The drain grate sits slightly askew. The rats seem to have cleared off.";
         ],
         before [;
            Open, Pull, Push:
                "The grate is far too heavy to budge.";
            Search, LookUnder:
                if (self hasnt general)
                    "You peer through the bars. Something glints in the darkness below, but your fingers won't fit through the gaps.";
                "The drain is empty now, save for some disgruntled rats.";
            Receive:
                "The grate has no interest in your offerings.";
         ],
    has scenery;

Object gold_aureus "gold aureus"
    with name 'gold' 'aureus' 'coin' 'money',
         description "A gold aureus bearing the profile of Emperor Nero. He looks smug, which, to be fair, was his default expression. The coin is in excellent condition, possibly because it's only about two years old.",
         initial "A gold aureus gleams on the wet tiles where Copernicus batted it.",
         before [;
             Take:
                 if (parent(self) ~= roman_bath) {
                     "You can't see any such thing.";
                 }
         ];

Object roman_merchants "Merchant's Quarter"
    with description [;
            print "A bustling marketplace of stalls and shops squeezed together like commuters on the Central Line (if the Central Line existed yet, which it emphatically does not). Merchants hawk everything from amphorae of olive oil to dubious amulets guaranteed to ward off everything from bad luck to Gauls.^^";
            print "One merchant's stall catches your eye -- it's piled with unusual stones, crystals, and minerals.^^";
            print "The Forum is to the north, and a path leads south to the Thames dockside.^";
        ],
         n_to roman_forum,
         s_to roman_docks,
    has light;

Object merchant_stalls "market stalls" roman_merchants
    with name 'stall' 'stalls' 'shop' 'shops' 'market',
         description "Ramshackle wooden stalls crammed together, selling everything from olives to oracles. The merchants shout over each other with the desperate enthusiasm of people whose entire business model depends on volume -- both commercial and vocal.",
    has scenery pluralname;

Object merchant_stones "unusual stones" roman_merchants
    with name 'stones' 'crystal' 'crystals' 'mineral' 'minerals',
         description [;
            if (has_lodestone) {
                "Felix's stall is piled with stones, crystals, and minerals of dubious cosmic significance. Each one comes with a certificate of authenticity written in suspiciously fresh-looking Latin. There's a conspicuous gap where the lodestone used to sit, which Felix has filled with a hand-lettered sign reading ~SOLD -- ASK ABOUT OUR OTHER FINE SPECIMENS~.";
            } else {
                "Felix's stall is piled with stones, crystals, and minerals of dubious cosmic significance. Each one comes with a certificate of authenticity written in suspiciously fresh-looking Latin. The lodestone stands out among the lesser rocks like a senator among plebeians.";
            }
         ],
    has scenery pluralname;

Object merchant_people "merchants" roman_merchants
    with name 'merchants' 'merchant' 'hawkers' 'sellers' 'traders',
         description "The merchants of Londinium hawk their wares with the aggressive enthusiasm of people who have elevated commerce to an art form. Every one of them is absolutely certain that what they're selling will change your life, cure your ailments, or at minimum separate you from your money.",
    has scenery animate pluralname;

Object merchant_amulets "amulets" roman_merchants
    with name 'amulet' 'amulets' 'charm' 'charms' 'talisman',
         description "Dubious amulets guaranteed to ward off everything from bad luck to Gauls. They come in a range of materials from bronze to bone, each one claiming powers that its manufacturer would be hard-pressed to demonstrate in a controlled setting.",
    has scenery pluralname;

Object merchant_amphorae "amphorae" roman_merchants
    with name 'amphorae' 'amphora' 'oil' 'olive',
         description "Tall clay amphorae line the stalls, each one stamped with its contents and origin. Olive oil from Hispania, wine from Gaul, fish sauce from... well, you can smell the fish sauce from here. The garum is particularly aggressive today.",
    has scenery pluralname;

Object roman_docks "Thames Dockside"
    with description [;
            print "The Thames is narrower here than in your time, and considerably less polluted (though give the Romans a few more years). Small wooden boats bob at rickety piers while workers haul cargo -- amphorae, timber, British tin.^^";
            print "The ground near the waterline is soft and muddy. Good for burying things, if one were so inclined.^^";
            print "The Merchant's Quarter is back to the north.^";
        ],
         n_to roman_merchants,
    has light;

Object soft_mud "soft mud" roman_docks
    with name 'mud' 'ground' 'earth' 'dirt' 'soil',
         description [;
            if (capsule_buried) {
                "The mud has been patted down where you buried your pocket watch. With any luck, someone will dig it up in about two thousand years and be very confused.";
            }
            "The mud here is soft and deep. Ideal for burying something for posterity, if you happened to have something worth preserving.";
         ],
    has scenery;

Object docks_area "docks" roman_docks
    with name 'dock' 'docks' 'dockside' 'wharf',
         description "Wooden jetties and loading areas stretch along the riverbank. Roman dock workers shift cargo with the cheerful efficiency of people being paid by the amphora. The smell is authentically maritime -- fish, tar, and wet rope.",
    has scenery pluralname;

Object docks_thames "the Thames" roman_docks
    with name 'thames' 'river' 'water',
         description "The Thames in 60 AD is narrower, cleaner, and considerably more Roman than you're used to. It flows with the quiet confidence of a river that doesn't yet know about the Industrial Revolution.",
    has scenery proper;

Object docks_boats "boats" roman_docks
    with name 'boat' 'boats' 'ship' 'ships' 'vessel',
         description "Small wooden boats bob at the piers -- flat-bottomed cargo vessels and fishing boats, each one a triumph of Roman shipbuilding and British optimism about the weather.",
    has scenery pluralname;

Object docks_piers "piers" roman_docks
    with name 'pier' 'piers' 'jetty' 'jetties',
         description "Rickety wooden piers jut into the Thames, creaking under the weight of cargo and commerce. They've been repaired so many times that the original Roman timber is now mostly British oak held together by stubbornness.",
    has scenery pluralname;

Object docks_cargo "cargo" roman_docks
    with name 'cargo' 'goods' 'timber' 'tin',
         description "Amphorae of wine and oil, bundles of British timber, ingots of Cornish tin -- the raw materials of empire, stacked on the dockside waiting for transport. The Romans are nothing if not thorough about logistics.",
    has scenery;

! --- Roman NPCs ---

Object marcus "Centurion Marcus" roman_forum
    with name 'marcus' 'centurion' 'soldier' 'soldiers' 'guard',
         description [;
            if (marcus_impressed) {
                "Marcus stands at attention, though his expression has softened from ~bureaucratic hostility~ to ~grudging respect.~ He still thinks you dress like a lunatic, but a lunatic who commands thunder stones deserves some courtesy.";
            }
            "A broad-shouldered centurion in polished armour, radiating the quiet authority of a man who has spent twenty years telling people where they can and cannot walk. His name plate reads ~MARCVS RVFVS~ and his expression reads ~absolutely not.~";
         ],
         life [;
            Ask:
                NPC_Ask_Marcus(second);
                rtrue;
            Tell:
                "Marcus listens with the patient expression of a man who has heard every excuse for why someone should be allowed past the checkpoint.";
            Give:
                if (noun == lodestone) {
                    "~Keep your thunder stone, seer. Its magic is yours to command. I need no gifts -- only your assurance that you serve Rome.~";
                }
                "Marcus eyes the offering. ~I am a centurion of Rome. I am not bribed.~ A pause. ~Unless it's wine. Good wine.~";
            Show:
                if (noun == lodestone && marcus_impressed == false) {
                    marcus_impressed = true;
                    score = score + 5;
                    print "You hold the lodestone near Marcus's iron gladius. The sword twitches towards the stone, and Marcus leaps back as if stung.^^";
                    print "~By Jupiter!~ he breathes, eyes wide. ~The stone commands iron itself! You are a seer -- a wielder of divine power!~ He salutes hastily. ~Forgive my rudeness, great one. The Via Principalis is open to you, and I shall tell Priestess Livia of your... gifts.~^";
                    rtrue;
                }
                "Marcus glances at it without interest. ~Very nice. Now move along.~";
         ],
    has animate proper male;

Object livia "Priestess Livia" roman_forum
    with name 'livia' 'priestess',
         description "A tall woman in white robes, with the serene composure of someone who communes with gods on a regular basis and finds them generally less annoying than mortals.",
         life [;
            Ask:
                NPC_Ask_Livia(second);
                rtrue;
            Tell:
                "Livia listens with an expression that suggests she's evaluating your spiritual worth and finding it slightly below average.";
            Give:
                "~I have no need of material things,~ she says, in the tone of someone who has quite a nice collection of material things at home.";
         ],
    has animate proper female;

Object felix "Felix the Merchant" roman_merchants
    with name 'felix' 'merchant' 'trader' 'seller' 'vendor',
         description "A rotund man with the shrewd eyes of someone who can calculate profit margins in three currencies simultaneously. His stall is piled with stones and minerals, each one, he assures you, imbued with cosmic power.",
         add_to_scope [; if (has_lodestone == false) PlaceInScope(lodestone); ],
         life [;
            Ask:
                if (second == 'lodestone' or 'stone' or 'magnet' or 'thunder') {
                    if (has_lodestone) {
                        print "~You already have the finest lodestone in the Empire! What more could you want? ...Another lodestone? I might have one in the back, but it'll cost you.~^";
                    } else {
                        print "~Ah, the lodestone! A magnificent specimen. Pulls iron like a senator pulls favours.~ He strokes it lovingly. ~One gold aureus, and it's yours. A bargain!~^";
                    }
                    rtrue;
                }
                if (has_lodestone) {
                    print "Felix shrugs. ~Can't help you with that. But I must say, you have excellent taste -- that lodestone I sold you is the finest in the Empire.~^";
                } else {
                    print "Felix shrugs. ~Can't help you with that. But have you considered buying a lodestone? Life-changing purchase.~^";
                }
                rtrue;
            Give:
                if (noun == gold_aureus && has_lodestone == false) {
                    has_lodestone = true;
                    score = score + 8;
                    remove gold_aureus;
                    move lodestone to player;
                    StartDaemon(lodestone);
                    lodestone_last_room = location;
                    print "Felix's eyes light up like a Saturnalia bonfire. ~SOLD! To the strangely dressed foreigner!~ He sweeps up the aureus and presses a dark, heavy stone into your hand. It's heavier than it looks, and immediately tries to twist out of your grip toward Felix's display of iron hooks.^^~The finest lodestone in Londinium. It'll change your life. Possibly literally.~^";
                    rtrue;
                }
                "Felix examines your offering and shakes his head. ~Very nice, but I deal in gold. One aureus for the lodestone. That's the price.~";
         ],
    has animate proper male;

Object lodestone "lodestone"
    with name 'lodestone' 'stone' 'magnet' 'thunder',
         description [;
            print "A chunk of naturally magnetic iron ore, dense and dark. Mediterranean magnetite of exceptional purity.";
            if (toolkit in player)
                " It strains toward the toolkit in your bag, making the tools rattle.";
            if (location == roman_forum && marcus_impressed == false)
                " It's pulling hard to the north -- toward the soldiers.";
            if (location == solarium && time_machine in solarium)
                " It's pulling toward the time machine with uncomfortable force.";
            " It's warm to the touch and heavier than it looks.";
         ],
         before [;
            Take, Remove:
                if (self notin player)
                    "Felix slaps your hand away. ~One gold aureus, friend. That's the price.~";
         ],
         daemon [;
            if (self notin player) return;
            if (location == lodestone_last_room) return;
            lodestone_last_room = location;
            if (location == roman_forum && marcus_impressed == false)
                "^The lodestone jerks in your hand, straining toward the soldiers' iron swords.";
            if (location == roman_bath)
                "^The lodestone twitches toward the iron grate in the corner.";
            if (location == main_workshop)
                "^The lodestone hums, pulled by a dozen iron instruments on the workbench.";
            if (location == solarium && time_machine in solarium)
                "^The lodestone lurches toward the time machine, nearly pulling free of your grip.";
            if (location == blitz_street)
                "^The lodestone shivers -- iron everywhere here, shrapnel in the rubble, nails in the beams.";
            if (location == blitz_pub)
                "^The lodestone tugs at something on the bar -- a tin soldier trembles and topples over.";
            if (location == blitz_rooftop)
                "^The lodestone pulls toward the iron railing.";
         ];

Object roman_bathers "bathers" roman_bath
    with name 'bathers' 'romans' 'bather' 'people',
         description "Romans in various states of relaxation, debating the merits of different olive oils with an intensity usually reserved for warfare.",
    has scenery animate pluralname;

Object bath_pools "heated pools" roman_bath
    with name 'pool' 'pools' 'bath' 'baths',
         description "The pools range from tepidarium (pleasantly warm) to caldarium (volcanic). Romans recline in them like well-marinated olives, turning progressively pinker. The engineering required to heat this much water in first-century Britain is genuinely impressive.",
         before [;
            Enter:
                "You eye the caldarium longingly, but the Romans are already giving you suspicious looks for being overdressed. Stripping off and joining a philosophical debate about Stoicism while your time machine rusts seems inadvisable.";
         ],
    has scenery pluralname;

Object bath_water "bath water" roman_bath
    with name 'water',
         description "The water is surprisingly clear for a communal bath, heated by an ingenious hypocaust system beneath the floor. It smells faintly of olive oil and heated arguments.",
         react_before [;
            Swim:
                "The heated pools are tempting, but you're here to fix a time machine, not to adopt Roman bathing customs. Besides, you didn't bring a strigil.";
         ],
    has scenery;

Object bath_steam "steam" roman_bath
    with name 'steam' 'vapour' 'mist',
         description "Great billows of steam roll through the bathhouse like miniature weather systems, occasionally revealing a debating philosopher or concealing an embarrassed bather. The acoustics make every whisper sound like a senate proclamation.",
    has scenery;

Object bath_fish "small fish" roman_bath
    with name 'fish' 'small' 'minnow' 'silvery',
         description "A small, silvery fish about the length of your finger. It must have come in through the aqueduct system. It wriggles indignantly in your hand, clearly unimpressed with the service.",
         initial "A small silvery fish darts through the nearest pool, clearly bewildered by how it ended up in a Roman bath.",
         before [;
            Take:
                move self to player;
                "You plunge your hand into the warm water and, after an undignified chase that draws amused commentary from several nearby Romans, manage to grab the wriggling fish. It flaps wetly in your hand, looking personally offended.";
         ];

! ===================================================================
! WWII LONDON — 1941 (The Blitz)
! ===================================================================

Object blitz_street "Blacked-Out Street"
    with description [;
            print "London, 1941. The darkness is absolute -- blackout regulations turn the city into a maze of shadows and stumbling. Somewhere above, the drone of bombers provides an unwelcome soundtrack. Searchlights sweep the sky like the world's worst disco.^^";
            if (time_machine in self && machine_dug_out == false)
                print "The time machine is half-buried under rubble from the last raid, brass fittings poking through the debris like the bones of some mechanical beast.^^";
            else if (time_machine in self)
                print "The time machine stands in the street, dusted with plaster and looking thoroughly out of place in wartime London.^^";
            print "An underground shelter entrance leads down. A bombed church looms to the north. The Crown and Anchor pub is east, and a rubble-strewn site lies to the west.^";
        ],
         d_to blitz_shelter,
         n_to blitz_church,
         e_to blitz_pub,
         w_to blitz_rubble,
    has light;

Object street_rubble "rubble" blitz_street
    with name 'rubble' 'debris' 'brick' 'bricks',
         description "Chunks of brick and masonry scattered across the street from the last raid. London is slowly being rearranged by the Luftwaffe, and not in a way that any town planner would approve of.",
    has scenery;

Object street_darkness "darkness" blitz_street
    with name 'darkness' 'blackout' 'sky' 'dark' 'shadow' 'shadows',
         description "The blackout is absolute. Every window shuttered, every streetlamp extinguished. London has made itself invisible, crouching in the dark like an enormous city-shaped animal hoping the bombers won't notice. They notice anyway.",
    has scenery;

Object street_searchlights "searchlights" blitz_street
    with name 'searchlig' 'lights' 'beams',
         description "Searchlight beams sweep the sky like enormous white fingers, probing for bombers. The effect is simultaneously terrifying and oddly beautiful, like a very aggressive light show.",
    has scenery pluralname;

Object street_bombers "bombers" blitz_street
    with name 'bombers' 'bomber' 'planes' 'plane' 'aircraft' 'drone',
         description "The drone of Heinkel and Dornier bombers fills the sky, a mechanical buzzing that sets your teeth on edge. You can't see them in the darkness, which somehow makes it worse.",
    has scenery pluralname;

Object street_doorway "doorway" blitz_street
    with name 'doorway' 'entrance' 'curtain',
         description "A brick doorway with a hastily-hung blackout curtain. Beyond it, nothing but darkness and the smell of damp brick.",
    has scenery;

Object street_shelter "shelter entrance" blitz_street
    with name 'shelter' 'underground' 'steps',
         description "The entrance to the underground shelter -- a tube station pressed into service as a refuge from the bombing. Steps lead down into the warm, crowded darkness below.",
    has scenery;

Object blitz_shelter "Underground Shelter"
    with description [;
            print "The tube station has been pressed into service as an air raid shelter. Families huddle on platforms with blankets, thermoses, and the grim determination that defines the Blitz spirit. Someone is singing ~We'll Meet Again~ slightly off-key.^^";
            print "Corporal Tommy sits in a corner with his wireless set. Young Eleanor sits nearby, drawing intently.^^";
            print "The exit leads back up to the street.^";
        ],
         u_to blitz_street,
    has light;

Object shelter_blankets "blankets" blitz_shelter
    with name 'blanket' 'blankets' 'thermos' 'thermoses' 'families' 'family',
         description "Huddled families clutch thermoses and thin blankets against the chill of the underground platform. The Blitz spirit, it turns out, is mostly tea, wool, and stubbornness.",
    has scenery pluralname;

Object shelter_platform "platform" blitz_shelter
    with name 'platform' 'platforms' 'tube' 'shelter' 'station' 'tunnel',
         description "The tube station platform has been repurposed as sleeping quarters. Chalk lines mark out family spaces with the territorial precision of a very polite war. The trains stopped running weeks ago, but the infrastructure carries on, housing Londoners instead of transporting them.",
    has scenery;

Object shelter_drawings "drawings" blitz_shelter
    with name 'drawing' 'drawings' 'paper' 'papers' 'pictures',
         description "Sheets of salvaged paper covered in Eleanor's drawings -- cats, mostly. Dozens of cats in every pose and expression, rendered with the intense focus of a child who has found the one thing that makes sense when everything else doesn't.",
    has scenery pluralname;

Object tommy_radio "wireless set" blitz_shelter
    with name 'wireless' 'radio' 'set',
         description [;
            if (radio_fixed) {
                "The wireless crackles with life, picking up BBC broadcasts and military chatter. Tommy adjusts the dial with obvious satisfaction.";
            }
            "The wireless set sits silent and dead. A handwritten label reads ~Type 18 Mk.II.~ One of the valves is clearly burnt out -- a dark, dead tube where a warm glow should be.";
         ],
    has scenery;

Object blitz_church "Bombed Church"
    with description [;
            print "St. Margaret's Church has taken a beating but refuses to fall. The roof is half gone, pews are scattered like matchsticks, and stained glass crunches underfoot. But the walls still stand, and through a gap in the masonry, candlelight flickers from what remains of the nave.^^";
            if (inscription_carved) {
                print "On one ancient wall, visible through the bomb damage, you can make out a carved inscription: ~TEMPUS FUGIT -- THE TEMPORAL APPRENTICE WAS HERE, 60 AD.~ Nearly two thousand years old and still legible. You feel an odd chill.^^";
            }
            if (fire_event && church_saved == false) {
                print "Scorch marks show where the incendiary landed. The fire has not been contained.^^";
            }
            print "The street is back to the south. Stairs lead up to the fire watch rooftop.^";
        ],
         s_to blitz_street,
         u_to blitz_rooftop,
    has light;

Object church_roof "roof" blitz_church
    with name 'roof' 'ceiling',
         description "Half the roof is gone, open to the sky. The remaining timbers jut out like broken ribs, silhouetted against the searchlight-swept clouds. It's dramatic in a way that no architect intended.",
    has scenery;

Object church_rubble "church rubble" blitz_church
    with name 'rubble' 'debris' 'pews' 'masonry',
         description "Broken pews, shattered glass, chunks of masonry. War has no respect for architecture. Among the debris, you can see bits of medieval stonework that have survived since... well, since about 60 AD, actually.",
    has scenery;

Object church_building "church" blitz_church
    with name 'church' 'st' 'margaret',
         description "St. Margaret's has taken a beating from the Luftwaffe but refuses to go down. The walls still stand with the stubborn defiance of medieval masonry that has survived plagues, fires, and several centuries of Church of England fundraising committees.",
    has scenery;

Object church_stained_glass "stained glass" blitz_church
    with name 'stained' 'glass' 'window' 'windows',
         description "What remains of the stained glass crunches underfoot like colourful gravel. Fragments of saints and apostles glint in the candlelight, reduced from divine narrative to abstract art by a thousand-pound bomb. Modernism via the Luftwaffe.",
    has scenery;

Object church_candlelight "candlelight" blitz_church
    with name 'candle' 'candlelig' 'candles' 'flame' 'flames',
         description "Stubby candles flicker in the nave, casting wavering shadows across the bomb-damaged walls. Someone has been maintaining them through the raids -- an act of either faith or stubbornness, and quite possibly both.",
    has scenery;

Object church_nave "nave" blitz_church
    with name 'nave' 'aisle',
         description "The nave stretches towards what was once the altar, now partially obscured by fallen timbers. Despite the damage, there's a quiet dignity to the space. Churches have a talent for feeling sacred even when they're missing a roof.",
    has scenery;

Object church_walls "church walls" blitz_church
    with name 'wall' 'walls' 'inscription',
         description [;
            if (inscription_carved) {
                "The ancient walls bear the scars of both war and time. Through a gap in the bomb damage, a carved inscription is visible: ~TEMPUS FUGIT -- THE TEMPORAL APPRENTICE WAS HERE, 60 AD.~ Nearly two thousand years old. You feel a chill that has nothing to do with the weather.";
            }
            "The walls of St. Margaret's are a palimpsest of centuries -- medieval stonework, Tudor repairs, Victorian pointing, and now bomb damage. They've survived everything London has thrown at them. So far.";
         ],
    has scenery pluralname;

Object blitz_pub "The Crown and Anchor"
    with description [;
            print "The pub carries on with defiant normalcy. The bar is well-stocked (rationing hasn't touched spirits yet, mercifully), and a handful of regulars nurse pints with the stoic calm of people who have decided that if a bomb has their name on it, they might as well be holding a drink.^^";
            print "A faded poster on the wall shows a police telephone box with the caption ~FOR EMERGENCY USE ONLY.~ Someone has drawn a moustache on it.^^";
            print "The street is back to the west.^";
        ],
         w_to blitz_street,
    has light;

Object tin_soldier "tin soldier" blitz_pub
    with name 'tin' 'soldier' 'toy',
         description "A small tin soldier, slightly dented but still standing at attention. A tiny bit of wartime defiance in miniature.",
         initial "A small tin soldier stands on the bar, holding its ground against the Blitz.";

Object pub_bar "bar" blitz_pub
    with name 'bar' 'counter',
         description "A solid oak bar, well-stocked with bottles of spirits that glint in the lamplight. It has the comfortable, ring-stained look of a surface that has supported a thousand worried elbows through a thousand worried evenings.",
    has scenery supporter;

Object pub_regulars "pub regulars" blitz_pub
    with name 'regular' 'regulars' 'locals' 'patron' 'patrons' 'drinker' 'drinkers',
         description "The regulars regard you with the friendly suspicion that Londoners reserve for anyone who might be (a) a spy, (b) a German, or (c) someone who's going to ask them to move so they can check for unexploded bombs under their bar stool.",
    has scenery animate pluralname;

Object police_box "poster of police box" blitz_pub
    with name 'poster' 'police' 'box' 'telephone',
         description "Just an ordinary poster of an ordinary police telephone box. Nothing special about it at all. Absolutely not. It's blue, it's rectangular, and it is emphatically just a telephone box. Anyone who suggests otherwise has been watching too many documentaries.",
    has scenery;

Object pub_drinks "drinks" blitz_pub
    with name 'beer' 'drink' 'drinks' 'spirits' 'bottle' 'bottles',
         description "The bar is well-stocked with bottles of spirits, ales, and the occasional dubious homebrew. Rationing hasn't touched the drink yet, and the regulars intend to make the most of this oversight.",
    has scenery pluralname;

Object pub_curtains "blackout curtains" blitz_pub
    with name 'curtain' 'curtains' 'blackout',
         description "Heavy blackout curtains are drawn tight across every window, sealing in the warm lamplight and keeping out the war. The penalty for showing a light is severe, though Warden Peggy's disapproval is considered the worse punishment.",
    has scenery pluralname;

Object pub_fireplace "fireplace" blitz_pub
    with name 'fireplace' 'fire' 'hearth' 'mantle',
         description "A modest coal fire crackles in the grate, throwing warm shadows across the pub. Above the mantle, a framed photograph of the King keeps watch. Someone has hung a sign beneath it: ~KEEP CALM AND HAVE ANOTHER PINT.~",
    has scenery;

Object pub_building "pub" blitz_pub
    with name 'pub' 'crown' 'anchor' 'tavern',
         description "The Crown and Anchor carries on with the defiant normalcy that is the Blitz spirit distilled into architecture. The blackout curtains are drawn tight, the fire is lit, and the beer is flowing. Hitler himself couldn't close this pub, and he's certainly trying.",
    has scenery;

Object blitz_rooftop "Fire Watch Rooftop"
    with description [;
            print "The church tower provides a commanding view of blacked-out London. Searchlights crisscross the sky, and the distant crump of explosions punctuates the night. Sandbags are stacked along the parapet -- fire watch supplies for dealing with incendiary bombs.^^";
            if (fire_event == false) {
                fire_event = true;
                print "As if on cue, a cluster of incendiary bombs arcs across the sky like malevolent fireflies. One strikes the church roof below with a bright magnesium flash. Flames begin to spread along the timbers!^^";
                print "The sandbags are right here. You could try to extinguish the fire, or flee back down the stairs.^^";
            } else {
                if (church_saved)
                    print "The sandbags you used to smother the fire are scattered along the parapet. St. Margaret's still stands.^^";
                else
                    print "Flames still lick at the timbers below. The sandbags are right here -- it's not too late to act!^^";
            }
            print "Stairs lead back down to the church.^";
        ],
         d_to blitz_church,
    has light;

Object sandbags "sandbags" blitz_rooftop
    with name 'sandbag' 'sandbags' 'sand' 'bags' 'bag',
         description "Heavy burlap bags filled with sand, stacked along the parapet. Standard fire watch equipment. You grab one, it's about twenty pounds.",
         before [;
            Take:
                if (onotheld_mode == 1)
                    <<Extinguish rooftop_fire>>;
                if (church_saved) "The fire's already out. No need for more sandbags.";
                if (fire_event == false) "No fire to fight at the moment. Enjoy the view.";
                "You grab a sandbag. It's heavy. You could throw it at the fire below.";
            ThrowAt:
                <<Extinguish rooftop_fire>>;
         ],
    has scenery pluralname;

Object rooftop_parapet "parapet" blitz_rooftop
    with name 'parapet' 'ledge' 'edge' 'wall',
         description "A low stone parapet runs around the edge of the church tower, barely waist-high. It provides a commanding view of blacked-out London and absolutely no sense of personal safety. The sandbags are stacked along it for fire watch duty.",
    has scenery;

Object rooftop_searchlights "searchlights" blitz_rooftop
    with name 'searchlig' 'lights' 'beams',
         description "From up here, the searchlights paint the sky in sweeping arcs of brilliant white, hunting for bombers among the clouds. It's war turned into a light show -- terrible and oddly beautiful.",
    has scenery pluralname;

Object rooftop_sky "night sky" blitz_rooftop
    with name 'sky' 'night' 'stars' 'dark' 'darkness',
         description "The sky above London is a theatre of war -- searchlight beams, the red glow of distant fires, and the silhouettes of barrage balloons drifting like enormous sleeping whales. On a clear night you might see stars, but tonight the only lights are man-made and hostile.",
    has scenery;

Object rooftop_london "London skyline" blitz_rooftop
    with name 'london' 'skyline' 'view' 'city' 'panorama',
         description "Blacked-out London stretches below in every direction, a city made invisible by its own determination to survive. The skyline is punctuated by searchlight beams, distant fires, and the stubborn silhouettes of buildings that refuse to fall.",
    has scenery;

Object rooftop_fire "fire" blitz_rooftop
    with name 'fire' 'flames' 'blaze' 'incendiar',
         description [;
            if (church_saved)
                "The fire has been extinguished, thanks to your sandbag intervention. Scorch marks on the timbers below are the only evidence of the incendiary's brief, bright career.";
            if (fire_event)
                "Flames leap along the church timbers below, fed by the incendiary bomb's magnesium. The fire is spreading quickly -- you need to smother it with sandbags before St. Margaret's joins the list of London's losses.";
            "There's no fire at the moment. The church below looks peaceful, or at least as peaceful as a bomb-damaged church can.";
         ],
    has scenery;

Object blitz_rubble "Rubble Site"
    with description [;
            print "What was once Finch's Electronics Emporium is now a crater of shattered brick and twisted metal. A sign reading ~FI CH'S EL CTRO ICS~ hangs at a drunken angle. The Luftwaffe's urban redevelopment programme leaves something to be desired.^^";
            if (self hasnt general) {
                if (radio_valve in self)
                    print "A radio valve lies in the accessible rubble near the surface. Deeper in, you can see a metal box glinting under heavy debris -- too heavy to shift alone.^^";
                else
                    print "You can see a metal box glinting under heavy debris -- too heavy to shift alone.^^";
            } else {
                if (has_vacuum_tube == false)
                    print "The excavated hole reveals a metal box, now accessible.^^";
                else
                    print "The rubble has been partially cleared where you and Tommy dug out the metal box.^^";
            }
            print "The street is back to the east.^";
        ],
         e_to blitz_street,
    has light;

Object rubble_site "rubble site" blitz_rubble
    with name 'site' 'crater' 'ruin' 'ruins' 'rubble' 'debris',
         description "What remains of Finch's Electronics Emporium -- a crater of shattered brick, twisted metal, and the occasional recognisable fragment of what was once a thriving business. The Luftwaffe's approach to urban renewal leaves much to be desired.",
    has scenery;

Object rubble_sign "shop sign" blitz_rubble
    with name 'sign' 'finch',
         description "A battered sign reading ~FI CH'S EL CTRO ICS~ hangs at a drunken angle from a surviving wall bracket. Mr. Finch's vowels, like his shop, have not survived the bombing intact.",
    has scenery;

Object rubble_ordnance "unexploded ordnance" blitz_rubble
    with name 'ordnance' 'bomb' 'uxb' 'unexplode',
         description "Somewhere in this rubble, there may or may not be unexploded ordnance. The uncertainty is, in many ways, worse than the certainty. Warden Peggy's warnings echo in your mind. Best to tread carefully and dig only where you must.",
    has scenery;

Object radio_valve "radio valve" blitz_rubble
    with name 'valve' 'radio',
         description "A glass radio valve, miraculously intact. The filament inside looks good. This should work in Tommy's wireless set.",
         initial "A radio valve lies among the accessible surface rubble, glinting in the dim light.";

Object metal_box "metal box" blitz_rubble
    with name 'metal' 'box' 'case' 'crate' 'supply',
         description [;
            if (blitz_rubble hasnt general) {
                "A sturdy metal box is visible under several hundredweight of brick and timber. You'd need help to shift this lot.";
            }
            if (self has open) {
                "The box is open. Inside, nestled in packing straw, are rows of pristine vacuum tubes. One in particular catches your eye -- it's slightly larger than the others, with unusual markings.";
            }
            "The excavated metal box is dented but intact. It appears to be from a military shipment.";
         ],
         before [;
            Open:
                if (blitz_rubble hasnt general) "You can't reach the box yet. It's buried under tonnes of rubble.";
                if (self has open) "It's already open.";
                give self open;
                "You wrench the box open. Inside, packed in straw, are rows of vacuum tubes -- evacuated glass envelopes, the same principle as a Crookes tube but manufactured to military precision. One stands out -- slightly larger, with oscillation markings that look eerily familiar.";
            Take:
                if (blitz_rubble hasnt general) "You can't reach the box yet. It's buried under tonnes of rubble.";
                "The box is too heavy to carry, but you could open it and take what's inside.";
         ],
    has scenery container;

Object vacuum_tube "vacuum tube" metal_box
    with name 'vacuum' 'tube' 'special' 'military',
         description "A military-grade vacuum tube, mass-produced with a precision no Victorian glassblower could achieve. The principle is identical to a Crookes tube -- evacuated glass, cathode rays -- but manufactured to tolerances that would make Dr. Thyme weep with envy. This is the component needed for the temporal oscillation circuit.",
         before [;
            Take:
                if (blitz_rubble hasnt general) "It's buried under rubble. You need help digging it out first.";
                if (metal_box hasnt open) "It's inside the metal box. Open the box first.";
                if (parent(self) ~= player) {
                    has_vacuum_tube = true;
                    score = score + 8;
                    move self to player;
                    print "You carefully extract the vacuum tube from its packing straw. It's warm to the touch and hums faintly -- temporal resonance.";
                    if (has_lodestone && has_vacuum_tube && has_formula && has_processor)
                        print " That's all four components. Time to go home.";
                    print "^";
                    rtrue;
                }
         ];

! --- WWII NPCs ---

Object peggy "Warden Peggy" blitz_street
    with name 'peggy' 'warden',
         description "A formidable woman in a tin hat and ARP armband. Warden Peggy has the bearing of a woman who has personally told the Luftwaffe where to go and is disappointed they didn't listen.",
         life [;
            Ask:
                NPC_Ask_Peggy(second);
                rtrue;
            Tell:
                "Peggy listens with the expression of someone who is humouring you but has fourteen more urgent things to do.";
            Give:
                "~I don't need that! I need everyone in the shelters and those fires out!~";
         ],
    has animate proper female;

Object tommy "Corporal Tommy" blitz_shelter
    with name 'tommy' 'corporal' 'soldier',
         description [;
            if (radio_fixed)
                "Tommy sits by his now-functioning wireless, headphones on, occasionally scribbling notes. He looks ten years younger with something useful to do.";
            "A young man in a rumpled uniform, his arm in a sling from Dunkirk. He fiddles hopelessly with his dead wireless set.";
         ],
         life [;
            Ask:
                NPC_Ask_Tommy(second);
                rtrue;
            Tell:
                "Tommy nods amiably. ~Right you are.~";
            Give:
                if (noun == radio_valve && radio_fixed == false) {
                    radio_fixed = true;
                    score = score + 5;
                    remove radio_valve;
                    print "Tommy's face lights up like a Christmas tree. ~A working valve! You beauty!~ He slots it into the wireless with practiced hands. The set crackles to life, filling the shelter with the BBC Home Service.^^";
                    print "~...and now, the shipping forecast. Viking, North Utsire, South Utsire...~^^";
                    print "Tommy grins. ~Music to my ears. Right then -- you helped me, I'll help you. What do you need?~^";
                    rtrue;
                }
                "~Cheers, but what I really need is a valve for the wireless.~";
         ],
         orders [;
            Dig, DigRubble, Push, Pull:
                NPC_Ask_Tommy('rubble');
                rtrue;
            default:
                "Tommy shakes his head. ~That's not really my line, mate. Radios and rubble -- that's what I know.~";
         ],
    has animate proper male;

Object eleanor "Young Eleanor" blitz_shelter
    with name 'eleanor' 'girl' 'child',
         description [;
            if (eleanor_gift == 1)
                "Eleanor clutches the pocket watch you gave her, a smile breaking through for the first time. She's already drawing a picture of it -- a brass circle with elaborate cogs, surrounded by cats.";
            if (eleanor_gift == 2)
                "Eleanor marches the tin soldier you gave her across her drawings, a smile breaking through for the first time. She's already drawn a whole army of tin soldiers to keep it company -- all surrounded by cats, naturally.";
            "A girl of about eight, pale and quiet, hunched over a stack of salvaged paper. She draws with intense concentration -- cats, mostly. Dozens of cats in every pose. She hasn't spoken since the bombing that took her mother.";
         ],
         life [;
            Ask:
                print "Eleanor looks up at you with enormous eyes, then goes back to drawing. She doesn't speak, but she pushes one of her drawings towards you -- a picture of a silver cat.^";
                rtrue;
            Tell:
                "Eleanor listens solemnly, then draws you a picture of what you just said. It's surprisingly accurate.";
            Give:
                if (eleanor_gift) "Eleanor clutches her gift and smiles at you. She doesn't need anything else.";
                if (noun == pocket_watch || noun == tin_soldier) {
                    score = score + 25;
                    if (noun == pocket_watch) {
                        eleanor_gift = 1;
                        remove pocket_watch;
                        print "Eleanor takes the pocket watch and turns it over in her small hands. For the first time, something like wonder crosses her face. She holds it to her ear, listening to the tick-tick-tick, and the faintest ghost of a smile appears.^^";
                    } else {
                        eleanor_gift = 2;
                        remove tin_soldier;
                        print "Eleanor takes the tin soldier and stands it on her knee. For the first time, something like a real smile crosses her face. She makes the soldier march across her drawing pad, and a tiny giggle escapes.^^";
                    }
                    print "She tucks the gift carefully into her pocket, then -- solemnly -- tears out her best cat drawing and offers it to you. It shows a magnificently smug silver cat.^^";
                    move eleanor_drawing_item to player;
                    "You suspect this drawing might survive rather longer than you'd expect.";
                }
                "Eleanor examines the offering politely, then goes back to drawing. She's not being rude -- she just really likes drawing.";
         ],
    has animate proper female;

Object eleanor_drawing_item "Eleanor's drawing"
    with name 'drawing' 'picture' 'eleanor' 'cat',
         description "A child's drawing of a silver-grey cat, rendered with surprising skill and obvious love. The cat wears an expression of magnificent disdain. On the back, in careful letters: ~FOR THE NICE PERSON WITH THE FUNNY CLOTHES.~";

! ===================================================================
! CAMBRIDGE 2009 — Hawking's Party for Time Travellers
! ===================================================================

Object cambridge_gates "College Gates"
    with description [;
            print "Gonville and Caius College rises before you in all its medieval grandeur, looking exactly like the sort of place where people have been overthinking things for eight hundred years. Students in gowns hurry past, clutching books and existential crises in equal measure.^^";
            if (time_machine in self)
                print "The time machine sits beside the bicycle rack, humming quietly. Several bikes have been chained to it.^^";
            print "The Porter's Lodge is to the north. A faded notice pinned to the gate reads: ~PROFESSOR HAWKING'S PARTY FOR TIME TRAVELLERS -- JUNE 28, 2009.~^";
        ],
         n_to cambridge_porter,
    has light;

Object cambridge_notice "notice" cambridge_gates
    with name 'notice' 'sign' 'poster',
         description "A faded notice pinned to the gate reads: ~PROFESSOR HAWKING'S PARTY FOR TIME TRAVELLERS -- JUNE 28, 2009. Champagne and canapes will be served. Dress: casual (any century).~ It was posted after the event -- invitations sent backward through time, so only genuine time travellers could attend. A temporal lighthouse. No wonder the machine locked onto this date.",
    has scenery;

Object cambridge_gate "gate" cambridge_gates
    with name 'gate' 'gates' 'entrance' 'arch',
         description "The ancient stone gateway to Gonville and Caius College, worn smooth by eight centuries of scholars, students, and the occasional bewildered tourist. The ironwork is original and magnificent, designed to keep out everyone who doesn't have a very good reason to be here.",
    has scenery;

Object cambridge_bikes "bicycle rack" cambridge_gates
    with name 'bicycle' 'bike' 'bikes' 'rack',
         description "A tangle of bicycles in various states of repair, chained to a rack, to each other, and to at least one lamppost. This is Cambridge. Bicycles are a way of life, a mode of transport, and occasionally a philosophical statement.",
    has scenery pluralname;

Object cambridge_students "students"
    with name 'student' 'students' 'gown' 'gowns' 'book' 'books',
         description "Students in billowing black gowns hurry past in every direction, clutching books, folders, and the unmistakable air of people who have read too much and slept too little. They move with the purposeful speed of the academically terrified.",
         found_in cambridge_gates cambridge_porter cambridge_garden cambridge_hall cambridge_study,
    has scenery pluralname animate;

Object cambridge_porter "Porter's Lodge"
    with description [;
            print "The Porter's Lodge is a small, warm room that serves as the gatehouse to academic paradise. A stern porter sits behind a window, radiating the quiet authority of someone who has told Nobel Prize winners they can't park there.^^";
            if (porter_bypassed)
                print "The way north to the Great Hall is open.^^";
            else
                print "The way north to the Great Hall is blocked by centuries of tradition and one very determined porter.^^";
            print "The college gates are back to the south. The college garden is to the east.^";
        ],
         s_to cambridge_gates,
         n_to [;
            if (porter_bypassed) return cambridge_hall;
            print "~Invitation, please,~ says the porter, in a tone that brooks no argument. He has been brooking no arguments since 1987.^";
            rfalse;
         ],
         e_to cambridge_garden,
    has light;

Object porter_window "window" cambridge_porter
    with name 'window' 'desk',
         description "A small, sturdy window behind which the porter sits in judgement. The desk beyond it is immaculate -- a logbook, a telephone, and a mug of tea arranged with military precision. A sign on the glass reads: ~ALL VISITORS MUST REPORT.~",
    has scenery;

Object porter_npc "college porter" cambridge_porter
    with name 'porter' 'jenkins',
         article "the",
         description "The college porter. Tweed jacket, stern expression, an encyclopaedic knowledge of who belongs here and who doesn't. You do not belong here. He knows this. You know this. Copernicus doesn't care.",
         life [;
            Ask:
                if (second == 'party' or 'hawking' or 'invitation' or 'event') {
                    if (porter_bypassed) {
                        print "~The party is in the Great Hall. Professor Hawking's guests are expected to be punctual. And dressed... well. Never mind.~^";
                    } else {
                        print "~Professor Hawking's party is by invitation only. If you have an invitation, present it. If you don't...~ He lets the silence do the heavy lifting.^";
                    }
                    rtrue;
                }
                print "The porter regards you over his spectacles. ~I'm afraid I can't help you with that.~^";
                rtrue;
            Give:
                if (noun == invitation) {
                    porter_bypassed = true;
                    score = score + 5;
                    remove invitation;
                    print "The porter examines the invitation with the forensic scrutiny of a man who has confiscated more fake invitations than you've had hot dinners.^^";
                    print "~Hmm. This appears to be genuine.~ He sounds almost disappointed. ~Very well. The party is in the Great Hall, through to the north. Do try not to touch anything.~^";
                    rtrue;
                }
                "The porter accepts nothing but invitations and the quiet dignity of academic protocol.";
            Show:
                if (noun == invitation) {
                    porter_bypassed = true;
                    score = score + 5;
                    remove invitation;
                    print "The porter examines the invitation. ~Genuine. Proceed to the Great Hall, north.~^";
                    rtrue;
                }
                "The porter is unimpressed.";
         ],
    has animate male;

Object cambridge_garden "College Garden"
    with description [;
            print "A perfectly manicured garden that looks like it was designed by God on a particularly good day and has been maintained by anxious gardeners ever since. Ancient trees shade immaculate lawns. A bench overlooks a carp pond.^^";
            if (church_saved)
                print "Above the college rooftops, the spire of St. Margaret's Church rises against the sky -- beautifully restored, its medieval stonework scrubbed clean of centuries of soot. A plaque near the garden wall notes: ~St. Margaret's survived the Blitz thanks to the bravery of local fire watchers.~ You feel a quiet glow of pride.^^";
            else
                print "Above the college rooftops, you notice a conspicuous gap in the skyline where a church spire ought to be. A small plaque near the garden wall reads: ~Site of St. Margaret's Church, destroyed by incendiary bomb, 1941.~ A car park occupies the space now. Progress.^^";
            if (invitation in cambridge_garden)
                print "Half-hidden under the bench, something catches your eye -- a piece of card that's been dropped or blown here.^^";
            print "The Porter's Lodge is back to the west.^";
        ],
         w_to cambridge_porter,
    has light;

Object garden_pond "carp pond" cambridge_garden
    with name 'pond' 'carp' 'fish' 'koi',
         description "A placid pond where ancient carp drift with the unhurried calm of creatures that have tenure. They've been here longer than most of the faculty and are considerably less stressed about their publication record.",
    has scenery;

Object garden_trees "trees" cambridge_garden
    with name 'tree' 'trees' 'lawn' 'grass' 'garden',
         description "Ancient trees shade immaculate lawns maintained with the obsessive precision that only centuries of academic tradition can produce. A small sign reads ~KEEP OFF THE GRASS~ in a font that suggests this is not a suggestion but a fundamental law of the university.",
    has scenery pluralname;

Object garden_church_view "church" cambridge_garden
    with name 'church' 'spire' 'margaret' 'plaque',
         description [;
            if (church_saved) {
                "St. Margaret's Church stands proud above the rooftops, its spire catching the afternoon light. The medieval stonework has been beautifully restored. A plaque near the garden wall reads: ~St. Margaret's survived the Blitz thanks to the bravery of local fire watchers, 1941.~ You saved that church. You were there.";
            }
            "A plaque near the garden wall marks the site of St. Margaret's Church, destroyed by an incendiary bomb in 1941. The gap in the skyline has been filled by a car park. History, paved over.";
         ],
    has scenery;

Object garden_bench "bench" cambridge_garden
    with name 'bench' 'seat',
         description "A wooden bench with a brass plaque: ~IN MEMORY OF DOUGLAS ADAMS, WHO KNEW WHERE HIS TOWEL WAS.~ Someone has left a card underneath it.",
    has scenery supporter;

Object invitation "party invitation" cambridge_garden
    with name 'invitation' 'card' 'invite' 'party',
         description "An elegant card reads: ~Professor Stephen Hawking requests the pleasure of your company at a party for time travellers. Gonville and Caius College, June 28, 2009.~ Below, in smaller print: ~Invitations sent after the party. If you can read this, you're either a time traveller or very good at finding things under benches.~ So THIS is what pulled the machine here. Hawking sent invitations backward through time -- a beacon for anyone with the means to follow it.",
         initial "A cream-coloured invitation card peeks out from under the bench.";

Object cambridge_hall "Gonville Hall"
    with description [;
            print "The Great Hall is decked out for a party that nobody was expected to attend -- and very nearly nobody has. A banquet table groans under champagne, canapes, and a cake decorated with a clock. Balloons printed with ~WELCOME TIME TRAVELLERS~ drift against the vaulted ceiling.^^";
            print "Professor Hawking sits at the head of the table in his wheelchair, very much at ease with the possibility that the entire event might be a magnificent failure.^^";
            if (hawking_convinced == false)
                print "Dr. Sarah Chen, Hawking's research assistant, hovers nearby, looking both excited and sceptical.^^";
            print "The Porter's Lodge is back to the south. A corridor leads east to Hawking's study.^";
        ],
         s_to cambridge_porter,
         e_to [;
            if (hawking_convinced) return cambridge_study;
            print "Dr. Chen blocks the corridor. ~Professor Hawking's study is private. Unless, of course, he invites you in himself.~^";
            rfalse;
         ],
    has light;

Object party_table "banquet table" cambridge_hall
    with name 'table' 'banquet' 'food' 'champagne' 'canapes' 'cake' 'balloon' 'balloons',
         description "The table is a feast for one. Well, for several, but only one has shown up. The champagne is excellent (Dom Perignon, 2001), the canapes are artful, and the cake has a marzipan TARDIS on it. Professor Hawking has a sense of humour.",
    has scenery supporter;

Object hall_wheelchair "wheelchair" cambridge_hall
    with name 'wheelchair' 'chair' 'wheels',
         description "Professor Hawking's wheelchair is a marvel of technology, bristling with controls and the speech synthesiser that gives his words their distinctive robotic authority. It is, in its own way, as much a scientific instrument as anything in the laboratory.",
    has scenery;

Object hall_ceiling "vaulted ceiling" cambridge_hall
    with name 'ceiling' 'vaulted',
         description "The vaulted ceiling arches high above, its medieval stonework now decorated with balloons printed ~WELCOME TIME TRAVELLERS~ in cheerful colours. The balloons drift and bump against the ancient beams with a faintly absurd dignity, as if even inflatable latex respects eight centuries of academic tradition.",
    has scenery;

Object cambridge_study "Hawking's Study"
    with description [;
            print "The study of the most famous physicist alive is surprisingly cosy. Books line every wall, a computer with a speech synthesiser sits on the desk, and models of black holes and the cosmos hang from the ceiling like a nerd's mobile.^^";
            if (formula_printout in cambridge_study)
                print "A dot-matrix printout hangs from the printer, its perforated edges still attached.^^";
            print "The hall is back to the west.^";
        ],
         w_to cambridge_hall,
    has light;

Object study_desk "desk" cambridge_study
    with name 'desk' 'computer' 'synthesiser' 'synthesizer' 'screen',
         description "A desk dominated by Hawking's computer and speech synthesiser, the equipment through which one of the finest minds in history communicates with the world. The screen shows equations that would make lesser physicists weep.",
    has scenery supporter;

Object study_books "books" cambridge_study
    with name 'book' 'books' 'shelves' 'shelf',
         description "Books line every wall -- cosmology, quantum mechanics, popular science, and what appears to be a well-thumbed copy of The Hitchhiker's Guide to the Galaxy. Professor Hawking's reading habits are catholic in the best sense.",
    has scenery pluralname;

Object study_models "models" cambridge_study
    with name 'model' 'models' 'cosmos' 'mobile' 'black' 'hole' 'holes',
         description "Models of black holes and the cosmos hang from the ceiling like a physicist's mobile. They spin gently in the draft, miniature universes rotating with the casual grace of things that don't need to worry about grant applications.",
    has scenery pluralname;

Object formula_printout "printout" cambridge_study
    with name 'printout' 'formula' 'equatio' 'tractor' 'feed' 'dot' 'matrix' 'printer',
         description "A dot-matrix printout on perforated tractor-feed paper. Thirty years of theoretical physics, printed by a machine older than most of Hawking's students. The equations describe the geometry of time itself -- the mathematical framework that the journal said simply did not exist yet. When Hawking publishes this, others will build on it. Better instruments. Better materials. You wonder what, exactly, the future will build.",
         initial "A dot-matrix printout hangs from the printer.",
         before [;
            Take:
                if (hawking_convinced == false) {
                    "The printer is silent. Professor Hawking hasn't printed anything yet. Perhaps convince him first.";
                }
                if (has_formula == false) {
                    has_formula = true;
                    score = score + 8;
                    move self to player;
                    "You tear the printout along its perforations and fold it carefully. Hawking nods from the doorway. ~That printout is the seed of everything that comes after. Take good care of it.~ A pause. ~Also, try not to create any paradoxes. The paperwork is terrible.~";
                }
         ];

! --- Cambridge NPCs ---

Object hawking "Professor Hawking" cambridge_hall
    with name 'hawking' 'professor' 'stephen',
         description "Professor Stephen Hawking, the most famous physicist in the world, sits in his wheelchair with eyes that miss absolutely nothing. His speech synthesiser gives his words an oddly robotic gravitas that somehow makes everything he says sound even more devastatingly witty.",
         life [;
            Ask:
                NPC_Ask_Hawking(second);
                rtrue;
            Tell:
                if (second == 'time' or 'travel' or 'future' or 'machine') {
                    if (hawking_phase == 0) {
                        hawking_phase = 1;
                        print "Hawking's eyes gleam. ~You claim to be a time traveller. Interesting. Many people have made this claim. None have provided evidence. Tell me something about the future that would convince a physicist.~^";
                        rtrue;
                    }
                }
                "The synthesiser clicks. ~Interesting, but not convincing. I need evidence, not anecdotes.~";
            Give, Show:
                if ((noun == lodestone || (noun == toolkit && lodestone_installed)) && hawking_phase >= 2 && hawking_convinced == false) {
                    hawking_convinced = true;
                    score = score + 8;
                    if (lodestone_installed)
                        print "Hawking examines your toolkit. His instruments spike immediately. ~This metal has been exposed to temporal radiation,~ the synthesiser announces. ~The molecular signature is unmistakable -- these tools have passed through a temporal field multiple times.~ His instruments go haywire. The synthesiser is silent for a long moment.^^";
                    else
                        print "Hawking watches as the lodestone pulls at every piece of metal in the room. His instruments go haywire. The synthesiser is silent for a long moment.^^";
                    if (lodestone_installed)
                        print "~The temporal signature is impossible. These instruments have been exposed to radiation that won't be theorised for another fifty years.~ Another pause. ~You really are a time traveller.~^^";
                    else
                        print "~The magnetic signature is impossible. This stone has been exposed to temporal radiation that won't be theorised for another fifty years.~ Another pause. ~You really are a time traveller.~^^";
                    print "The silence that follows is not empty. You can almost hear the future rearranging itself.^^";
                    print "~I have spent thirty years developing a theoretical framework for temporal harmonics. I was going to destroy my notes if no one came tonight. What would be the point?~ The synthesiser pauses. ~But you came. Which means the theory works. Which means I should publish.~^^";
                    print "He gives a command to his computer. In the study to the east, a dot-matrix printer whirs to life -- the unmistakable sound of perforated paper being fed through an ancient mechanism.^^";
                    print "~The formula is printing now. Dr. Chen will let you through. Take it. Use it. And when the future builds on my work...~ Another pause. ~Well. You'll understand in time.~^";
                    rtrue;
                }
                if (noun == lodestone or vacuum_tube or hartley_journal or toolkit or time_machine) {
                    if (hawking_phase >= 1 && hawking_convinced == false) {
                        hawking_phase = 2;
                        print "Hawking examines the object with intense curiosity. ~Unusual. The craftsmanship is clearly Victorian, but the materials...~ He trails off, calculating. ~This is not from 2009. But I need the final proof. Something that demonstrates temporal mechanics directly.~^";
                        rtrue;
                    }
                }
                if (noun == newspaper)
                    "The synthesiser clicks. ~A newspaper from 2009. I could obtain one of these myself, you know. Proving you are from the future requires rather more than today's headlines.~";
                if (noun == pocket_watch)
                    "Hawking's instruments briefly scan the watch. The synthesiser clicks. ~A fine timepiece. But I study the nature of time itself, not its mechanical approximations.~";
                if (noun == front_door_key)
                    "The synthesiser clicks. ~A key. How metaphorical. Unfortunately, the door to temporal proof requires something rather less mundane.~";
                if (noun == cleaning_rag)
                    "Hawking glances at the rag. The synthesiser clicks. ~I have a team of carers for domestic matters. What I need from you is evidence, not housekeeping.~";
                if (noun == tin_soldier)
                    "Hawking's eyes linger on the soldier for a moment. The synthesiser clicks. ~A curious relic. But nostalgia is not proof. I need something that defies the physics of its own era.~";
                "The synthesiser clicks. ~Interesting. But not enough.~";
         ],
    has animate proper male;

Object chen "Dr. Sarah Chen" cambridge_hall
    with name 'chen' 'sarah' 'doctor' 'dr' 'assistant',
         description [;
            if (hawking_convinced)
                "Dr. Chen watches you with the expression of a scientist whose worldview has just been comprehensively rearranged. She's already making notes. You suspect you've just witnessed the beginning of a very significant research programme.";
            "Dr. Chen, Hawking's research assistant. Young, brilliant, and currently trying to decide whether you're a genuine time traveller or a very committed gatecrasher.";
         ],
         life [;
            Ask:
                if (second == 'hawking' or 'professor') {
                    print "~Professor Hawking is the most brilliant mind of our generation. He also has a wicked sense of humour. This entire party is essentially an experiment. He sent the invitations AFTER the event. Only a time traveller could attend.~^";
                    rtrue;
                }
                if (second == 'party' or 'time' or 'travel') {
                    print "~I'll be honest -- I thought this would be an empty room and a lot of champagne. If you really are from another time, Professor Hawking will want proof. Talk to him.~^";
                    rtrue;
                }
                print "Dr. Chen shrugs. ~I'm a physicist, not a tour guide. Talk to Professor Hawking.~^";
                rtrue;
            Give:
                "Dr. Chen politely declines. ~I'm sure Professor Hawking would be more interested in that than I am.~";
         ],
    has animate proper female;

! ===================================================================
! FUTURE LONDON — 2045
! ===================================================================

Object future_street "Flooded Street"
    with description [;
            print "London, 2045. The Thames won. Water laps at what used to be the second floor of Victorian terraces. Buildings rise from the flood like stone islands, connected by catwalks and rope bridges. It's Venice, if Venice had been designed by civil engineers during a nervous breakdown.^^";
            if (time_machine in self && has_diving_gear == false)
                print "The time machine sank on arrival. You can just see its brass fittings glinting below the waterline, taunting you.^^";
            else if (time_machine in self && machine_raised == false)
                print "The time machine is just below the surface. With your diving gear, you could haul it up.^^";
            else if (time_machine in self)
                print "The time machine stands on a makeshift platform, dripping Thames water and looking thoroughly sorry for itself.^^";
            print "The Thames Barrier Museum is north. An elevated walkway stretches east. The Climate Refuge is to the west. Below, murky water conceals whatever lies on the submerged street level";
            if (has_diving_gear)
                print " -- your diving gear could get you down there";
            print ".^";
        ],
         n_to future_museum,
         e_to future_walkway,
         w_to future_refuge,
         d_to [;
            if (has_diving_gear) return future_lab;
            print "The water below is dark and deep. You'd need diving gear to explore the submerged level without drowning, which is generally considered a prerequisite for time travel.^";
            rfalse;
         ],
    has light;

Object future_catwalks "catwalks" future_street
    with name 'catwalk' 'catwalks' 'rope' 'bridge' 'bridges' 'walkways',
         description "A precarious network of catwalks and rope bridges connects the upper floors of flooded buildings. They sway in the wind with a confidence-undermining enthusiasm. The engineering is creative, the safety standards are aspirational, and the views are spectacular if you can stop looking down.",
    has scenery pluralname;

Object future_buildings "buildings" future_street
    with name 'building' 'buildings' 'terrace' 'terraces' 'victorian' 'house' 'houses',
         description "Victorian terraces rise from the floodwater like rows of red-brick teeth. The ground floors are submerged, their windows dark and silted. Upper floors have been converted into living spaces, connected by the network of catwalks. Washing lines stretch between buildings, and window boxes defy the apocalypse with geraniums.",
    has scenery pluralname;

Object future_museum "Thames Barrier Museum"
    with description [;
            print "The museum occupies the upper floors of what was once the Thames Barrier control centre. Display cases hold artefacts salvaged from flooded London -- underground signs, a red telephone box, soggy copies of the Evening Standard dated 2038.^^";
            if (capsule_buried)
                print "A special exhibit catches your eye: ~ROMAN TIME CAPSULE -- DISCOVERED AT THAMES DOCKSIDE EXCAVATION.~ Inside the case, unmistakably, is your grandfather's pocket watch. The label reads: ~Circa 60 AD. Remarkably well-preserved. Origin unknown.~^^";
            if (eleanor_gift)
                print "Another display: ~WARTIME ART COLLECTION.~ Among the children's drawings is one labelled ~Eleanor Morrison, aged 8, 1941.~ It shows a silver cat. You recognise the style immediately.^^";
            if (church_saved)
                print "A scale model of St. Margaret's Church dominates one corner: ~SAVED FROM THE BLITZ -- St. Margaret's Church survived the incendiary raids of 1941, thanks to a fire watcher who smothered the flames with sandbags.~ The church still stands, even above the floodwaters.^^";
            else
                print "A photograph shows a gap-toothed London skyline. The caption reads: ~Site of St. Margaret's Church, destroyed by incendiary bomb, 1941. One of many irreplaceable buildings lost to the Blitz.~^^";
            if (newspaper in self)
                print "Near the entrance, a climate-controlled case holds a single yellowed page of the Times. You feel a jolt of recognition -- the ale stain from the Brass Tap, the pencil circle around the advert, the fold where you always tuck it under your arm. A placard reads: ~VICTORIAN NEWSPAPER, 1895. RECOVERED FROM SEALED AMPHORA, ROMAN STRATUM, THAMES EXCAVATION SITE. THE VESSEL'S WAX SEAL WAS INTACT WHEN FOUND. PROVENANCE UNKNOWN. NOTE: INK APPEARS TO CHANGE UNDER OBSERVATION. DO NOT ADJUST DISPLAY.~^^";
            print "A DeLorean sits in the corner with a sign reading ~TIME TRAVEL IN POPULAR CULTURE.~^^";
            print "The flooded street is south. Stairs lead up to the rooftop.^";
        ],
         s_to future_street,
         u_to future_rooftop,
    has light;

Object delorean "DeLorean" future_museum
    with name 'delorean' 'car' 'dmc',
         description "A stainless steel DeLorean DMC-12, mounted on a display platform. The plaque reads: ~Time Machine (Replica) -- As featured in the Back to the Future documentary trilogy (1985-1990). Note: actual time travel requires considerably more brass and considerably less plutonium.~",
    has scenery;

Object time_capsule_display "time capsule display" future_museum
    with name 'capsule' 'display' 'exhibit',
         description [;
            if (capsule_buried) {
                "Your grandfather's pocket watch sits in a museum case, nearly two thousand years after you buried it in Roman mud. The label reads: ~Circa 60 AD. Brass timepiece of unknown origin. Remarkably well-preserved. Donated by Thames Archaeological Society.~ You feel simultaneously proud and deeply weird.";
            }
            "You don't see any such display.";
         ],
    has scenery;

Object eleanor_display "wartime art display" future_museum
    with name 'wartime' 'art' 'eleanor',
         description [;
            if (eleanor_gift) {
                "The display includes several children's drawings from the Blitz. One is unmistakably Eleanor's work -- the same silver cat, the same careful lines. The label reads: ~Eleanor Morrison, aged 8, 1941. Morrison went on to become a celebrated artist.~ You smile.";
            }
            "You don't see any such display.";
         ],
    has scenery;

Object church_display "church model" future_museum
    with name 'church' 'model' 'margaret',
         description [;
            if (church_saved) {
                "A beautifully detailed scale model of St. Margaret's Church, complete with tiny sandbags on the roof. The plaque reads: ~St. Margaret's Church -- survived the Blitz of 1941 when a fire watcher smothered an incendiary with sandbags. The church still stands above the floodwaters, one of the few medieval buildings to survive both war and water.~ You feel a fierce, irrational pride.";
            }
            "You don't see any such display.";
         ],
    has scenery;

Object museum_cases "display cases" future_museum
    with name 'case' 'cases' 'display' 'displays' 'artefacts' 'artefact',
         description "Glass-fronted display cases line the walls, each carefully labelled. They hold the detritus of a drowned civilisation: Oyster cards, mobile phones with dead batteries, a Greggs loyalty card with nine stamps out of ten. Someone almost got a free sausage roll.",
    has scenery pluralname;

Object museum_telephone "red telephone box" future_museum
    with name 'telephone' 'phone' 'box' 'red',
         description "A classic red K6 telephone box, designed by Sir Giles Gilbert Scott in 1935. It survived the Blitz, privatisation, and the invention of the mobile phone, only to be finally done in by the Thames. The receiver still dangles off the hook, as if someone was mid-call when the water rose.",
    has scenery;

Object museum_signs "underground signs" future_museum
    with name 'sign' 'signs' 'underground' 'tube',
         description "A collection of London Underground roundels salvaged from various stations. Westminster, Bank, Waterloo -- the names read like a history of Britain rendered in enamel and mild steel. The colours have faded but the typography remains immaculate. Some things outlast everything.",
    has scenery pluralname;

Object museum_standard "Evening Standard copies" future_museum
    with name 'standard' 'evening' 'newspapers' 'papers' 'copies' 'soggy',
         description "Soggy copies of the Evening Standard, dated 7th March 2038. The headline reads: ~THAMES BARRIER FAILS -- CENTRAL LONDON FLOODS.~ Below the fold: ~PROPERTY PRICES EXPECTED TO STABILISE.~ Some things never change, even when everything does.",
    has scenery pluralname;

Object future_rooftop "Museum Rooftop"
    with description [;
            print "The rooftop provides a staggering view of flooded London. The old skyline pokes through the water like a half-drowned city playing dead. In the distance, new structures rise on stilts -- the future adapting, as it always does.^^";
            if (kai_helping)
                print "The communications panel has been opened and fixed, its antenna now pointing skyward.^^";
            else
                print "A maintenance panel is bolted to the communications array. It looks like it needs someone with mechanical skills to open it.^^";
            print "Stairs lead back down to the museum.^";
        ],
         d_to future_museum,
    has light;

Object rooftop_view "view of flooded London" future_rooftop
    with name 'view' 'skyline' 'london' 'structures' 'stilts',
         description "Flooded London stretches to every horizon. The old skyline -- the Shard, the Gherkin, the towers of Canary Wharf -- stands half-submerged, their lower floors drowned. Between them, new structures rise on stilts and pontoons: a city rebuilding itself one storey higher. It's simultaneously devastating and magnificent.",
    has scenery;

Object comm_panel "maintenance panel" future_rooftop
    with name 'panel' 'maintenance' 'communications' 'array' 'antenna',
         description [;
            if (kai_helping) {
                "The panel is open, its circuits repaired. The communications array hums with renewed purpose.";
            }
            "A locked maintenance panel on the communications array. The bolts are rusted but the mechanism looks like standard Victorian-era engineering under all the modern casing. Someone with the right tools could open it.";
         ],
         before [;
            Open:
                if (kai_helping) "It's already open and fixed.";
                if (toolkit notin player) "The panel needs proper tools to open. The bolts are rusted shut.";
                kai_helping = true;
                score = score + 5;
                print "Your Victorian toolkit is, ironically, perfect for the job. The bolts are based on a nineteenth-century standard that never changed. You pop the panel open, reconnect a few wires, and the communications array hums to life.^^";
                print "Kai appears at the top of the stairs, grinning. ~You fixed it! Torres has been trying to get that working for months!~ She unslings her diving gear. ~Here -- take this. Fair trade. The submerged lab is below the flooded street.~^^";
                move diving_gear to player;
                has_diving_gear = true;
                "Kai disappears back down the stairs, practically bouncing.";
         ],
    has scenery;

Object future_walkway "Elevated Walkway"
    with description [;
            print "A precarious catwalk of reclaimed metal and salvaged scaffolding connects the upper floors of flooded buildings. It sways gently in the wind. Below, the water is murky and occasionally something large moves in it. Best not to think about what.^^";
            print "Kai perches on the railing with the easy balance of someone who grew up over water.^^";
            print "The flooded street is back to the west.^";
        ],
         w_to future_street,
    has light;

Object walkway_railing "railing" future_walkway
    with name 'railing' 'rail' 'railings' 'handrail',
         description "A railing of salvaged metal pipe, bolted together with more optimism than engineering expertise. It's sturdy enough to lean on, probably, but you wouldn't want to test that theory at this height.",
    has scenery;

Object walkway_scaffolding "scaffolding" future_walkway
    with name 'scaffolding' 'scaffold' 'catwalk' 'metal' 'walkway',
         description "The walkway is built from reclaimed scaffolding and salvaged metal, lashed together with cable ties and determination. It sways gently underfoot, which is either the wind or the structure expressing its opinion about your weight.",
    has scenery;

Object future_refuge "Climate Refuge"
    with description [;
            print "What was once a council building has been converted into a community hub. Solar panels and wind turbines sprout from the roof. Inside, it's warm, dry, and surprisingly cheerful -- a testament to human bloody-mindedness in the face of catastrophe.^^";
            print "Mayor Torres coordinates the settlement from a desk piled with maps and reports.^^";
            print "The flooded street is back to the east.^";
        ],
         e_to future_street,
    has light;

Object refuge_panels "solar panels and wind turbines" future_refuge
    with name 'solar' 'panel' 'panels' 'wind' 'turbine' 'turbines' 'roof',
         description "Solar panels cover the roof in neat rows, angled to catch every scrap of London's grudging sunlight. Between them, small wind turbines spin with quiet determination. Together they power the Refuge -- heating, lighting, and the communications equipment. The future runs on ingenuity and weather.",
    has scenery pluralname;

Object refuge_desk "desk" future_refuge
    with name 'desk' 'maps' 'map' 'reports' 'report' 'papers',
         description "Torres's desk is a command centre disguised as furniture. Maps of flooded London cover every surface, annotated with supply routes, safe passages, and tide tables. Reports are stacked in colour-coded folders -- red for urgent, yellow for pending, green for resolved. The green stack is noticeably thin.",
    has scenery;

Object future_lab "Submerged Laboratory"
    with description [;
            print "You descend through murky water into what was once a cutting-edge research laboratory. A plaque on the wall reads: ~HAWKING TEMPORAL RESEARCH CENTRE -- FOUNDED 2031.~ So he published. The diving gear keeps you breathing, but the experience is deeply eerie -- fluorescent lights still flicker underwater, illuminating desks where coffee cups float at ceiling height.^^";
            if (lab_unlocked == false) {
                print "A sealed cabinet marked ~CRYSTALLINE PROCESSING UNIT -- AUTHORISED PERSONNEL ONLY~ stands against the far wall. It has an electronic keypad lock.^^";
                if (has_formula)
                    print "The keypad has a label: ~Default code: temporal harmonic sequence.~ The formula on Hawking's printout might work...^^";
            } else {
                if (has_processor == false)
                    print "The cabinet stands open.^^";
                else
                    print "The opened cabinet stands empty.^^";
            }
            print "The surface is back up.^";
        ],
         u_to future_street,
    has light;

Object lab_dispatch "dispatch log" future_lab
    with name 'dispatch' 'log' 'clipboard' 'ledger' 'manifest',
         description "A waterlogged clipboard, still legible under the laminate. It's a dispatch log for the lab's crystalline processors. Most entries are routine -- serial numbers, calibration dates, recipient labs. But the final entry, in different handwriting, reads: ~UNIT 0001-ALPHA. DISPATCH TO: J. THYME, 12 PRAED STREET, LONDON. DISPATCH DATE: [ILLEGIBLE]. NOTE: INCLUDE BRASS HARNESS (SPEC ATTACHED). INCLUDE NOTE. DO NOT LOG SENDER.~ The rest of the page is water-damaged beyond reading.",
         initial "A clipboard floats near the cabinet, bumping gently against the wall.",
    has;

Object lab_equipment "laboratory equipment" future_lab
    with name 'desk' 'desks' 'equipment' 'coffee' 'cup' 'cups',
         description "Desks and workstations are frozen in the moment the water rose. Computer monitors stare blankly into the murk, keyboards trail cables like tentacles, and coffee cups drift at ceiling height in a surreal slow-motion ballet. Whatever they were researching here, they left in a hurry.",
    has scenery pluralname;

Object lab_lights "fluorescent lights" future_lab
    with name 'light' 'lights' 'fluorescent',
         description "The fluorescent lights still flicker underwater, powered by some backup system that has outlasted all rational expectation. They cast an eerie, greenish glow through the murk, making the submerged laboratory look like a very expensive fish tank.",
    has scenery pluralname;

Object flood_water "floodwater"
    with name 'water' 'flood' 'thames' 'floodwater' 'murky',
         description "Murky brown water stretches in every direction, lapping at brickwork and swallowing streets whole. The Thames didn't so much burst its banks as abolish the concept of banks entirely. Debris drifts lazily on the surface -- a traffic cone, half a park bench, what might be a rubber duck.",
         found_in future_street future_museum future_rooftop future_walkway future_refuge future_lab,
         before [;
            Smell:
                "It smells of river mud, diesel, and the faintest hint of sewage -- the authentic Thames experience, now available at every floor level.";
            Taste:
                "You take an experimental sip and immediately regret it. It tastes of silt, rust, and approximately two thousand years of London's drainage decisions.";
            Listen:
                "Lap, lap, lap. The water has a patient rhythm, like it knows it's winning and is in no particular hurry.";
            Take:
                "You scoop up a handful. It runs through your fingers, leaving a brownish residue and a lingering sense of poor judgement.";
            Drink:
                "Absolutely not. You've seen what's floating in it.";
         ],
         react_before [;
            Swim:
                "The water is murky, freezing, and full of debris. Swimming in it would be less ~exercise~ and more ~unusual method of suicide.~";
         ],
    has scenery;

Object quantum_cabinet "sealed cabinet" future_lab
    with name 'cabinet' 'sealed' 'quantum' 'keypad' 'lock',
         description [;
            if (lab_unlocked) {
                if (has_processor)
                    "The cabinet stands open and empty.";
                "The cabinet is open, revealing a quantum processor gleaming with an otherworldly light.";
            }
            "A heavy-duty sealed cabinet marked ~QUANTUM PROCESSING UNIT.~ The electronic keypad lock glows faintly. A label reads: ~Default code: temporal harmonic sequence.~";
         ],
         before [;
            Open:
                if (lab_unlocked) "It's already open.";
                if (has_formula == false) {
                    "The keypad demands a code -- a temporal harmonic sequence. You don't know the right numbers. Perhaps someone with expertise in temporal physics could help.";
                }
                lab_unlocked = true;
                give self open;
                print "You punch in the temporal harmonic sequence from Hawking's printout. The keypad beeps, turns green, and the cabinet clicks open with a satisfying hiss.^^";
                "Inside, floating in a suspension field, is a crystalline component. It pulses with a soft blue light that seems to exist in slightly more dimensions than is strictly comfortable. You recognise the material instantly.";
         ],
    has scenery container;

Object quantum_processor "quantum processor" quantum_cabinet
    with name 'processor' 'quantum' 'chip' 'cpu' 'crystal' 'crystalline' 'component',
         description "A crystalline processor that seems to shimmer between states of existence. It's warm to the touch and appears to be slightly transparent. You feel a lurch of recognition -- this is the same material as the cracked component in the time machine's field generator. Built in a lab founded on Hawking's temporal harmonics framework. The framework he almost destroyed. The framework he only published because you showed up at his party. ~YOU WILL UNDERSTAND IN TIME.~ You do now.",
         before [;
            Take:
                if (lab_unlocked == false) "It's locked in the cabinet. You need to open it first.";
                if (parent(self) ~= player) {
                    has_processor = true;
                    score = score + 8;
                    move self to player;
                    print "You lift the crystalline processor from its suspension field. It hums in your hands, warm and familiar -- the same hum the time machine's field generator made before the accident. Built on Hawking's theory. Which exists because you went to his party. Which you could only attend because of a machine powered by this crystal. Somewhere, somewhen, someone is going to pack one of these into a brass harness, write a cryptic note, and post it to 14 Praed Street.";
                    if (has_lodestone && has_vacuum_tube && has_formula && has_processor)
                        print " That's all four components. Time to go home.";
                    print "^";
                    rtrue;
                }
         ];

Object diving_gear "diving gear"
    with name 'diving' 'gear' 'rebreather' 'mask' 'scuba',
         description "A compact rebreather kit with mask and fins. Future technology -- lighter and more efficient than anything in your era. Kai's handwritten instructions are taped to the mask: ~BREATHE NORMALLY. DON'T PANIC. IF YOU SEE SOMETHING GLOWING, THAT'S FINE.~";

! --- Future NPCs ---

Object torres "Mayor Torres" future_refuge
    with name 'torres' 'mayor',
         description "Mayor Torres has the silver hair and steel spine of someone who has been managing catastrophes for decades. She runs the Refuge with calm efficiency and zero tolerance for nonsense.",
         life [;
            Ask:
                NPC_Ask_Torres(second);
                rtrue;
            Tell:
                "Torres listens attentively. ~Noted.~ It's unclear whether she's genuinely noting it or just being polite.";
            Give:
                "~I appreciate the gesture, but the Refuge runs on cooperation, not charity.~";
         ],
    has animate proper female;

Object kai "Kai" future_walkway
    with name 'kai' 'scavenger' 'girl' 'woman',
         description [;
            if (kai_helping) {
                "Kai grins at you from the railing. She's in an excellent mood since you fixed the communications array.";
            }
            "A young woman in a wetsuit, perched on the walkway railing with the casual ease of someone who considers gravity a suggestion.";
         ],
         life [;
            Ask:
                NPC_Ask_Kai(second);
                rtrue;
            Tell:
                "Kai nods enthusiastically. ~Cool, cool. Sounds wild.~";
            Give:
                "~Thanks, but I'm good. Fix that panel for me and we'll be even.~";
         ],
    has animate proper female;

Object curator "Museum Curator" future_museum
    with name 'curator' 'webb' 'old',
         description "An elderly person in a cardigan that has survived more floods than they have. The curator tends the museum with the quiet devotion of someone preserving the memory of a drowning city.",
         life [;
            Ask:
                if (second == 'museum' or 'exhibit' or 'history') {
                    print "~We preserve what we can. London has survived plague, fire, war, and now water. The Thames Barrier held for seventy years. That's not a failure -- that's an engineering triumph that bought us time.~^";
                    rtrue;
                }
                if (second == 'capsule' or 'watch' or 'roman' or 'buried') {
                    if (capsule_buried) {
                        print "~The Roman time capsule? Remarkable find. A Victorian pocket watch buried in a Roman-era stratum. The archaeologists are still arguing about it. Personally, I think someone was playing silly games with time.~ They wink.^";
                    } else {
                        print "~Time capsules? We have a few. People love burying things for the future. The future, I can tell you, is mostly interested in not drowning.~^";
                    }
                    rtrue;
                }
                if (second == 'delorean' or 'car') {
                    print "~The DeLorean? A replica from the famous documentary series. Lovely films. Completely inaccurate, of course -- everyone knows real time travel requires brass.~ They pause. ~That was a joke.~^";
                    rtrue;
                }
                if (second == 'eleanor' or 'drawing' or 'art') {
                    if (eleanor_gift) {
                        print "~Eleanor Morrison? Wonderful artist. Survived the Blitz, became one of Britain's most celebrated painters. Her early cat drawings are quite collectible. She always credited a stranger during the war who gave her ";
                        if (eleanor_gift == 1)
                            print "a pocket watch";
                        else
                            print "a tin soldier";
                        print " and, she said, hope.~^";
                    } else {
                        print "~We have some wartime art in the collection. Children's drawings, mostly. Poignant stuff.~^";
                    }
                    rtrue;
                }
                if (second == 'church' or 'margaret' or 'spire') {
                    if (church_saved) {
                        print "~St. Margaret's? Still standing, even with all the flooding. One of the few medieval buildings to keep its head above water, literally. They say a fire watcher saved it during the Blitz -- smothered an incendiary with sandbags on the roof. Remarkable bravery.~ They gaze out the window. ~Sometimes one person really does make the difference.~^";
                    } else {
                        print "~St. Margaret's Church? Lost in the Blitz, I'm afraid. Incendiary bomb, 1941. Nobody got to it in time. We have a photograph in the collection. One of many irreplaceable things this city has lost.~^";
                    }
                    rtrue;
                }
                print "The curator adjusts their cardigan. ~I'm afraid I don't know much about that. But do look around -- the museum speaks for itself.~^";
                rtrue;
            Give:
                "~How kind. We'll add it to the collection.~ They probably won't.";
         ],
    has animate proper;

! ===================================================================
! COPERNICUS THE CAT — Companion Daemon
! ===================================================================

Object copernicus "silver-grey cat" main_workshop
    with name 'copernicus' 'cat' 'grey' 'gray' 'silver' 'shorthair' 'moggy',
         short_name [;
            if (copernicus_named) {
                print "Copernicus";
            } else {
                print "silver-grey cat";
            }
            rtrue;
         ],
         description [;
            if (copernicus_named) {
                "A magnificently smug British Shorthair of considerable girth and negligible conscience. Copernicus is shaded silver -- a white undercoat tipped with grey along his back, flanks, and head, fading to pale silver on his legs and pure white at the chin and chest. In certain light he looks like a cat made of smoke. His round face, copper eyes, and plush coat give him the air of a very small, very disapproving judge. His purr is thunderous, and his talent for sitting on the worst possible thing at the worst possible time is genuinely supernatural. A small brass name tag hangs from his collar.";
            }
            "A magnificently smug British Shorthair of considerable girth and negligible conscience. He is shaded silver -- a white undercoat tipped with grey along his back, flanks, and head, fading to pale silver on his legs and pure white at the chin and chest. In certain light he looks like a cat made of smoke. His round face, copper eyes, and plush coat give him the air of a very small, very disapproving judge. His purr is thunderous, and his talent for sitting on the worst possible thing at the worst possible time is genuinely supernatural. A small brass name tag hangs from his collar.";
         ],
         life [;
            Ask:
                if (second == 'drain' or 'grate' or 'grating') {
                    if (location == roman_bath && bath_drain hasnt general) {
                        if (cat_bribed == false) {
                            if (copernicus_named)
                                "Copernicus sniffs at the grate, then loses interest and begins washing his paw.";
                            "The cat sniffs at the grate, then loses interest and begins washing his paw.";
                        }
                        give bath_drain general;
                        move gold_aureus to roman_bath;
                        "Copernicus peers at the grate, ears pricked. He squeezes a paw through the bars and bats around furiously. After a moment of scrabbling, a gold coin skitters across the wet tiles.";
                    }
                    if (bath_drain has general)
                        "Copernicus glances at the grate, unimpressed. He's already done his bit.";
                }
                if (copernicus_named)
                    "Copernicus regards you with the serene indifference of a creature who has transcended the need for conversation.";
                "The cat regards you with the serene indifference of a creature who has transcended the need for conversation.";
            Tell:
                if (second == 'drain' or 'grate' or 'grating') {
                    if (location == roman_bath && bath_drain hasnt general) {
                        if (cat_bribed == false) {
                            if (copernicus_named)
                                "Copernicus sniffs at the grate, then loses interest and begins washing his paw.";
                            "The cat sniffs at the grate, then loses interest and begins washing his paw.";
                        }
                        give bath_drain general;
                        move gold_aureus to roman_bath;
                        "Copernicus peers at the grate, ears pricked. He squeezes a paw through the bars and bats around furiously. After a moment of scrabbling, a gold coin skitters across the wet tiles.";
                    }
                    if (bath_drain has general)
                        "Copernicus glances at the grate, unimpressed. He's already done his bit.";
                }
                if (copernicus_named)
                    "Copernicus flicks an ear. This is the feline equivalent of ~I hear you but I couldn't possibly care less.~";
                "The cat flicks an ear. This is the feline equivalent of ~I hear you but I couldn't possibly care less.~";
            Attack:
                "The cat gives you a look that suggests you should reconsider every decision that led to this moment. You reconsider.";
            Give:
                if (noun == bath_fish) {
                    remove bath_fish;
                    if (location == roman_bath && bath_drain hasnt general) {
                        give bath_drain general;
                        move gold_aureus to roman_bath;
                        cat_bribed = true;
                        "You slide the fish between the bars of the drain grate. Copernicus is on it instantly -- he jams a paw through the gap, batting furiously at the fish. In the frantic scrabbling, something metallic pings off the bars and skitters across the wet tiles. A gold coin rolls in a wobbly circle and falls flat. Copernicus, utterly indifferent to the small fortune he's just excavated, hooks the fish out and devours it in three enthusiastic bites.";
                    }
                    cat_bribed = true;
                    "Copernicus's eyes go wide. He snatches the fish from your hand with a speed that would shame a striking cobra, and devours it in three enthusiastic bites. He licks his whiskers and begins to purr thunderously.";
                }
                "The cat sniffs your offering, finds it beneath his dignity, and looks away.";
            ThrowAt:
                "Absolutely not. This cat has an air of invincibility about him. He can certainly survive you.";
         ],
         orders [;
            "The cat ignores your instruction with the magnificent disdain that only a cat can achieve. He is not your employee. He is not anyone's employee. He is a cat.";
         ],
         before [ x;
            Take:
                if (rag_on_machine && location == solarium) {
                    cat_accident = true;
                    visited_roman = true;
                    current_era = 1;
                    score = score + 3;
                    rag_on_machine = false;
                    copernicus_named = true;
                    give self proper;
                    remove cleaning_rag;
                    print "You reach toward the cat, but your hand brushes the cleaning rag draped over him. This is a mistake.^^";
                    print "The cat, with the unerring instinct of cats everywhere for finding the worst possible moment to be difficult, twists away from your grasp. His back legs scrabble for purchase on the control panel, and one powerful hind paw connects squarely with a large brass lever marked ~ABSOLUTELY DO NOT TOUCH.~^^";
                    print "The lever moves. The machine screams. The workshop dissolves into a whirlwind of light and sound and what might be the faint smell of marmalade.^^";
                    print "Something inside the machine gives a grinding lurch -- the compass housing flares white-hot, dims, flares again, and settles to a feeble glow. The lodestone. Seventeen careful test activations it survived, and one uncontrolled transit has nearly finished it off.^^";
                    print "When the universe stops vibrating, you are somewhere -- and somewhen -- else entirely.^^";
                    StartDaemon(copernicus);
                    objectloop (x in solarium)
                        if (x hasnt scenery && x ~= time_machine && x ~= copernicus)
                            move x to player;
                    move time_machine to roman_forum;
                    PlayerTo(roman_forum);
                    rtrue;
                }
                "The cat goes boneless with the practiced ease of a cat who has perfected the art of being unpickupable. He weighs approximately seven hundred pounds when he doesn't want to be held.";
            Touch:
                "The cat allows exactly 2.4 seconds of chin-scratching before biting your finger. Not hard enough to draw blood. Just hard enough to establish boundaries.";
            Listen:
                "Purrrrrrrrr. It's the sound of a small, self-satisfied engine.";
            Push, Pull:
                if (copernicus_named)
                    "Copernicus gives you a flat look that says ~I am exactly where I intend to be.~ He somehow becomes heavier.";
                "The cat gives you a flat look that says ~I am exactly where I intend to be.~ He somehow becomes heavier.";
         ],
         daemon [;
            if (parent(self) ~= location && cat_accident)
                move self to location;
            cat_turn_count++;
            if (cat_turn_count % 7 == 0 && cat_accident) {
                new_line;
                switch (current_era) {
                    0: switch (random(4)) {
                        1: print "Copernicus hops onto the workbench and sits on something important.^";
                        2: print "Copernicus yawns, displaying a cathedral of pink and white.^";
                        3: print "Copernicus eyes the time machine controls with an expression that should concern you.^";
                        4: print "Copernicus washes his paw with studied nonchalance.^";
                       };
                    1: switch (random(4)) {
                        1: print "Copernicus pounces on a rat. The rat doesn't stand a chance. Nearby Romans applaud.^";
                        2: print "A Roman citizen tries to pet Copernicus. Copernicus permits it. The citizen looks like they've been blessed by Jupiter.^";
                        3: print "Copernicus sprawls in a sunbeam, achieving a state of feline enlightenment.^";
                        4: print "Copernicus chases a pigeon with terrifying efficiency. The pigeon escapes. Barely.^";
                       };
                    2: switch (random(4)) {
                        1: print "Copernicus curls up next to Eleanor, who immediately begins drawing him.^";
                        2: print "Copernicus stares at the ceiling during an air raid with complete indifference. The concept of bombing has not impressed him.^";
                        3: print "Someone in the shelter shares their spam sandwich with Copernicus. He accepts it as his due.^";
                        4: print "Copernicus sits in a doorway and refuses to move. Several people have to step over him. He is unconcerned.^";
                       };
                    3: switch (random(4)) {
                        1: print "Copernicus hops onto Professor Hawking's lap. The synthesiser says: ~I approve of this cat.~^";
                        2: print "Copernicus bats at a champagne cork across the floor of the Great Hall.^";
                        3: print "A Cambridge student tries to photograph Copernicus. Copernicus turns his back. Every. Single. Time.^";
                        4: print "Copernicus sits on a stack of physics papers with the expression of a cat who is improving them.^";
                       };
                    4: switch (random(4)) {
                        1: print "Copernicus peers over the edge of the walkway at the water below with the expression of a cat who finds the entire ocean personally offensive.^";
                        2: print "Kai reaches out to pet Copernicus. He allows it, which Kai takes as the highest honour of her life.^";
                        3: print "Copernicus sniffs the flooded air and sneezes. He gives the water a look of pure contempt.^";
                        4: print "Copernicus finds the driest spot in the entire flooded district and sits on it. Of course he does.^";
                       };
                }
            }
         ],
    has animate male;

Object cat_name_tag "brass name tag"
    with name 'tag' 'name' 'collar' 'nametag' 'brass',
         found_in [; return (location == parent(copernicus)); ],
         description [;
            copernicus_named = true;
            give copernicus proper;
            "A small brass tag on the cat's collar, engraved with the name ~COPERNICUS~ in tiny capitals. Below the name, a miniature solar system has been etched with extraordinary precision -- planets orbiting a central sun. Someone with a very steady hand and a very specific sense of humour made this.";
         ],
         before [;
            Take:
                "The tag is firmly attached to the cat's collar. The cat is firmly attached to doing whatever he wants. You'll have to settle for examining it.";
         ],
    has scenery;

Object cleaning_rag "cleaning rag"
    with name 'rag' 'cleaning' 'cloth',
         description [;
            if (rag_on_machine) {
                if (copernicus_named)
                    "Your cleaning rag is currently in the possession of Copernicus, who is sitting on the machine with it. Getting it back would require getting the cat off the machine.";
                "Your cleaning rag is currently in the possession of the cat, who is sitting on the machine with it. Getting it back would require getting the cat off the machine.";
            }
            "A soft cotton cleaning rag, slightly oil-stained. Dr. Thyme pressed it into your hands with instructions to tidy up the workshop.";
         ],
         before [;
            Take:
                if (rag_on_machine) {
                    print "The rag is tangled up with the cat on the machine. You'll need to grab the cat to get it back.^";
                    rtrue;
                }
            Drop:
                if (location == solarium && thyme_departed && rag_stolen == false) {
                    rag_stolen = true;
                    rag_on_machine = true;
                    move self to solarium;
                    print "You set down the cleaning rag beside the machine.^^";
                    if (copernicus_named)
                        print "In a flash of silver fur, Copernicus snatches the rag and bolts. Before you can react, the cat has leapt atop the contraption in the centre of the room, the cleaning rag trailing from his mouth like a battle standard. He settles among the controls with an expression of absolute triumph.^^";
                    else
                        print "In a flash of silver fur, the cat snatches the rag and bolts. Before you can react, he has leapt atop the contraption in the centre of the room, the cleaning rag trailing from his mouth like a battle standard. He settles among the controls with an expression of absolute triumph.^^";
                    print "Getting that rag back is going to require getting the cat off the machine. This seems... inadvisable.^";
                    rtrue;
                }
         ];

Object thyme_note "hastily scrawled note"
    with name 'note' 'scrawl' 'scrawled' 'hasty' 'hastily' 'paper',
         description "In handwriting that suggests the pen was moving at roughly the speed of sound: ~GONE TO MRS. PEMBERTON'S FOR SCONES. BACK SOONISH. DO TIDY UP. DO NOT ENTER SOLARIUM. I MEAN IT. -- J.T.~ Below this, in even hastier script: ~P.S. FRONT DOOR KEY IS ON THE WORKBENCH. OR THE FLOOR. SOMEWHERE IN THAT GENERAL VICINITY.~",
         initial "A hastily scrawled note has been left on the workbench.";

! ===================================================================
! TIME TRAVEL DESTINATIONS (parentless scope objects)
! ===================================================================

Object roman_dest "Roman Londinium"
    with name 'roman' 'londinium' 'rome' 'ad' '60',
    has proper;

Object blitz_dest "Blitz London"
    with name 'blitz' 'wwii' 'ww2' '1941' 'war',
    has proper;

Object hawking_dest "Cambridge"
    with name 'cambridge' 'hawking' '2009',
    has proper;

Object future_dest "Future London"
    with name 'future' '2045' 'flood',
    has proper;

Object solarium_dest "Workshop"
    with name 'workshop' 'solarium' 'home' '1895' 'victorian',
    has proper;

! ===================================================================
! INITIALISE
! ===================================================================

[ Initialise;
    @split_window 1;
    location = praed_street;
    score = 0;
    move pocket_watch to player;
    move coins to player;
    move newspaper to newsboy;
    SetTime(14*60+48, 1);   ! 2:48 PM (3 min fast), +1 min/turn

    print "London, 1895.^^";
    print "The door of Greybaum, Tedium and Sons closes behind you with a finality usually reserved for coffin lids. Sacked. After four years of impeccable ledger-keeping, one small fire in the filing room, and an honest difference of opinion about whether the senior partner's toupee counted as a business expense.^^";
    print "You step onto Praed Street with nothing but your grandfather's pocket watch and a handful of coins -- your final wages. The London fog wraps around you like a damp, disapproving relative.^^";
    print "You'll need to find work. Perhaps a newspaper would have something in the classifieds.^^";
    print "Type HELP for a list of commands.^^";
];

! ===================================================================
! INSCOPE — make travel destinations available globally after cat accident
! ===================================================================

[ InScope actor;
    if (actor == player && cat_accident) {
        PlaceInScope(roman_dest);
        PlaceInScope(blitz_dest);
        PlaceInScope(hawking_dest);
        PlaceInScope(future_dest);
        PlaceInScope(solarium_dest);
    }
    if (actor == tommy)
        PlaceInScope(rubble_site);
    rfalse;
];

! ===================================================================
! DEATH MESSAGE (multiple endings)
! ===================================================================

[ PrintEnding;
    if (score >= MAX_SCORE) {
        print "^^=== PERFECT ENDING ===^^";
        print "Every component recovered. Every inscription carved, every capsule buried, every church saved, every drawing inspired. You have not merely repaired the time machine -- you have woven yourself into the fabric of history.^^";
        print "Dr. Thyme returns from tea to find his machine in better condition than when he left. Copernicus sits atop it, naturally. ~I see you've had a productive afternoon,~ he says, peering at you over an imaginary pair of spectacles. ~Tea?~^^";
        print "You accept. The scones are excellent.^";
    } else if (score >= 135) {
        print "^^=== GOOD ENDING ===^^";
        print "The time machine hums with renewed purpose. Most of the damage has been repaired, and the timeline is... mostly intact. A few loose threads here and there, but nothing that can't be fixed with another trip or two.^^";
        print "Dr. Thyme returns and nods approvingly. ~Well done, apprentice. There are a few calibrations I'd like to review, but overall -- not bad for a first day.~^^";
        print "Copernicus yawns. He's had better Tuesdays.^";
    } else if (score >= 100) {
        print "^^=== ROUGH ENDING ===^^";
        print "The machine works, technically. It makes some concerning noises and occasionally displays dates that haven't been invented yet, but it works. The timeline has a few dents in it, like a second-hand automobile.^^";
        print "Dr. Thyme returns, examines the machine, and sighs. ~It'll do. Probably. Maybe don't touch anything for a while.~^^";
        print "Copernicus has no opinion. He's asleep.^";
    } else {
        print "^^=== PARADOX ENDING ===^^";
        print "The machine sputters back to life with all the confidence of a piano falling down stairs. The timeline has more holes in it than a Swiss cheese in a shooting gallery.^^";
        print "Dr. Thyme returns and his left eye twitches. ~What,~ he says very carefully, ~did you do to my machine?~^^";
        print "Copernicus, at least, seems proud of you both.^";
    }
];

[ BootstrapStart;
    ! Phase 1: open the door, past-self enters, player hides behind door
    endgame_knocks_heard = false;
    endgame_phase = 1;
    endgame_turns = 0;
    StopDaemon(copernicus);
    print "You ease the door open a crack and peer through. There you are -- younger by an afternoon, damp from the fog, clutching a copy of yesterday's Times. As you watch, your past self glances down the alley, shifts weight, and starts to turn away.^^";
    print "No.^^";
    print "You yank the door wide and press yourself flat against the wall behind it, heart slamming. Footsteps stop. A pause. Then your past self turns back, stares at the open doorway -- at the empty doorway -- and steps cautiously inside.^^";
    print "You hold your breath behind the door as your past self looks around the entrance, then walks east into the workshop. You hear Dr. Thyme's voice: ~The number four spanner. On the shelf behind you. The brass one.~^^";
    print "You are alone behind the front door. Through the eastern doorway, you can hear your past self rummaging on the shelves.^";
    PlayerTo(workshop_entrance, 1);
];

[ BootstrapCross;
    ! Phase 2: cross the workshop while they're distracted
    endgame_phase = 2;
    endgame_turns = 0;
    print "You peer around the doorframe. Your past self has their back to you, scanning the shelves for the spanner. Dr. Thyme is hunched over the workbench, face three inches from something intricate. Neither of them is looking this way. Neither of them is looking at anything except what's directly in front of them.^^";
    print "You cross the workshop in four quick steps. Dr. Thyme notices you exactly as much as he noticed you the first time -- which is to say, not at all until he needs a spanner.^^";
    print "The store room door is open to the north.^";
    PlayerTo(main_workshop, 1);
];

[ BootstrapFinale;
    ! Phase 3: hide in store room, watch the loop close
    endgame_phase = 3;
    print "You slip into the store room and press yourself between a crate marked ~CONTENTS UNKNOWN -- DO NOT OPEN ON WEDNESDAYS~ and a shelf of specimen jars.^^";
    print "Through the gap you watch your past self fumble with the spanner. Watch Thyme hand over the cleaning rag and the key. Watch yourself find the journal, read the warning about the cat -- underlined seventeen times -- and ignore it completely.^^";
    print "Dr. Thyme leaps up, checks three watches simultaneously, and bolts for the door muttering about Mrs. Pemberton's scones. The front door slams.^^";
    print "Your past self unfurls the cleaning rag. The cat pounces. In a flash of silver fur the rag is gone and so is the cat -- a grey blur bolting east down the corridor. Your past self hesitates for exactly one second, then chases after.^^";
    print "From the solarium comes a crash, a mechanical scream, and the unmistakeable smell of marmalade and burnt copper.^^";
    print "Silence.^^";
    print "You step out of the store room. The workshop is empty. The solarium is empty. The time machine is gone, along with your past self and one extremely smug cat.^^";
    print "The loop is closed.^^";
    print "You stand in the quiet workshop for a moment, listening to the ticking of the clock and the distant sounds of London. Then the front door opens.^^";
    print "Dr. Thyme has returned from tea.^";
    PrintEnding();
    deadflag = 2;
];

! ===================================================================
! ACTION ROUTINES
! ===================================================================

[ ZBuySub;
    if (noun == newspaper) {
        if (newsboy notin location)
            "There's nobody here selling newspapers.";
        if (newspaper in player)
            "You've already got a newspaper.";
        if (newspaper notin newsboy)
            "The newsboy has already sold his last copy -- to you.";
        if (coins notin player)
            "You pat your pockets. No coins. You've already spent your last wages.";
        move newspaper to player;
        score = score + 2;
        "~Tuppence, guv!~ The newsboy plucks two coins from your palm with the speed of a striking cobra and thrusts a folded copy of the Times into your hands. ~Pleasure doing business!~ He bites one of the coins experimentally, nods with satisfaction, and pockets both.";
    }
    if (noun == pint_of_ale) {
        if (location ~= brass_tap)
            "There's nowhere to buy a drink here.";
        if (pint_of_ale in player)
            "You've already got a pint. Best finish it before ordering another.";
        if (coins notin player)
            "You pat your pockets. Empty. The newsboy got your last tuppence.";
        remove coins;
        move pint_of_ale to player;
        print "You put your remaining coins on the bar. The barkeep eyes them, sweeps them up, and pulls a pint of dark ale with the practiced efficiency of someone who has been doing this since before you were born.^^";
        "~There you go, love. Don't drink it too fast -- I'm not mopping up after you.~";
    }
    "That's not something you can buy here.";
];

[ ZCirSub;
    if (noun == newspaper) {
        if (newspaper notin player)
            "You'll need to be holding the newspaper to circle anything in it.";
        if (pencil notin player)
            "You'll need something to write with.";
        if (ad_circled)
            "You've already circled the advert. The pencil mark stands out clearly against the newsprint.";
        ad_circled = true;
        score = score + 1;
        "You fish out the pencil and carefully circle the advert for DR. J. THYME -- TEMPORAL ENGINEERING. The pencil lead leaves a satisfying dark ring around the text. 14 Praed Street. That's right here.";
    }
    "You're not sure what you'd gain by circling that.";
];

[ KnockSub;
    if (location == workshop_entrance && door_open == false) {
        knock_count++;
        if (knock_count == 1) {
            "You rap on the heavy oak door. The sound echoes in the alley. No response.";
        }
        if (knock_count == 2) {
            "You knock again, louder. Still nothing. But you could swear you heard something move inside.";
        }
        if (knock_count >= 3) {
            door_open = true;
            "You knock a third time. Still no answer. It's beginning to rain, and you're seriously considering leaving when the door creaks open by itself. There's nobody standing in the doorway. Some sort of automated door, perhaps?";
        }
    }
    if (location == workshop_entrance && door_open)
        "The door is already open.";
    "Knocking on that seems unlikely to accomplish anything.";
];

[ TalkToSub;
    if (noun == dr_thyme)         { NPC_Talk_Thyme(); rtrue; }
    if (noun == newsboy) {
        if (newspaper in newsboy)
            "~Paper, guv? Tuppence! Best news in London! Well, the only news in London what I've got, at any rate.~";
        "~Anything else you need, guv? I'm fresh out of papers, but I can do directions, opinions, and rude gestures. All free.~";
    }
    if (noun == marcus)             { NPC_Talk_Marcus(); rtrue; }
    if (noun == livia)              { NPC_Talk_Livia(); rtrue; }
    if (noun == peggy)              { NPC_Talk_Peggy(); rtrue; }
    if (noun == tommy)              { NPC_Talk_Tommy(); rtrue; }
    if (noun == hawking)            { NPC_Talk_Hawking(); rtrue; }
    if (noun == torres)             { NPC_Talk_Torres(); rtrue; }
    if (noun == kai)                { NPC_Talk_Kai(); rtrue; }
    if (noun == barkeep)            { NPC_Talk_Barkeep(); rtrue; }
    if (noun == copernicus) {
        if (copernicus_named)
            "Copernicus says nothing, because he is a cat. He does, however, emit a single, resonant purr that somehow conveys both affection and total superiority. It's a gift.";
        "The cat says nothing, because he is a cat. He does, however, emit a single, resonant purr that somehow conveys both affection and total superiority. It's a gift.";
    }
    if (noun == eleanor) {
        "Eleanor looks up, gives you a small, shy smile, and pushes a cat drawing towards you. Words aren't really her thing right now.";
    }
    if (noun == felix) {
        "Felix launches into a sales pitch for lodestones, healing crystals, and a guaranteed-authentic hair from Jupiter's beard. You suspect the last one is actually donkey.";
    }
    if (noun == porter_npc) {
        "~Invitation, please,~ the porter says, in a tone that suggests this is both the first and last thing he will ever say to you.";
    }
    if (noun == chen) {
        "Dr. Chen smiles politely. ~I'm Professor Hawking's assistant. If you have questions about the party or the experiment, he's the one to ask.~";
    }
    if (noun == curator) {
        "The curator perks up. ~A visitor! Wonderful. Feel free to ask me about any of the exhibits. We don't get many visitors since... well, since the water.~";
    }
    if (noun has animate) {
        if (noun has pluralname)
            print (The) noun, " don't seem interested in conversation.^";
        else
            print (The) noun, " doesn't seem interested in conversation.^";
        rtrue;
    }
    "You can't have a meaningful conversation with that, though in Victorian England, people did try.";
];

[ TravelToSub;
    if (cat_accident == false) {
        "The time machine isn't activated yet. Perhaps you should examine it more closely.";
    }
    if (time_machine notin location) {
        "The time machine isn't here. You'll need to find it first.";
    }
    ! Era-specific access gates
    if (location == roman_forum && marcus_impressed == false) {
        "Roman soldiers have surrounded the machine, treating it as a curiosity -- or possibly a siege weapon. You'll need to impress their centurion before they'll let you near it.";
    }
    if (location == blitz_street && machine_dug_out == false) {
        "The time machine is half-buried under rubble from the last bombing raid. You'll need to dig it out before you can use it.";
    }
    if (location == future_street && has_diving_gear == false) {
        "The time machine sank when it arrived. You can see it just below the waterline, but you'd need diving gear to reach it.";
    }
    ! One-time fix text for Future
    if (location == future_street && machine_raised == false) {
        machine_raised = true;
        print "You strap on the diving gear and haul the time machine up from the murky water. It surfaces with a reluctant gurgle, shedding Thames water and what appears to be a very confused eel.^^";
    }
    if (noun == solarium_dest) {
        if (location == solarium) {
            "You're already home. The machine hums contentedly in the corner, as if to say it agrees.";
        }
        if (location == future_street && processor_installed == false) {
            "The crystal is cracked. The field generator won't sustain another transit. You need to install a replacement.";
        }
        current_era = 0;
        move copernicus to solarium;
        move time_machine to solarium;
        if (components_installed) {
            print "You set the dial to ~1895~ and pull the lever. For the first time, the machine moves through time like silk through water -- no screaming, no bucking, no ominous sounds from the engineering. Just a smooth, confident hum and the gentle sensation of reality rearranging itself politely. You're back in the solarium. Home.^";
        } else {
            print "You set the dial to ~1895~ and pull the lever. The machine hums, reality folds neatly like a well-pressed handkerchief, and you're back in the solarium. Home.^";
        }
        PlayerTo(solarium);
        rtrue;
    }
    if (noun == roman_dest) {
        if (location == roman_forum) {
            "You're already in Roman Londinium.";
        }
        if (visited_roman == false) visited_roman = true;
        current_era = 1;
        move time_machine to roman_forum;
        move copernicus to roman_forum;
        print "You set the destination dial to ~60 AD~ and pull the lever. The machine screams, the world dissolves, and when reality reassembles itself, you're standing in blazing Mediterranean sunlight that has absolutely no business being in London.^";
        PlayerTo(roman_forum);
        rtrue;
    }
    if (noun == blitz_dest) {
        if (location == blitz_street) {
            "You're already in wartime London.";
        }
        if (visited_roman == false) {
            "The dial won't turn that far. With the lodestone this weak, the machine can only reach nearby eras. You'll need to build up temporal range one hop at a time.";
        }
        if (lodestone_installed == false) {
            "The compass housing is dark. The machine can't navigate without a working lodestone. You need to install a replacement.";
        }
        if (visited_blitz == false) visited_blitz = true;
        current_era = 2;
        move time_machine to blitz_street;
        move copernicus to blitz_street;
        if (tube_installed) {
            print "You set the dial to ~1941~ and pull the lever. With the new Crookes tube humming in harmony with the lodestone, the transit is smooth and sure -- the oscillation circuit holding steady, the navigational field crisp. The machine deposits you somewhere dark and cold, and something overhead is making a very concerning droning noise.^";
        } else {
            print "You set the dial to ~1941~ and brace yourself. The new lodestone glows bright as you pull the lever -- the transit is stronger than before, the navigational field sharp and confident. But mid-transit, something inside makes a sound like a champagne flute being set down too hard. The Crookes tube. The fresh lodestone is pushing more power through the circuit than the old tube can handle. You can see a web of fractures spreading through the glass.^^";
            print "The machine deposits you somewhere dark, cold, and something overhead is making a very concerning droning noise.^";
        }
        PlayerTo(blitz_street);
        rtrue;
    }
    if (noun == hawking_dest) {
        if (location == cambridge_gates) {
            "You're already in Cambridge.";
        }
        if (visited_blitz == false) {
            "The lodestone can't reach that far yet. Each hop seems to extend the range a little, but you'll need to work your way there.";
        }
        if (tube_installed == false) {
            "The Crookes tube is fractured. The oscillation circuit can't sustain a transit. You need to install a replacement.";
        }
        if (visited_hawking == false) visited_hawking = true;
        current_era = 3;
        move time_machine to cambridge_gates;
        move copernicus to cambridge_gates;
        print "You set the dial to ~2009~ and activate the machine. With fresh lodestone and tube, the transit is the smoothest yet -- the navigational field holds steady, the oscillation circuit hums without complaint. Mid-transit you feel the machine lock onto something, pulled toward a specific date like a compass needle swinging north. Something in 2009 is doing half the work for you. Someone has left a light on for time travellers. You materialise beside a bicycle rack.^";
        PlayerTo(cambridge_gates);
        rtrue;
    }
    if (noun == future_dest) {
        if (location == future_street) {
            "You're already in future London.";
        }
        if (visited_hawking == false) {
            "The machine strains but can't reach 2045 yet. The failing lodestone limits your range. One more hop might extend it far enough.";
        }
        if (formula_transcribed == false) {
            "The machine can travel but can't aim this far. You need to transcribe the navigation formula into the calibration matrix.";
        }
        if (visited_future == false) visited_future = true;
        current_era = 4;
        move time_machine to future_street;
        move copernicus to future_street;
        if (processor_installed) {
            print "You set the dial to ~2045~ and pull the lever. With the new processor crystal seated firmly in the field generator, the machine aims true -- Hawking's formula and the upgraded hardware working in concert, the destination dial clicking to precise coordinates with quiet confidence. The transit is smooth, almost gentle, and deposits you somewhere very wet.^^";
        } else {
            print "You set the dial to ~2045~ and pull the lever. The machine aims true for the first time -- Hawking's formula works, the destination dial clicking to precise coordinates with mechanical confidence. But mid-transit there is a sharp, crystalline CRACK from the field generator housing. The formula is demanding more from the processor than it was ever designed to handle -- a fracture line runs through the crystal like a fault through glass. The machine bucks, nearly throws you out of the seat, and deposits you somewhere very wet.^^";
        }
        if (newspaper in player) {
            print "^The temporal wind rips the newspaper from your hands. The pages tumble into the vortex, scattering through centuries like leaves in a storm, and vanish.^";
            move newspaper to future_museum;
            give newspaper scenery;
        }
        PlayerTo(future_street);
        rtrue;
    }
    "The machine's dial doesn't seem to have that setting. Try: Roman Londinium, Blitz London, Cambridge, Future London, or Workshop.";
];

[ CarveSub;
    if (location == roman_temple) {
        if (inscription_carved) {
            "You've already carved your inscription. One temporal graffiti per visit, please.";
        }
        if (toolkit notin player) {
            "You need something to carve with. A toolkit with a chisel would do nicely.";
        }
        if (livia_trusts == false) {
            "Priestess Livia would not appreciate you vandalising her temple walls. Get her permission first.";
        }
        inscription_carved = true;
        score = score + 20;
        "You take the small chisel from your toolkit and carefully carve into the ancient stone: ~TEMPUS FUGIT -- THE TEMPORAL APPRENTICE WAS HERE, 60 AD.~ Livia watches with approval. ~A fine inscription. It will endure.~ You suspect she has no idea how right she is.";
    }
    "There's nothing suitable to carve here.";
];

[ BurySub;
    if (location == roman_docks) {
        if (capsule_buried) {
            "You've already buried your time capsule. The mud is only so deep.";
        }
        if (pocket_watch notin player) {
            "You need something worth burying for posterity. Your pocket watch, perhaps?";
        }
        capsule_buried = true;
        score = score + 20;
        remove pocket_watch;
        "You dig a hole in the soft Thames mud and carefully bury your grandfather's pocket watch, wrapping it in a piece of cloth from your jacket. Two thousand years from now, someone will be very confused.^^You pat the mud flat. Somewhere in the far future, a museum curator has just had a very good day.";
    }
    "This doesn't seem like a good place to bury anything.";
];

[ DigRubbleSub;
    if (location == blitz_street) {
        if (machine_dug_out) {
            "You've already dug the machine out. It stands free and clear.";
        }
        if (time_machine notin blitz_street) {
            "There's nothing to dig out here.";
        }
        if (tommy_helping == false) {
            "The rubble burying the machine is far too heavy to shift alone. You'd need someone strong to help -- someone like Corporal Tommy, perhaps.";
        }
        machine_dug_out = true;
        score = score + 3;
        print "You and Tommy attack the rubble burying the time machine. Brick by brick, beam by beam, you clear the debris. Tommy works with the cheerful determination of a man who has seen worse things this week.^^";
        print "~Funny-looking contraption,~ Tommy says, wiping plaster dust from his face. ~What is it, some kind of engine?~^^";
        print "~Something like that,~ you reply.^^";
        print "The time machine stands free, battered but functional.^";
        rtrue;
    }
    if (location == blitz_rubble) {
        if (blitz_rubble has general) {
            "You've already cleared the rubble. The metal box is accessible.";
        }
        if (tommy_helping == false) {
            "The debris is far too heavy to shift alone. You'd need someone strong to help -- someone like Corporal Tommy, perhaps, if you could get him away from his wireless.";
        }
        give blitz_rubble general;
        print "You and Tommy set to work on the rubble. He's stronger than he looks -- one good arm notwithstanding -- and between you, you shift enough brick and timber to reach the metal box.^^";
        print "~Military supply crate,~ Tommy says, wiping sweat from his brow. ~From the look of it, someone was shipping electronics. Your lucky day.~^";
        rtrue;
    }
    if (location == roman_docks) {
        "The mud here is soft enough. If you want to bury something, try BURY.";
    }
    "There's nothing useful to dig here.";
];

[ ExtinguishSub;
    if (location == blitz_rooftop) {
        if (church_saved) {
            "The fire is already out, thanks to your efforts.";
        }
        if (fire_event == false) {
            "There's no fire to extinguish at the moment.";
        }
        church_saved = true;
        score = score + 30;
        print "You heave sandbag after sandbag over the parapet onto the burning timbers below. Sand cascades onto the incendiary, smothering the magnesium flames. It's exhausting, terrifying, and deeply satisfying work.^^";
        print "The fire sputters and dies. St. Margaret's Church will survive another night -- and, as it turns out, another few centuries. From somewhere below, you hear Warden Peggy's voice: ~About bloody time! Well done!~^";
        rtrue;
    }
    "There's nothing to extinguish here.";
];

[ RepairSub;
    ! Handle bare "repair" or "install" with no noun when machine is present
    if (noun == 0 && time_machine in location)
        noun = time_machine;
    ! Redirect component nouns (e.g. "use lodestone") to the machine
    if (noun == lodestone or vacuum_tube or quantum_processor or formula_printout && time_machine in location)
        noun = time_machine;
    if (location == roman_forum && marcus_impressed == false) {
        "Roman soldiers have surrounded the machine, treating it as a curiosity -- or possibly a siege weapon. You'll need to impress their centurion before they'll let you near it.";
    }
    if (time_machine in location && noun == time_machine) {
        if (components_installed) {
            "The machine is already repaired. It hums contentedly.";
        }
        ! Install lodestone
        if (has_lodestone && lodestone_installed == false) {
            lodestone_installed = true;
            remove lodestone;
            score = score + 2;
            print "You ease the new lodestone into the compass housing. It clicks home with a satisfying snap, and the needle swings wildly before settling, trembling, on true north. The housing glows -- faintly at first, then steady, warm amber. The machine's navigational field hums back to life.^^";
            print "One component down.^";
            if (has_vacuum_tube && tube_installed == false && has_formula && formula_transcribed == false && has_processor && processor_installed == false) {
                ! Don't check for all-installed yet, let the player install more
            }
            if (lodestone_installed && tube_installed && formula_transcribed && processor_installed) {
                components_installed = true;
                print "^The Temporal Displacement Engine is fully repaired.^";
            }
            rtrue;
        }
        ! Install vacuum tube (needs toolkit)
        if (has_vacuum_tube && tube_installed == false) {
            if (toolkit notin player) {
                "The vacuum tube won't fit -- the contacts are bent at the wrong angle for Thyme's housing. You'd need the toolkit, specifically the needle-nose pliers, to coax them into alignment.";
            }
            tube_installed = true;
            remove vacuum_tube;
            score = score + 2;
            print "You take the needle-nose pliers from your toolkit and spend ten careful minutes bending each contact pin into alignment. The military-spec tube is close but not quite right -- wider tolerances, heavier glass. But pin by pin, you coax it into the oscillation circuit housing. It slides home. The machine's hum shifts from ~broken refrigerator~ to ~contented beehive.~^^";
            print "The oscillation circuit is restored.^";
            if (lodestone_installed && tube_installed && formula_transcribed && processor_installed) {
                components_installed = true;
                print "^The Temporal Displacement Engine is fully repaired.^";
            }
            rtrue;
        }
        ! Transcribe formula
        if (has_formula && formula_transcribed == false) {
            formula_transcribed = true;
            score = score + 2;
            print "You unfold Hawking's printout and begin transcribing the equations into the calibration matrix. The mathematics are breathtaking -- temporal harmonics expressed as intersecting wave functions, each variable dependent on seventeen others. Your hand trembles as you enter the final coefficient.^^";
            print "The machine shudders. The destination dial, which has always felt approximate, suddenly clicks with precision. For the first time, the machine can AIM.^";
            if (lodestone_installed && tube_installed && formula_transcribed && processor_installed) {
                components_installed = true;
                print "^The Temporal Displacement Engine is fully repaired.^";
            }
            rtrue;
        }
        ! Install processor (needs toolkit)
        if (has_processor && processor_installed == false) {
            if (toolkit notin player) {
                "The crystalline processor needs to be soldered into the brass harness with precision. You'd need the toolkit for this kind of delicate work.";
            }
            processor_installed = true;
            remove quantum_processor;
            score = score + 2;
            print "The crystalline processor slides into the brass harness -- the same harness, the same copper solder tabs, the same perfect fit. Whoever built that adapter knew exactly what shape this crystal would be. You solder the connections with steady hands.^^";
            print "The machine shudders, glows, and begins to sing -- a low, thrumming chord that seems to resonate with the fabric of reality itself. The temporal field generator is restored.^";
            if (lodestone_installed && tube_installed && formula_transcribed && processor_installed) {
                components_installed = true;
                print "^The Temporal Displacement Engine is fully repaired.^";
            }
            rtrue;
        }
        ! Nothing to install -- show progressive checklist
        print "The machine needs repairs:^";
        ! Lodestone is always known (broke in the cat accident)
        if (lodestone_installed) print "  [x] Lodestone (temporal compass -- installed)^";
        else if (has_lodestone) print "  [>] Lodestone (temporal compass -- ready to install)^";
        else print "  [ ] Lodestone (temporal compass -- fading)^";
        ! Crookes tube only after Blitz transit
        if (visited_blitz) {
            if (tube_installed) print "  [x] Vacuum tube (oscillation circuit -- installed)^";
            else if (has_vacuum_tube) print "  [>] Vacuum tube (oscillation circuit -- ready to install)^";
            else print "  [ ] Vacuum tube (oscillation circuit -- fracturing)^";
        }
        ! Formula only after visiting Cambridge
        if (visited_hawking) {
            if (formula_transcribed) print "  [x] Hawking's formula (temporal harmonics -- transcribed)^";
            else if (has_formula) print "  [>] Hawking's formula (temporal harmonics -- ready to transcribe)^";
            else print "  [ ] Hawking's formula (temporal harmonics)^";
        }
        ! Crystal only after Future transit
        if (visited_future) {
            if (processor_installed) print "  [x] Crystalline processor (field generator -- installed)^";
            else if (has_processor) print "  [>] Crystalline processor (field generator -- ready to install)^";
            else print "  [ ] Crystalline processor (field generator -- cracked)^";
        }
        rtrue;
    }
    "You can't repair that.";
];

! InstallCompSub removed — RepairSub now handles individual component installs

[ CleanSub;
    if (location == main_workshop || location == solarium) {
        if (cat_accident == false) {
            if (spanner_given == false)
                "You haven't even introduced yourself yet. Find the spanner Dr. Thyme wants first.";
            if (thyme_departed == false)
                "The workshop doesn't need cleaning yet. Perhaps talk to Dr. Thyme first.";
            if (cleaning_rag notin player && rag_stolen == false)
                "You don't have your cleaning rag. Dr. Thyme gave you one -- where did it go?";
            if (rag_on_machine) {
                if (location == main_workshop)
                    "The cat has your cleaning rag in the solarium. You should go and retrieve it.";
                "You'd love to clean, but the cat has stolen your cleaning rag and is sitting on the machine with it. You'll need to get the rag back first.";
            }
            if (cleaning_rag in player && rag_stolen == false) {
                if (location == main_workshop && copernicus in main_workshop) {
                    ! Primary path: cat steals rag and bolts to solarium
                    rag_stolen = true;
                    rag_on_machine = true;
                    move cleaning_rag to solarium;
                    print "You unfurl the cleaning rag and get to work on the nearest brass surface. For approximately three seconds.^^";
                    if (copernicus_named)
                        print "In a flash of silver fur, Copernicus snatches the rag right out of your hand. Before you can react, the cat has bolted east down the corridor, the rag trailing from his mouth like a battle standard -- straight toward the door Dr. Thyme told you not to open.^^";
                    else
                        print "In a flash of silver fur, the cat snatches the rag right out of your hand. Before you can react, he has bolted east down the corridor, the rag trailing from his mouth like a battle standard -- straight toward the door Dr. Thyme told you not to open.^^";
                    move copernicus to solarium;
                    move cat_name_tag to solarium;
                    print "You chase after, but the corridor door is locked. Through the keyhole you hear a scrabble of claws on glass -- the little monster has gone through the cat flap in the solarium window.^^";
                    print "Your cleaning rag is now on the wrong side of a locked door. The door Dr. Thyme told you not to open.^";
                    rtrue;
                }
                if (location == main_workshop)
                    "You straighten a few things on the workbench. The workshop looks marginally less chaotic, but it hardly counts as a proper tidy.";
                ! In solarium fallback - cat steals rag on the spot
                rag_stolen = true;
                rag_on_machine = true;
                move cleaning_rag to solarium;
                print "You unfurl the cleaning rag and are about to start on the nearest brass surface when --^^";
                if (copernicus_named)
                    print "In a flash of silver fur, Copernicus snatches the rag right out of your hand! Before you can react, the cat has leapt atop the contraption, the cleaning rag trailing from his mouth like a battle standard. He settles among the controls with an expression of absolute triumph.^^";
                else
                    print "In a flash of silver fur, the cat snatches the rag right out of your hand! Before you can react, he has leapt atop the contraption, the cleaning rag trailing from his mouth like a battle standard. He settles among the controls with an expression of absolute triumph.^^";
                print "Getting that rag back is going to require getting the cat off the machine. This seems... inadvisable.^";
                rtrue;
            }
        }
        if (cat_accident == false)
            "There's nothing that needs cleaning right now.";
        if (location == solarium)
            "The solarium doesn't need tidying. The workshop is where the mess is.";
        if (workshop_cleaned) {
            "The workshop is already spotless. Well, as spotless as a workshop full of temporal engineering equipment can be.";
        }
        workshop_cleaned = true;
        score = score + 5;
        print "You spend a surprisingly therapeutic twenty minutes tidying the workshop. Tools are returned to their racks. Marmalade jars are alphabetised (Dr. Thyme has opinions about marmalade). Copper shavings are swept. The workbench is cleared.^^";
        if (components_installed) {
            endgame_knocks_heard = true;
            endgame_turns = 0;
            print "As you hang up the dustpan, you hear it.^^";
            print "Three knocks on the front door.^^";
            print "Knock. Knock. Knock.^^";
            print "You stand very still. The sound is unmistakeable -- the same hesitant rap, the same rhythm, the same heavy oak resonance. You heard those exact knocks from the other side, standing in the alley on your first day. Your knocks.^^";
            print "The door creaks on its hinges but doesn't open. Whoever is out there is waiting. You could open the door...^";
        } else {
            "The workshop gleams. Dr. Thyme will be pleased. Now, about that time machine...";
        }
        rtrue;
    }
    "There's nothing here that needs cleaning.";
];

[ PetSub;
    if (noun == copernicus) {
        if (copernicus_named)
            "Copernicus permits exactly 2.4 seconds of stroking before biting your finger. Not maliciously -- just to remind you who's in charge. (Hint: not you.)";
        "The cat permits exactly 2.4 seconds of stroking before biting your finger. Not maliciously -- just to remind you who's in charge. (Hint: not you.)";
    }
    if (noun has animate)
        "That's a person, not a pet. Victorian social norms frown upon this.";
    "You can't pet that. It wouldn't enjoy it and neither would you.";
];


[ YellSub;
    if (noun == copernicus || (noun == nothing && location == parent(copernicus))) {
        if (rag_on_machine && location == solarium) {
            if (copernicus_named)
                "You raise your voice at Copernicus. He flattens his ears, narrows his amber eyes, and somehow manages to look even more comfortable on the machine. Yelling at a cat is like reasoning with weather -- technically possible, practically useless.";
            "You raise your voice at the cat. He flattens his ears, narrows his amber eyes, and somehow manages to look even more comfortable on the machine. Yelling at a cat is like reasoning with weather -- technically possible, practically useless.";
        }
        if (copernicus_named)
            "You shout at Copernicus. He blinks once, slowly, which is cat for ~Are you quite finished?~";
        "You shout at the cat. He blinks once, slowly, which is cat for ~Are you quite finished?~";
    }
    if (noun has animate)
        "Shouting at people is rarely productive, and never polite.";
    "You yell into the void. The void does not respond.";
];

[ ShooSub;
    if (noun == copernicus || (noun == nothing && location == parent(copernicus))) {
        if (rag_on_machine && location == solarium) {
            if (copernicus_named)
                "You wave your hands and hiss ~Shoo!~ at Copernicus. He regards your performance with the critical eye of a theatre reviewer and finds it wanting. He does not move. Not even slightly.";
            "You wave your hands and hiss ~Shoo!~ at the cat. He regards your performance with the critical eye of a theatre reviewer and finds it wanting. He does not move. Not even slightly.";
        }
        if (copernicus_named)
            "You try to shoo Copernicus away. He yawns magnificently and stays put. Cats do not recognise the concept of ~shoo.~";
        "You try to shoo the cat away. He yawns magnificently and stays put. Cats do not recognise the concept of ~shoo.~";
    }
    if (noun has animate)
        "Shooing people is generally considered rude.";
    "You flap your hands at nothing in particular. You look ridiculous.";
];

[ KickSub;
    if (noun == copernicus) {
        if (copernicus_named)
            "You raise a foot toward Copernicus and he fixes you with a stare of such withering contempt that your leg lowers itself out of sheer moral failure. Copernicus has done nothing to deserve violence. You, on the other hand, have done something unforgivable: you considered it.";
        "You raise a foot toward the cat and he fixes you with a stare of such withering contempt that your leg lowers itself out of sheer moral failure. This cat has done nothing to deserve violence. You, on the other hand, have done something unforgivable: you considered it.";
    }
    if (noun == nothing)
        "You kick the air. The air is unimpressed.";
    if (noun has animate)
        "Violence is the refuge of the incompetent. You are better than this. Probably.";
    "You decide against kicking that. Your boots have suffered enough indignity today.";
];

[ MeowSub;
    if (noun == copernicus || (noun == nothing && location == parent(copernicus))) {
        if (copernicus_named)
            "You let out your best meow. Copernicus tilts his head, ears swivelling like satellite dishes, then responds with a slow, deliberate chirrup. You have no idea what you just agreed to, but it probably involves tuna.";
        "You let out your best meow. The cat tilts his head, ears swivelling like satellite dishes, then responds with a slow, deliberate chirrup. You have no idea what you just agreed to, but it probably involves tuna.";
    }
    if (noun has animate)
        "You meow at them. They stare at you with visible concern for your wellbeing.";
    if (noun == nothing)
        "You meow into the empty room. The acoustics are surprisingly good, but the audience is nonexistent.";
    "You meow at that. It does not meow back. Unsurprising, really.";
];

[ HelpSub;
    print "^=== THE TEMPORAL APPRENTICE -- FIELD GUIDE ===^";
    print "   (hastily scrawled in Dr. Thyme's handwriting)^^";
    print "[NAVIGATION]^";
    print "  north/south/east/west/up/down^";
    print "  enter (door) ....... step through something^^";
    print "[INVESTIGATION]^";
    print "  look ............ survey your surroundings^";
    print "  examine X ....... inspect something closely^";
    print "  take X .......... pick something up^";
    print "  inventory ....... check what you're carrying^";
    print "  open X .......... open a container or door^";
    print "  read X .......... read something^^";
    print "[CONVERSATION]^";
    print "  talk to X ....... start a conversation^";
    print "  ask X about Y ... ask someone about a topic^";
    print "  give X to Y ..... hand something to someone^";
    print "  show X to Y ..... display something to someone^^";
    print "[SPECIAL ACTIONS]^";
    print "  travel to X ..... use the time machine (where it is)^";
    print "  carve ........... carve an inscription^";
    print "  bury ............ bury something for posterity^";
    print "  dig ............. excavate rubble^";
    print "  repair X ........ check/repair the time machine^";
    print "  extinguish ...... fight a fire^";
    print "  clean ........... tidy the workshop^";
    print "  pet X ........... stroke the cat (at your own risk)^";
    print "  meow ............ attempt feline communication^^";
    print "[TIPS]^";
    print "  - Read Dr. Thyme's journal for clues^";
    print "  - Talk to everyone, examine everything^";
    print "  - Actions in earlier eras affect later ones^";
    print "  - Copernicus is not luggage^";
    print "  - The eras must be visited in order^^";
];

[ KillHitlerSub;
    print "Absolutely not. This is a family-friendly time travel adventure and we are not going down that particular rabbit hole. Besides, you're in 1941, not 1933, and your to-do list is quite full enough without adding ~alter the fundamental course of the twentieth century~ to it.^^";
    print "Copernicus gives you a look of profound disappointment.^";
];

! ===================================================================
! GRAMMAR
! ===================================================================

Include "Grammar";

Verb 'talk'
    * 'to' creature                         -> TalkTo;

Verb 'help'
    *                                       -> Help;

Verb 'zcr'
    *                                       -> Carve
    * noun                                  -> Carve;

Verb 'zbr'
    *                                       -> Bury
    * noun                                  -> Bury;

Verb 'ztv'
    * 'to' noun                             -> TravelTo;

Verb 'zrp'
    *                                       -> Repair
    * noun                                  -> Repair;

Verb 'zex'
    *                                       -> Extinguish
    * noun                                  -> Extinguish;

Verb 'zdg'
    *                                       -> DigRubble
    * noun                                  -> DigRubble;

Verb 'zpt'
    * creature                              -> Pet
    * noun                                  -> Pet;


Verb 'zkn'
    *                                       -> Knock
    * 'on' noun                             -> Knock
    * noun                                  -> Knock;

Verb 'zcl'
    *                                       -> Clean
    * noun                                  -> Clean;

Verb 'zyl'
    *                                       -> Yell
    * creature                              -> Yell;

Verb 'zsh'
    *                                       -> Shoo
    * creature                              -> Shoo;

Verb 'zkk'
    *                                       -> Kick
    * creature                              -> Kick
    * noun                                  -> Kick;

Verb 'zmw'
    *                                       -> Meow
    * creature                              -> Meow;

Verb 'zby'
    * noun                                  -> ZBuy;

Verb 'zci'
    * noun                                  -> ZCir;

Verb 'board'
    * noun                                  -> Enter;

Extend 'ask' first
    * creature 'for' topic                  -> Ask;

Extend 'dig' first
    *                                       -> Dig;

Extend 'kill' first
    * 'hitler'                              -> KillHitler;

Extend 'give' first
    * held 'to' creature                    -> Give;

Extend 'show' first
    * held 'to' creature                    -> Show;
